    {
      "Id": "e49dca2c-e27b-481f-9f91-163880e1312e",
      "Name": "Sample guide",
      "Kind": "Comment",
      "X": 900,
      "Y": 0,
      "Curve": null,
      "ChildGraph": null,
      "Parameters": [
        {
          "Id": "text",
          "Type": "string",
          "Value": "CpuMeshSurface \u00B7 X right / Y up / Z forward \u00B7 metres\nCPU samples use a generated radial glow texture; no image import is required.\nGPU Curl: capacity 100,000; particles fill gradually. Fluid2D: edit typed Flow controls.\nSuggested preview: 60 FPS, frames 0\u20131200.\nY\u30A2\u30C3\u30D7\u30FB\u30E1\u30FC\u30C8\u30EB\u5358\u4F4D\u3002CPU\u306F\u751F\u6210\u30B0\u30ED\u30FC\u753B\u50CF\u3092\u4F7F\u7528\u3002GPU/\u30D5\u30EB\u30A4\u30C9\u306F\u5B9FGPU\u306E\u63A5\u7D9A\u5148\u3067\u78BA\u8A8D\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
        },
        {
          "Id": "width",
          "Type": "float",
          "Value": 680
        },
        {
          "Id": "height",
          "Type": "float",
          "Value": 220
        }
      ],
      "GroupAsset": null,
      "IsPolymorphic": false,
      "GroupOverrides": null,
      "SignalKeys": null
    }
