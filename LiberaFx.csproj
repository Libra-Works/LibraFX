<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>LIBERA FX</AssemblyTitle>
    <AssemblyName>LiberaFx</AssemblyName>
    <Product>LIBERA FX</Product>
    <RootNamespace>LiberaFx</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Brand\LibraFx.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tools\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="Runtime\**\*.cs" />
    <Compile Remove="Gpu\**\*.cs" />
    <Compile Remove="Samples\**\*.cs" />
    <Compile Remove="LiberaFx.Inspector.Abstractions\**\*.cs" />
    <Compile Remove="LiberaFx.Extensions.Abstractions\**\*.cs" />
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Inspectors\**" />
    <None Update="Assets\Nodes\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Polymorphism\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Enums\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Modules\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Modules\*.lfxgroup" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\ColorSchemes\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Inspectors\*.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Samples\*.lfxproj" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Samples\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Skills\**\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Samples\Extensions.Git\Extensions.Git.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="Samples\BundledInspector.ColorRgb\BundledInspector.ColorRgb.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="LiberaFx.Inspector.Abstractions\LiberaFx.Inspector.Abstractions.csproj" />
    <ProjectReference Include="LiberaFx.Extensions.Abstractions\LiberaFx.Extensions.Abstractions.csproj" />
    <ProjectReference Include="Gpu\LibraGpu.Core\LibraGpu.Core.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.5" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.1.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
