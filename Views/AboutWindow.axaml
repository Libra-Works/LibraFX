<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LiberaFx.Views"
        x:Class="LiberaFx.Views.AboutWindow"
        Title="About LIBERA FX" Width="560" Height="440" CanResize="False"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#10121D">
    <Grid RowDefinitions="Auto,*,Auto">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
            <views:SplashArtwork />
        </Viewbox>
        <StackPanel Grid.Row="1" Margin="26,18,26,10" Spacing="6">
            <TextBlock Text="LIBERA FX" FontSize="18" FontWeight="SemiBold" Foreground="#F1F1FA" />
            <TextBlock x:Name="VersionText" Foreground="#B6B7CC" />
        </StackPanel>
        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right"
                Margin="0,0,26,20" MinWidth="80" Click="OnCloseClick" />
    </Grid>
</Window>
