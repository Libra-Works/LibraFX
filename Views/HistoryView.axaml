<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiberaFx.ViewModels"
             xmlns:views="using:LiberaFx.Views"
             x:Class="LiberaFx.Views.HistoryView"
             x:DataType="vm:HistoryPaneViewModel">
    <Grid RowDefinitions="Auto,*">
        <Border Padding="12,10" Background="{DynamicResource EffectSurfaceBrush}"
                BorderBrush="{DynamicResource EffectBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding CurrentBranch}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentDescription}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                </StackPanel>
                <views:IconButton Grid.Column="1" Icon="Pin"
                                  ToolTip.Tip="{DynamicResource Text.Panels.PinCurrent}"
                                  AutomationProperties.Name="{DynamicResource Text.Panels.PinCurrent}"
                                  Command="{Binding PinCurrentCommand}" IsEnabled="{Binding CanPinCurrent}"
                                  VerticalAlignment="Center" />
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:HistoryEntryViewModel">
                        <Border Margin="{Binding Indent}"
                                BorderBrush="{DynamicResource EffectBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="3,*,Auto">
                                <Border Background="{DynamicResource DockApplicationAccentBrushIndicator}"
                                        IsVisible="{Binding IsCurrent}" />
                                <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Padding="10,7" Command="{Binding NavigateCommand}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <views:EditorIconView Icon="Undo" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding BranchName}"
                                                   Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                                    </StackPanel>
                                    </Grid>
                                </Button>
                                <views:IconButton Grid.Column="2" Icon="Pin"
                                                  IsVisible="{Binding !IsPinned}"
                                                  ToolTip.Tip="{DynamicResource Text.Panels.PinHistoryState}"
                                                  AutomationProperties.Name="{DynamicResource Text.Panels.PinHistoryState}"
                                                  Command="{Binding TogglePinCommand}"
                                                  Background="Transparent" BorderThickness="0" Padding="8,4"
                                                  VerticalAlignment="Center" />
                                <views:IconButton Grid.Column="2" Icon="Unpin"
                                                  IsVisible="{Binding IsPinned}"
                                                  ToolTip.Tip="{DynamicResource Text.Panels.UnpinHistoryState}"
                                                  AutomationProperties.Name="{DynamicResource Text.Panels.UnpinHistoryState}"
                                                  Command="{Binding TogglePinCommand}"
                                                  Background="Transparent" BorderThickness="0" Padding="8,4"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
