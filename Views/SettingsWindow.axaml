<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiberaFx.ViewModels"
        xmlns:services="using:LiberaFx.Services"
        xmlns:views="using:LiberaFx.Views"
        x:Class="LiberaFx.Views.SettingsWindow"
        x:DataType="vm:MainViewModel"
        Title="{DynamicResource Text.Editor.SettingsTitle}"
        Width="650"
        Height="600"
        MinWidth="400"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <TabControl x:Name="SettingsTabs">
        <TabItem Header="{DynamicResource Text.Editor.Appearance}">
        <ScrollViewer>
        <StackPanel Margin="10" Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBlock Classes="editor-title" Text="{DynamicResource Text.Editor.Appearance}" />
                <Border Grid.Column="1" Background="Transparent" Padding="2"
                        ToolTip.Tip="{DynamicResource Text.Editor.AppearanceHint}">
                    <views:EditorIconView Icon="Info" />
                </Border>
            </Grid>
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.Language}" />
                    <Border Grid.Column="1" Background="Transparent" Padding="2"
                            ToolTip.Tip="{DynamicResource Text.Editor.LanguageHint}">
                        <views:EditorIconView Icon="Info" />
                    </Border>
                </Grid>
                <ComboBox x:Name="LanguageList" ItemsSource="{Binding Localization.Languages}"
                          IsEnabled="{Binding Localization.CanChangeLanguage}"
                          SelectedItem="{Binding Localization.SelectedLanguage, Mode=OneWay}"
                          SelectionChanged="OnLanguageSelected"
                          AutomationProperties.Name="{DynamicResource Text.Editor.Language}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="services:EditorLanguage">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.NodeLanguage}" />
                <ComboBox x:Name="NodeLanguageList" ItemsSource="{Binding Localization.Languages}"
                          IsEnabled="{Binding Localization.CanChangeLanguage}"
                          SelectedItem="{Binding Localization.SelectedNodeLanguage, Mode=OneWay}"
                          SelectionChanged="OnNodeLanguageSelected"
                          AutomationProperties.Name="{DynamicResource Text.Editor.NodeLanguage}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="services:EditorLanguage">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="editor-label" Text="{Binding Localization.Status}" TextWrapping="Wrap"
                           IsVisible="{Binding Localization.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.ColorScheme}" />
                <ComboBox ItemsSource="{Binding ColorSchemes}"
                          SelectedItem="{Binding SelectedColorScheme}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><views:LocalizedOptionText Value="{ReflectionBinding}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.Accent}" />
                <ComboBox ItemsSource="{Binding AccentPalettes}"
                          SelectedItem="{Binding SelectedAccentPalette}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><views:LocalizedOptionText Value="{ReflectionBinding}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TextBlock Classes="editor-label" Text="{Binding AppearanceWarnings}" TextWrapping="Wrap"
                       IsVisible="{Binding AppearanceWarnings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="editor-label" Text="{Binding AppearanceStatus}" TextWrapping="Wrap"
                       IsVisible="{Binding AppearanceStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource Text.Editor.Shortcuts}">
                <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Classes="editor-title" Text="{DynamicResource Text.Editor.Shortcuts}" />
                        <Border Grid.Column="1" Background="Transparent" Padding="2"
                                ToolTip.Tip="{DynamicResource Text.Editor.ShortcutHint}">
                            <views:EditorIconView Icon="Info" />
                        </Border>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,8">
                        <ItemsControl ItemsSource="{Binding Shortcuts.Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="services:ShortcutEntry">
                                    <Grid ColumnDefinitions="90,*,150" ColumnSpacing="8" Margin="0,2">
                                        <TextBlock Classes="editor-label" Text="{Binding ScopeLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="2" Text="{Binding Gesture}" Tag="{Binding Id}"
                                                 IsReadOnly="True" KeyDown="OnShortcutKeyDown"
                                                 ToolTip.Tip="{DynamicResource Text.Editor.ShortcutTooltip}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.GraphPan}" />
                            <ComboBox ItemsSource="{Binding Shortcuts.GraphPanOptions}" SelectedItem="{Binding Shortcuts.GraphPanButton}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><views:LocalizedOptionText Value="{ReflectionBinding}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.WheelModifier}" />
                            <ComboBox ItemsSource="{Binding Shortcuts.ZoomOptions}" SelectedItem="{Binding Shortcuts.GraphZoomModifier}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><views:LocalizedOptionText Value="{ReflectionBinding}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.CurvePan}" />
                            <ComboBox ItemsSource="{Binding Shortcuts.GraphPanOptions}" SelectedItem="{Binding Shortcuts.CurvePanButton}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><views:LocalizedOptionText Value="{ReflectionBinding}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.WheelModifier}" />
                            <ComboBox ItemsSource="{Binding Shortcuts.ZoomOptions}" SelectedItem="{Binding Shortcuts.CurveZoomModifier}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><views:LocalizedOptionText Value="{ReflectionBinding}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Margin="0,6,0,0" Classes="editor-label" Text="{Binding Shortcuts.Status}"
                               TextWrapping="Wrap" />
                    <views:IconButton Grid.Column="1" Classes="editor-tool" Icon="Reset" Click="OnResetShortcutsClick"
                                      ToolTip.Tip="{DynamicResource Text.Editor.ResetShortcuts}"
                                      AutomationProperties.Name="{DynamicResource Text.Editor.ResetShortcuts}" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Text.Editor.Servers}">
                <ScrollViewer>
                <StackPanel Margin="10" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Classes="editor-title" Text="{DynamicResource Text.Editor.ServerPorts}" />
                        <Border Grid.Column="1" Background="Transparent" Padding="2"
                                ToolTip.Tip="{DynamicResource Text.Editor.ServerHint}">
                            <views:EditorIconView Icon="Info" />
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="190,120" ColumnSpacing="8">
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.McpPort}" />
                        <TextBox x:Name="McpPortBox" Grid.Column="1" Text="{Binding ServerSettings.McpPort, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="190,120" ColumnSpacing="8">
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.PreviewPort}" />
                        <TextBox x:Name="PreviewPortBox" Grid.Column="1" Text="{Binding ServerSettings.PreviewPort, Mode=TwoWay}" />
                    </Grid>
                    <views:IconButton Classes="editor-tool" Icon="Save" HorizontalAlignment="Left" Click="OnSaveServersClick"
                                      ToolTip.Tip="{DynamicResource Text.Editor.SaveServers}"
                                      AutomationProperties.Name="{DynamicResource Text.Editor.SaveServers}" />
                    <TextBlock Classes="editor-label" Text="{Binding ServerSettings.Status}" TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource Text.Editor.Projects}">
                <ScrollViewer>
                <StackPanel Margin="10" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Classes="editor-title" Text="{DynamicResource Text.Editor.ProjectTeam}" />
                        <Border Grid.Column="1" Background="Transparent" Padding="2"
                                ToolTip.Tip="{DynamicResource Text.Editor.ProjectHint}">
                            <views:EditorIconView Icon="Info" />
                        </Border>
                    </Grid>
                    <ComboBox x:Name="ProjectList" ItemsSource="{Binding TeamProfiles.Profiles}"
                              SelectionChanged="OnProjectSelected">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="services:TeamProfile">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.ProjectName}" />
                    <TextBox x:Name="ProjectNameBox" />
                    <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.NodeDirectory}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="NodeDirectoryBox" PlaceholderText="{DynamicResource Text.Editor.DirectoryPlaceholder}"
                                 AutomationProperties.Name="{DynamicResource Text.Editor.NodeDirectory}" />
                        <views:IconButton Grid.Column="1" Classes="editor-tool" Icon="Open" Click="OnBrowseNodeDirectoryClick"
                                          ToolTip.Tip="{DynamicResource Text.Editor.BrowseDirectory}"
                                          AutomationProperties.Name="{DynamicResource Text.Editor.BrowseDirectory}" />
                    </Grid>
                    <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.GroupDirectory}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="GroupDirectoryBox" PlaceholderText="{DynamicResource Text.Editor.DirectoryPlaceholder}" />
                        <views:IconButton Grid.Column="1" Classes="editor-tool" Icon="Open" Click="OnBrowseGroupDirectoryClick"
                                          ToolTip.Tip="{DynamicResource Text.Editor.BrowseDirectory}"
                                          AutomationProperties.Name="{DynamicResource Text.Editor.BrowseDirectory}" />
                    </Grid>
                    <Border Classes="editor-toolbar-group" Padding="4,2" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <views:IconButton Classes="editor-tool" Icon="Save" Click="OnSaveProjectProfileClick"
                                              ToolTip.Tip="{DynamicResource Text.Editor.SaveProject}"
                                              AutomationProperties.Name="{DynamicResource Text.Editor.SaveProject}" />
                            <views:IconButton Classes="editor-tool" Icon="Add" Click="OnAddProjectProfileClick"
                                              ToolTip.Tip="{DynamicResource Text.Editor.AddProject}"
                                              AutomationProperties.Name="{DynamicResource Text.Editor.AddProject}" />
                            <views:IconButton Classes="editor-tool" Icon="Remove" Click="OnRemoveProjectProfileClick"
                                              ToolTip.Tip="{DynamicResource Text.Editor.RemoveProject}"
                                              AutomationProperties.Name="{DynamicResource Text.Editor.RemoveProject}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="editor-label" Text="{Binding TeamProfiles.Status}" TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource Text.Extensions.Plugins}">
              <TabControl x:Name="PluginSettingsTabs">
                <TabItem Header="{DynamicResource Text.Editor.Inspectors}">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBlock Classes="editor-title" Text="{DynamicResource Text.Editor.InspectorHeading}" />
                            <Border Grid.Column="1" Background="Transparent" Padding="2"
                                    ToolTip.Tip="{DynamicResource Text.Editor.InspectorTrustHelp}">
                                <views:EditorIconView Icon="Info" />
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="InspectorSearchBox"
                                     PlaceholderText="{DynamicResource Text.Editor.InspectorSearch}"
                                     TextChanged="OnInspectorSearchChanged"
                                     AutomationProperties.Name="{DynamicResource Text.Editor.InspectorSearch}" />
                            <Button Grid.Column="1" Classes="editor-action" Content="{DynamicResource Text.Editor.InspectorAdd}"
                                    Click="OnInspectorAddClick"
                                    ToolTip.Tip="{DynamicResource Text.Editor.InspectorInstallHint}"
                                    AutomationProperties.Name="{DynamicResource Text.Editor.InspectorAdd}" />
                        </Grid>
                        <TextBlock Classes="editor-label" Text="{Binding InspectorPlugins.InstallDirectory}" TextWrapping="Wrap" />
                        <ItemsControl x:Name="InspectorPluginList" ItemsSource="{Binding InspectorPlugins.VisiblePlugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="services:InspectorPluginEntry">
                                    <Border Classes="editor-card" Padding="8" Margin="0,3">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                                              ColumnSpacing="8" RowSpacing="3">
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                                <TextBlock Classes="editor-heading" Text="{Binding Name}" />
                                                <TextBlock Classes="editor-label" Text="{Binding Id}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Classes="editor-label" Text="{Binding Version}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2">
                                                <Run Text="{DynamicResource Text.Editor.InspectorProvided}" />
                                                <Run Text="{Binding Inspectors}" />
                                            </TextBlock>
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap">
                                                <Run Text="{DynamicResource Text.Editor.InspectorTypes}" />
                                                <Run Text="{Binding Types}" />
                                            </TextBlock>
                                            <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Classes="editor-label" Text="{Binding Status}" TextWrapping="Wrap" />
                                                <CheckBox Grid.Column="1" Content="{Binding Name}" Tag="{Binding Id}"
                                                        IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                        Click="OnInspectorToggleClick"
                                                        IsEnabled="{Binding IsCompatible}"
                                                        ToolTip.Tip="{Binding TrustHelp}"
                                                        AutomationProperties.Name="{Binding ActionLabel}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Editor.InspectorDefaults}" />
                            <Border Grid.Column="1" Background="Transparent" Padding="2"
                                    ToolTip.Tip="{DynamicResource Text.Editor.InspectorDefaultsHint}">
                                <views:EditorIconView Icon="Info" />
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding InspectorPlugins.Defaults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="services:InspectorDefaultChoice">
                                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8" Margin="0,2">
                                        <TextBlock Classes="editor-label" Text="{Binding Type}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                  DisplayMemberBinding="{Binding Name}"
                                                  SelectedItem="{Binding Selected, Mode=OneWay}"
                                                  SelectionChanged="OnInspectorDefaultSelected"
                                                  IsEnabled="{Binding CanEdit}"
                                                  AutomationProperties.Name="{Binding Type}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="editor-label" Text="{Binding InspectorPlugins.Status}" TextWrapping="Wrap" />
                        <TextBlock Classes="editor-label" Text="{Binding InspectorPlugins.OperationStatus}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource Text.Extensions.Title}">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBlock Classes="editor-title" Text="{DynamicResource Text.Extensions.Title}" />
                            <Border Grid.Column="1" Background="Transparent" Padding="2"
                                    ToolTip.Tip="{DynamicResource Text.Extensions.Trust}">
                                <views:EditorIconView Icon="Info" />
                            </Border>
                        </Grid>
                        <TextBox Text="{Binding Extensions.InstallDirectory}" IsReadOnly="True" />
                        <TextBlock Text="{DynamicResource Text.Extensions.PluginStartupHint}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Extensions.Extensions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="services:EditorExtensionEntry">
                                    <Border Classes="editor-card" Padding="8" Margin="0,3">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="editor-heading" Text="{Binding Name}" />
                                            <TextBlock Classes="editor-label" Text="{Binding Id}" />
                                            <TextBlock Classes="editor-label" Text="{Binding Version}" />
                                            <TextBlock Text="{Binding Capabilities}" TextWrapping="Wrap" />
                                            <TextBlock Classes="editor-label" Text="{Binding Status}" TextWrapping="Wrap" />
                                            <CheckBox Content="{Binding Name}" Tag="{Binding Id}"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      Click="OnExtensionToggleClick" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Extensions.Commands}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <ComboBox x:Name="ExtensionCommandList" ItemsSource="{Binding Extensions.Commands}"
                                      HorizontalAlignment="Stretch"
                                      DisplayMemberBinding="{Binding Name}" />
                            <views:IconButton Grid.Column="1" Classes="editor-tool transport-primary" Icon="Play" Click="OnExtensionRunClick"
                                              ToolTip.Tip="{DynamicResource Text.Extensions.Run}"
                                              AutomationProperties.Name="{DynamicResource Text.Extensions.Run}" />
                        </Grid>
                        <TextBlock Classes="editor-label" Text="{Binding Extensions.Status}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                </TabItem>
        <TabItem Header="{DynamicResource Text.History.Settings}">
            <StackPanel Margin="10" Spacing="12">
                <TextBlock Classes="editor-title" Text="{DynamicResource Text.History.Settings}" />
                <TextBlock Text="{DynamicResource Text.History.CompressionHelp}" TextWrapping="Wrap" />
                <CheckBox Content="{DynamicResource Text.History.Unlimited}" IsChecked="{Binding HistorySettings.Unlimited, Mode=TwoWay}" />
                <TextBlock Text="{DynamicResource Text.History.Maximum}" />
                <TextBox Width="140" HorizontalAlignment="Left" IsEnabled="{Binding !HistorySettings.Unlimited}"
                         Text="{Binding HistorySettings.MaximumText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="{DynamicResource Text.History.LimitHelp}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding HistorySettings.Status}" TextWrapping="Wrap" />
            </StackPanel>
        </TabItem>
        </TabControl>
            </TabItem>
            </TabControl>
        <views:IconButton Grid.Row="1"
                Classes="editor-tool"
                HorizontalAlignment="Right"
                Icon="Close"
                ToolTip.Tip="{DynamicResource Text.Editor.Close}"
                AutomationProperties.Name="{DynamicResource Text.Editor.Close}"
                IsDefault="True"
                Click="OnCloseClick" />
    </Grid>
</Window>
