<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsControls="using:LiberaFx.Views.Controls"
             x:Class="LiberaFx.Views.Gpu.GpuWorkspaceView"
             Background="{DynamicResource EffectWindowBackgroundBrush}"
             Focusable="True" KeyDown="OnKeyDown">
  <UserControl.Styles>
    <Style Selector="Button"><Setter Property="Padding" Value="8,4" /></Style>
    <Style Selector="TextBox, ComboBox"><Setter Property="MinHeight" Value="26" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Classes="editor-bar" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <viewsControls:IconButton x:Name="BackButton" Classes="editor-tool" Icon="Previous" Click="OnBack"
                          ToolTip.Tip="{DynamicResource Text.Gpu.Back}"
                          AutomationProperties.Name="{DynamicResource Text.Gpu.Back}" />
        <TextBlock x:Name="Breadcrumb" Classes="editor-heading" Grid.Column="1" VerticalAlignment="Center" />
        <Border Grid.Column="2" Classes="editor-toolbar-group" Padding="4,2">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <viewsControls:IconButton Classes="editor-tool transport-primary" Icon="Play" Click="OnCompile"
                              ToolTip.Tip="{DynamicResource Text.Gpu.Compile}"
                              AutomationProperties.Name="{DynamicResource Text.Gpu.Compile}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Background="Transparent" Padding="4" VerticalAlignment="Center"
                ToolTip.Tip="{DynamicResource Text.Gpu.Status}">
          <viewsControls:EditorIconView Icon="Info" />
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="190,*">
      <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource EffectBorderBrush}" Padding="8">
        <ScrollViewer><StackPanel Spacing="6">
          <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Gpu.Palette}" />
          <TextBlock x:Name="TypeChoiceLabel" Classes="editor-label" Text="{DynamicResource Text.Gpu.NewNodeType}" />
          <ComboBox x:Name="TypeChoice" HorizontalAlignment="Stretch"
                    ToolTip.Tip="{DynamicResource Text.Gpu.NewNodeTypeHint}" />
          <StackPanel x:Name="Palette" Spacing="3" />
          <Separator />
          <TextBlock x:Name="CapacityLabel" Classes="editor-label" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox x:Name="Capacity" />
            <viewsControls:IconButton x:Name="ApplyCapacityButton" Grid.Column="1" Classes="editor-tool" Icon="Check" Click="OnCapacity"
                              ToolTip.Tip="{DynamicResource Text.Gpu.ApplyCapacity}"
                              AutomationProperties.Name="{DynamicResource Text.Gpu.ApplyCapacity}" />
          </Grid>
          <Separator />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <ComboBox x:Name="ExportFormat" HorizontalAlignment="Stretch" />
            <viewsControls:IconButton Grid.Column="1" Classes="editor-tool" Icon="Export" Click="OnExport"
                              ToolTip.Tip="{DynamicResource Text.Gpu.Export}"
                              AutomationProperties.Name="{DynamicResource Text.Gpu.Export}" />
          </Grid>
          <Button x:Name="FutureTextureButton" Classes="editor-action" IsEnabled="False" Content="{DynamicResource Text.Gpu.FutureTexture}"
                  ToolTip.Tip="{DynamicResource Text.Gpu.FutureHint}" />
        </StackPanel></ScrollViewer>
      </Border>
      <Grid Grid.Column="1">
        <ScrollViewer x:Name="FlowScroll">
          <StackPanel x:Name="FlowPanel" Margin="40,20" Spacing="6" HorizontalAlignment="Center" MinWidth="300" />
        </ScrollViewer>
        <TabControl x:Name="KernelTabs" IsVisible="False">
          <TabItem Header="{DynamicResource Text.Gpu.Visual}">
            <Grid RowDefinitions="*,Auto">
              <StackPanel x:Name="KernelToolbar" Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="6">
                <viewsControls:IconButton Classes="editor-tool" Icon="ZoomOut" Click="OnZoomOut"
                                  ToolTip.Tip="{DynamicResource Text.Editor.ZoomOut}"
                                  AutomationProperties.Name="{DynamicResource Text.Editor.ZoomOut}" />
                <Button x:Name="ZoomLabel" Classes="editor-tool" Content="100%" Click="OnResetZoom" />
                <viewsControls:IconButton Classes="editor-tool" Icon="ZoomIn" Click="OnZoomIn"
                                  ToolTip.Tip="{DynamicResource Text.Editor.ZoomIn}"
                                  AutomationProperties.Name="{DynamicResource Text.Editor.ZoomIn}" />
                <viewsControls:IconButton x:Name="FrameButton" Classes="editor-tool" Icon="Frame" Click="OnFrame" IsEnabled="False"
                                  ToolTip.Tip="{DynamicResource Text.Gpu.Frame}"
                                  AutomationProperties.Name="{DynamicResource Text.Gpu.Frame}" />
                <Button x:Name="FrameAllButton" Classes="editor-action" Content="{DynamicResource Text.Gpu.FrameAll}" Click="OnFrameAll" />
                <Button x:Name="ArrangeButton" Classes="editor-action" Content="{DynamicResource Text.Gpu.Arrange}" Click="OnArrange" />
                <Border Background="Transparent" Padding="4" VerticalAlignment="Center"
                        ToolTip.Tip="{DynamicResource Text.Gpu.Gestures}">
                  <viewsControls:EditorIconView Icon="Info" />
                </Border>
              </StackPanel>
              <ScrollViewer x:Name="GpuGraphScrollViewer" Focusable="True"
                            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="GpuZoomHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <Canvas x:Name="NodeCanvas" Width="2200" Height="1600" Background="Transparent"
                          HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0%,0%"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragOver="OnNodeCanvasDragOver"
                          DragDrop.Drop="OnNodeCanvasDrop" />
                </Grid>
              </ScrollViewer>
            </Grid>
          </TabItem>
          <TabItem Header="{DynamicResource Text.Gpu.Text}">
            <Grid RowDefinitions="*,Auto" Margin="10">
              <TextBox x:Name="KernelText" AcceptsReturn="True" TextWrapping="NoWrap"
                       FontFamily="Consolas" TextChanged="OnTextChanged" />
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                <Button Classes="editor-action" Click="OnApplyText" Content="{DynamicResource Text.Gpu.ApplyText}" />
                <Button Classes="editor-action" Click="OnEmitText" Content="{DynamicResource Text.Gpu.EmitText}" />
                <Border Background="Transparent" Padding="4" VerticalAlignment="Center"
                        ToolTip.Tip="{DynamicResource Text.Gpu.Grammar}">
                  <viewsControls:EditorIconView Icon="Info" />
                </Border>
              </StackPanel>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
      <Border x:Name="GpuInspectorContainer" IsVisible="False">
        <ScrollViewer x:Name="GpuInspectorHost" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8" Spacing="6">
          <TextBlock x:Name="SelectionLabel" Classes="editor-label" TextWrapping="Wrap" />
          <StackPanel x:Name="NodeInspector" Spacing="5" />
          <Separator x:Name="WritesSeparator" />
          <TextBlock x:Name="WritesHeading" Classes="editor-heading" Text="{DynamicResource Text.Gpu.Writes}" />
          <StackPanel x:Name="WritesPanel" Spacing="4" />
          <StackPanel x:Name="BindingsPanel" Spacing="4" />
          <Separator />
          <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Gpu.Diagnostics}" />
          <TextBlock x:Name="DiagnosticText" TextWrapping="Wrap" Foreground="#ef7474" />
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
    <TextBlock x:Name="Status" Grid.Row="2" Classes="editor-label" Margin="12,6" TextWrapping="Wrap" />
  </Grid>
</UserControl>
