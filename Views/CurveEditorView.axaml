<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiberaFx.ViewModels"
             xmlns:views="using:LiberaFx.Views"
             x:Class="LiberaFx.Views.CurveEditorView"
             x:DataType="vm:CurveEditorViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,4">
            <Button Content="Add key" Command="{Binding AddKeyCommand}" />
            <Button Content="Delete" Command="{Binding DeleteKeyCommand}" />
            <Button Content="Frame all" Click="OnFrameAllClick" />
            <Button Content="Frame selected" Click="OnFrameSelectedClick" IsEnabled="{Binding HasSelectedKeys}" />
            <Button Content="−" ToolTip.Tip="Zoom out" Click="OnZoomOutClick" />
            <Button Content="+" ToolTip.Tip="Zoom in" Click="OnZoomInClick" />
            <CheckBox Content="Snap frames" IsChecked="{Binding SnapToFrames}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Node.Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="190,*,210">
            <Grid RowDefinitions="Auto,*" Margin="4">
                <TextBox PlaceholderText="Search curves" Text="{Binding ChannelSearch, Mode=TwoWay}" />
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding FilteredChannels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CurveChannelViewModel">
                                <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,2">
                                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Spacing="4">
                                        <CheckBox IsChecked="{Binding IsVisible}" ToolTip.Tip="Show or hide curve" />
                                        <Button Content="Value" Foreground="{Binding Brush}"
                                                Tag="{Binding}" Click="OnChannelClick" Padding="4,1" />
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <views:FCurveCanvas Grid.Column="1" x:Name="CurveCanvas" MinHeight="130" />
            <ScrollViewer Grid.Column="2">
                <StackPanel Margin="8,0" Spacing="4" IsEnabled="{Binding HasKey}">
                    <TextBlock Text="Selected key" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Text="Frame" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding FrameText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Text="Value" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding Interpolations}"
                              SelectedItem="{Binding SelectedInterpolation, Mode=TwoWay}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Text="In slope" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding InSlopeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Text="Out slope" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding OutSlopeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock Grid.Row="2" Margin="8,3" Text="{Binding Status}"
                   Foreground="{DynamicResource EffectMutedForegroundBrush}" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
