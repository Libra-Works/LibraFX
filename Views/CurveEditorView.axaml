<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiberaFx.ViewModels"
             xmlns:views="using:LiberaFx.Views"
             x:Class="LiberaFx.Views.CurveEditorView"
             x:DataType="vm:CurveEditorViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,4">
            <views:IconButton x:Name="CurveAddKeyButton" Icon="Add" Command="{Binding AddKeyCommand}"
                              ToolTip.Tip="{DynamicResource Text.Panels.AddKey}"
                              AutomationProperties.Name="{DynamicResource Text.Panels.AddKey}" />
            <views:IconButton Icon="Delete" Command="{Binding DeleteKeyCommand}"
                              ToolTip.Tip="{DynamicResource Text.Panels.DeleteKey}"
                              AutomationProperties.Name="{DynamicResource Text.Panels.DeleteKey}" />
            <views:IconButton x:Name="CurveFrameAllButton" Icon="Frame" Click="OnFrameAllClick"
                              ToolTip.Tip="{DynamicResource Text.Panels.FrameAll}"
                              AutomationProperties.Name="{DynamicResource Text.Panels.FrameAll}" />
            <views:IconButton Icon="Frame" Click="OnFrameSelectedClick" IsEnabled="{Binding HasSelectedKeys}"
                              ToolTip.Tip="{DynamicResource Text.Panels.FrameSelected}"
                              AutomationProperties.Name="{DynamicResource Text.Panels.FrameSelected}" />
            <views:IconButton Icon="ZoomOut" Click="OnZoomOutClick"
                              ToolTip.Tip="{DynamicResource Text.Panels.ZoomOut}"
                              AutomationProperties.Name="{DynamicResource Text.Panels.ZoomOut}" />
            <views:IconButton Icon="ZoomIn" Click="OnZoomInClick"
                              ToolTip.Tip="{DynamicResource Text.Panels.ZoomIn}"
                              AutomationProperties.Name="{DynamicResource Text.Panels.ZoomIn}" />
            <CheckBox Content="{DynamicResource Text.Panels.SnapFrames}" IsChecked="{Binding SnapToFrames}" VerticalAlignment="Center" />
            <CheckBox Content="{DynamicResource Text.Timeline.UseSeconds}" IsChecked="{Binding Playback.ShowSeconds}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Node.Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Border IsVisible="{Binding IsColorCurve}" Background="{Binding ColorCurvePreview}"
                    BorderBrush="{DynamicResource EffectMutedForegroundBrush}" BorderThickness="1"
                    Width="32" Height="18" VerticalAlignment="Center"
                    ToolTip.Tip="{DynamicResource Text.Panels.CurveColorPreview}"
                    AutomationProperties.Name="{DynamicResource Text.Panels.CurveColorPreview}" />
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="190,*">
            <Grid RowDefinitions="Auto,*" Margin="4">
                <TextBox PlaceholderText="{DynamicResource Text.Panels.SearchCurves}" Text="{Binding ChannelSearch, Mode=TwoWay}" />
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding FilteredChannels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CurveChannelViewModel">
                                <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,2">
                                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Spacing="4">
                                        <CheckBox IsChecked="{Binding IsVisible}"
                                                  ToolTip.Tip="{DynamicResource Text.Panels.ShowHideCurve}"
                                                  AutomationProperties.Name="{DynamicResource Text.Panels.ShowHideCurve}" />
                                        <Button Foreground="{Binding Brush}" Tag="{Binding}" Click="OnChannelClick" Padding="4,1"
                                                AutomationProperties.Name="{DynamicResource Text.Panels.Value}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <views:EditorIconView Icon="Frame" Stroke="{Binding Brush}" />
                                                <TextBlock Text="{DynamicResource Text.Panels.Value}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <views:FCurveCanvas Grid.Column="1" x:Name="CurveCanvas" MinHeight="130" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="8,2" Spacing="8" IsEnabled="{Binding HasKey}">
                    <TextBlock Text="{DynamicResource Text.Panels.SelectedKey}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Grid ColumnDefinitions="Auto,82" ColumnSpacing="6">
                        <TextBlock Text="{Binding TimeUnitLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding FrameText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,82" ColumnSpacing="6">
                        <TextBlock Text="{DynamicResource Text.Panels.Value}" VerticalAlignment="Center" />
                        <TextBox x:Name="CurveValueBox" Grid.Column="1" Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding Interpolations}"
                              SelectedItem="{Binding SelectedInterpolation, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><views:LocalizedOptionText Value="{ReflectionBinding}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid ColumnDefinitions="Auto,82" ColumnSpacing="6">
                        <TextBlock Text="{DynamicResource Text.Panels.InSlope}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding InSlopeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,82" ColumnSpacing="6">
                        <TextBlock Text="{DynamicResource Text.Panels.OutSlope}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding OutSlopeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Margin="8,3" Text="{Binding Status}"
                   Foreground="{DynamicResource EffectMutedForegroundBrush}" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
