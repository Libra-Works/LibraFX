<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiberaFx.ViewModels"
        xmlns:services="using:LiberaFx.Services"
        xmlns:views="using:LiberaFx.Views"
        x:Class="LiberaFx.Views.EngineAssetsWindow"
        x:DataType="vm:EngineAssetsWindowViewModel"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
    <TabControl SelectedIndex="{Binding SelectedTab}">
    <TabItem Header="{DynamicResource Text.Resources.Connected}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
                <TextBlock Classes="editor-label" Text="{DynamicResource Text.Asset.Peer}" />
                <ComboBox x:Name="PeerPicker" Width="240" ItemsSource="{Binding Peers}"
                          SelectedItem="{Binding SelectedPeer}" />
                <TextBox Width="240" PlaceholderText="{DynamicResource Text.Asset.SearchHint}"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Width="130" ItemsSource="{Binding AssetClasses}" SelectedItem="{Binding AssetClass}" />
            </WrapPanel>
            <Border Grid.Column="1" Classes="editor-toolbar-group" Padding="4,2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <views:IconButton Classes="editor-tool transport-primary" Icon="Refresh" Command="{Binding SearchCommand}"
                                      ToolTip.Tip="{DynamicResource Text.Asset.Search}"
                                      AutomationProperties.Name="{DynamicResource Text.Asset.Search}" />
                    <views:IconButton Classes="editor-tool" Icon="Link" Click="OnReconnectClick"
                                      ToolTip.Tip="{DynamicResource Text.Asset.Reconnect}"
                                      AutomationProperties.Name="{DynamicResource Text.Asset.Reconnect}" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="14">
            <Grid RowDefinitions="*,Auto">
                <ListBox ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="services:EngineAsset">
                            <Grid ColumnDefinitions="*,Auto" Margin="4">
                                <StackPanel>
                                    <TextBlock Classes="editor-heading" Text="{Binding Name}" />
                                    <TextBlock Classes="editor-label" Text="{Binding Path}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="editor-label" Text="{Binding AssetClass}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,6,0,0">
                    <views:IconButton Classes="editor-tool" Icon="Previous" Command="{Binding PreviousCommand}"
                                      ToolTip.Tip="{DynamicResource Text.Asset.Previous}"
                                      AutomationProperties.Name="{DynamicResource Text.Asset.Previous}" />
                    <TextBlock Classes="editor-label" Text="{Binding Total}" />
                    <views:IconButton Classes="editor-tool" Icon="Next" Command="{Binding NextCommand}"
                                      ToolTip.Tip="{DynamicResource Text.Asset.Next}"
                                      AutomationProperties.Name="{DynamicResource Text.Asset.Next}" />
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="180,*" ColumnSpacing="12">
                        <Border Width="180" Height="180" CornerRadius="5"
                                Background="{DynamicResource EffectWindowBackgroundBrush}">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Classes="editor-title" Text="{Binding SelectedAsset.Name}"
                                       TextWrapping="Wrap" />
                            <TextBlock Classes="editor-label" Text="{Binding SelectedAsset.Path}" TextWrapping="Wrap" />
                            <Button Classes="editor-action" Command="{Binding InspectReferencesCommand}"
                                    Content="{DynamicResource Text.References.Inspect}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                    <Expander Header="{DynamicResource Text.Asset.MaterialDetails}" IsExpanded="False">
                        <TextBlock Text="{Binding AssetDetails}" TextWrapping="Wrap" FontFamily="Consolas" />
                    </Expander>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Asset.Description}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Description}" AcceptsReturn="True" MinHeight="42" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Classes="editor-label" Text="{DynamicResource Text.Asset.SemanticUsage}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SemanticUsage}" PlaceholderText="{DynamicResource Text.Asset.SemanticHint}" />
                        <TextBlock Grid.Row="2" Classes="editor-label" Text="{DynamicResource Text.Asset.Tags}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Tags}" PlaceholderText="{DynamicResource Text.Asset.TagsHint}" />
                    </Grid>
                    <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Asset.Atlas}" />
                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="6">
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Asset.Columns}" />
                        <TextBox Grid.Column="1" Text="{Binding Columns}" />
                        <TextBlock Grid.Column="2" Classes="editor-label" Text="{DynamicResource Text.Asset.Rows}" />
                        <TextBox Grid.Column="3" Text="{Binding Rows}" />
                        <TextBlock Grid.Column="4" Classes="editor-label" Text="{DynamicResource Text.Asset.Fps}" />
                        <TextBox Grid.Column="5" Text="{Binding Fps}" />
                    </Grid>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                        <views:IconButton Classes="editor-tool" Icon="Save" Command="{Binding SaveMetadataCommand}"
                                          ToolTip.Tip="{DynamicResource Text.Asset.SaveMetadata}"
                                          AutomationProperties.Name="{DynamicResource Text.Asset.SaveMetadata}" />
                        <Button Classes="editor-action" Command="{Binding AddModelCommand}" Content="{DynamicResource Text.Asset.AddModel}" />
                        <Button Classes="editor-action" Command="{Binding AddSpriteCommand}" Content="{DynamicResource Text.Asset.AddSprite}" />
                        <Button Classes="editor-action" Click="OnOpenSpriteEditor" Content="{DynamicResource Text.Sprite.OpenFromAsset}" />
                    </WrapPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Resources.Target}" />
                        <ComboBox Grid.Column="1" x:Name="AssignmentTargetPicker" ItemsSource="{Binding AssignmentTargets}"
                                  SelectedItem="{Binding SelectedAssignmentTarget}"
                                  IsEnabled="{Binding CanSelectAssignmentTarget}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="{Binding AssignmentHint}"
                                  AutomationProperties.Name="{DynamicResource Text.Resources.Target}" />
                        <Button Grid.Column="2" x:Name="AssignResourceButton" Classes="editor-action" Command="{Binding AssignCommand}"
                                Content="{DynamicResource Text.Asset.Assign}" />
                    </Grid>
                    <TextBlock Classes="editor-label" Text="{Binding Status}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
    </TabItem>
    <TabItem Header="{DynamicResource Text.Resources.Roots}">
        <Grid Margin="12" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Classes="editor-label" Text="{Binding CallerHint}" TextWrapping="Wrap" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Classes="editor-card">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                        <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Resources.VirtualRoot}" />
                        <TextBlock Grid.Row="1" Classes="editor-label" Text="{Binding SelectedPeer.Label}" TextWrapping="Wrap" />
                        <ListBox Grid.Row="2" ItemsSource="{Binding VirtualRootEntries}"
                                 SelectedItem="{Binding SelectedVirtualRootEntry}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="services:AssetBrowserRootEntry">
                                    <StackPanel Margin="4">
                                        <TextBlock Classes="editor-heading" Text="{Binding Name}" />
                                        <TextBlock Classes="editor-label" Text="{Binding Path}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Classes="editor-card">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Resources.PhysicalRoot}" />
                            <views:IconButton Grid.Column="1" Classes="editor-tool" Icon="Refresh"
                                              Command="{Binding RefreshPhysicalRootCommand}"
                                              ToolTip.Tip="{DynamicResource Text.Resources.RefreshRoot}"
                                              AutomationProperties.Name="{DynamicResource Text.Resources.RefreshRoot}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Classes="editor-label" Text="{Binding PhysicalRootLabel}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Classes="editor-label" Text="{Binding PhysicalFolderLabel}" TextWrapping="Wrap" />
                        <ListBox Grid.Row="3" ItemsSource="{Binding PhysicalRootEntries}"
                                 SelectedItem="{Binding SelectedPhysicalRootEntry}" IsEnabled="{Binding HasPhysicalRoot}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="services:AssetBrowserRootEntry">
                                    <Grid ColumnDefinitions="Auto,*" Margin="4" ColumnSpacing="8">
                                        <TextBlock Text="{Binding KindLabel}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="editor-heading" Text="{Binding Name}" />
                                            <TextBlock Classes="editor-label" Text="{Binding Path}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                            <views:IconButton Classes="editor-tool" Icon="Previous" Command="{Binding NavigatePhysicalUpCommand}"
                                              ToolTip.Tip="{DynamicResource Text.Resources.NavigateUp}"
                                              AutomationProperties.Name="{DynamicResource Text.Resources.NavigateUp}" />
                            <views:IconButton Grid.Column="1" Classes="editor-tool" Icon="Open" Command="{Binding OpenPhysicalFolderCommand}"
                                              IsEnabled="{Binding CanOpenSelectedPhysicalFolder}"
                                              ToolTip.Tip="{DynamicResource Text.Resources.OpenFolder}"
                                              AutomationProperties.Name="{DynamicResource Text.Resources.OpenFolder}" />
                            <TextBox Text="{Binding PhysicalFolderName, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{DynamicResource Text.Resources.FolderName}"
                                     IsEnabled="{Binding HasPhysicalRoot}" Grid.Column="2" />
                            <views:IconButton Grid.Column="3" Classes="editor-tool" Icon="Add" Command="{Binding CreatePhysicalFolderCommand}"
                                              ToolTip.Tip="{DynamicResource Text.Resources.CreateFolder}"
                                              AutomationProperties.Name="{DynamicResource Text.Resources.CreateFolder}" />
                        </Grid>
                        <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <views:IconButton Classes="editor-tool" Icon="Previous" Command="{Binding PreviousPhysicalPageCommand}"
                                              ToolTip.Tip="{DynamicResource Text.Asset.Previous}"
                                              AutomationProperties.Name="{DynamicResource Text.Asset.Previous}" />
                            <TextBlock Grid.Column="1" Classes="editor-label" Text="{Binding PhysicalRootStatus}" TextWrapping="Wrap" />
                            <views:IconButton Grid.Column="2" Classes="editor-tool" Icon="Next" Command="{Binding NextPhysicalPageCommand}"
                                              ToolTip.Tip="{DynamicResource Text.Asset.Next}"
                                              AutomationProperties.Name="{DynamicResource Text.Asset.Next}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <TextBlock Grid.Row="2" Text="{Binding SelectedAssetReference.Identity}" TextWrapping="Wrap"
                       IsVisible="{Binding HasSelectedAssetReference}" />
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <ComboBox x:Name="RootAssignmentTargetPicker" Grid.Column="0" ItemsSource="{Binding AssignmentTargets}"
                          SelectedItem="{Binding SelectedAssignmentTarget}"
                          IsEnabled="{Binding CanSelectAssignmentTarget}"
                          AutomationProperties.Name="{DynamicResource Text.Resources.Target}" />
                <TextBlock Grid.Column="1" Classes="editor-label" Text="{Binding AssignmentHint}" TextWrapping="Wrap" />
                <Button Grid.Column="2" Classes="editor-action" Command="{Binding AssignCommand}"
                        Content="{DynamicResource Text.Asset.Assign}" />
            </Grid>
            <TextBlock Grid.Row="4" Classes="editor-label" Text="{Binding Status}" TextWrapping="Wrap" />
        </Grid>
    </TabItem>
    <TabItem Header="{DynamicResource Text.Resources.ProjectAndLocal}">
        <views:ProjectResourcesView DataContext="{Binding ProjectResources}" />
    </TabItem>
    <TabItem Header="{DynamicResource Text.Resources.IdentityTitle}">
        <views:ResourceIdentityView x:Name="ResourceIdentityPane" />
    </TabItem>
    <TabItem Header="{DynamicResource Text.References.Title}">
        <views:AssetReferencesView DataContext="{Binding References}" />
    </TabItem>
    </TabControl>
</UserControl>
