<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiberaFx.ViewModels"
        xmlns:services="using:LiberaFx.Services"
        xmlns:views="using:LiberaFx.Views"
        x:Class="LiberaFx.Views.SpriteEditorView" x:DataType="vm:SpriteEditorViewModel"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
    <ScrollViewer x:Name="EditorSurface" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Border Padding="14" MinWidth="898" MinHeight="688"
            Width="{Binding #EditorSurface.Viewport.Width}" Height="{Binding #EditorSurface.Viewport.Height}">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{DynamicResource Text.Asset.Peer}" VerticalAlignment="Center"/>
            <ComboBox Width="220" ItemsSource="{Binding Catalog.Peers}" SelectedItem="{Binding Catalog.SelectedPeer}"/>
            <TextBox Width="220" PlaceholderText="{DynamicResource Text.Asset.SearchHint}" Text="{Binding Catalog.Query}"/>
            <Button Content="{DynamicResource Text.Asset.Search}" Command="{Binding Catalog.SearchCommand}"/>
            <TextBlock Text="{DynamicResource Text.Sprite.TextureDimensions}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBlock Text="{Binding TextureDimensions}" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="240,*,330" ColumnSpacing="12">
            <Grid RowDefinitions="*,Auto">
                <ListBox ItemsSource="{Binding Catalog.Assets}" SelectedItem="{Binding Catalog.SelectedAsset}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="services:EngineAsset">
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Path}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5">
                    <Button Content="{DynamicResource Text.Asset.Previous}" Command="{Binding Catalog.PreviousCommand}"/>
                    <Button Content="{DynamicResource Text.Asset.Next}" Command="{Binding Catalog.NextCommand}"/>
                    <TextBlock Text="{Binding Catalog.Total}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                <WrapPanel Orientation="Horizontal">
                    <CheckBox Content="{DynamicResource Text.Sprite.GridSnap}" IsChecked="{Binding SnapToGrid}" Margin="0,0,10,0"/>
                    <TextBlock Text="{DynamicResource Text.Sprite.GridSize}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="60" Text="{Binding GridWidth, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip.Tip="{DynamicResource Text.Sprite.GridWidth}"/>
                    <TextBlock Text=" × " VerticalAlignment="Center"/>
                    <TextBox Width="60" Text="{Binding GridHeight, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip.Tip="{DynamicResource Text.Sprite.GridHeight}"/>
                    <Button Content="{DynamicResource Text.Sprite.AutoFlipbook}" Click="OnAutoFlipbook" Margin="8,0,0,0"/>
                </WrapPanel>
                <TabControl x:Name="AuthoringTabs" Grid.Row="1" MinHeight="170" SelectionChanged="OnAuthoringTabChanged">
                    <TabItem Header="{DynamicResource Text.Sprite.CutCells}">
                        <views:SpriteAtlasPreview x:Name="Atlas" MinHeight="140"/>
                    </TabItem>
                    <TabItem Header="{DynamicResource Text.Sprite.ComposeParts}">
                        <Grid RowDefinitions="*,Auto">
                            <views:SpriteCompositionPreview x:Name="CompositionPreview" MinHeight="140"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Text.Sprite.CompositionHelp}" TextWrapping="Wrap"/>
                        </Grid>
                    </TabItem>
                </TabControl>
                <WrapPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Content="{DynamicResource Text.Sprite.OpenLocal}" Click="OnOpenLocal"/>
                    <Button Content="{DynamicResource Text.Sprite.UseEnginePreview}" Click="OnUseEnginePreview"/>
                    <Button Content="{DynamicResource Text.Sprite.AddCell}" Click="OnAddCell"/>
                    <Button Content="{DynamicResource Text.Sprite.ZoomReset}" Click="OnResetZoom"/>
                    <TextBlock Text="{DynamicResource Text.Sprite.CanvasHelp}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </WrapPanel>
                <TextBlock Grid.Row="3" Text="{Binding SelectedCellInfo}" TextWrapping="Wrap"/>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Text.Sprite.FramePreview}" FontWeight="Bold"/>
                    <views:SpriteAtlasPreview x:Name="FramePreview" Height="96" IsFramePreview="True"/>
                    <Expander x:Name="PartProperties" Header="{DynamicResource Text.Sprite.PartProperties}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="6">
                    <TextBox Text="{Binding SelectedPart.Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="{DynamicResource Text.Sprite.PartVisible}" IsChecked="{Binding SelectedPart.Visible}"/>
                    <Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                        <TextBlock Text="{DynamicResource Text.Sprite.KeyTime}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding KeyTime, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource Text.Sprite.PartPosition}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" PlaceholderText="X" Text="{Binding PositionX}"/>
                        <TextBox Grid.Row="1" Grid.Column="2" PlaceholderText="Y" Text="{Binding PositionY}"/>
                        <TextBlock Grid.Row="2" Text="{DynamicResource Text.Sprite.PartRotation}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Rotation}"/>
                        <TextBlock Grid.Row="3" Text="{DynamicResource Text.Sprite.PartScale}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" PlaceholderText="X" Text="{Binding ScaleX}"/>
                        <TextBox Grid.Row="3" Grid.Column="2" PlaceholderText="Y" Text="{Binding ScaleY}"/>
                    </Grid>
                    <WrapPanel>
                        <Button Content="{DynamicResource Text.Sprite.SetKey}" Click="OnSetKey"/>
                        <Button Content="{DynamicResource Text.Sprite.DeleteKey}" Click="OnDeleteKey"/>
                    </WrapPanel>
                    </StackPanel>
                    </Expander>
                    <TextBlock Text="{DynamicResource Text.Sprite.Cells}" FontWeight="Bold"/>
                    <ListBox x:Name="SpriteCells" ItemsSource="{Binding Cells}" SelectedItem="{Binding SelectedCell}"
                             Height="160" DoubleTapped="OnCellDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="services:SpriteAnimationCell">
                                <Grid ColumnDefinitions="56,*" ColumnSpacing="8" Margin="2">
                                    <views:SpriteCellThumbnail Width="52" Height="40"
                                        Bitmap="{ReflectionBinding DataContext.TextureBitmap, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Cells="{ReflectionBinding DataContext.Cells, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CellId="{Binding Id}"
                                        TextureWidth="{ReflectionBinding DataContext.TexturePixelWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        TextureHeight="{ReflectionBinding DataContext.TexturePixelHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock>
                                            <Run Text="{Binding X}"/><Run Text=", "/><Run Text="{Binding Y}"/>
                                            <Run Text=" · "/><Run Text="{Binding Width}"/><Run Text=" × "/><Run Text="{Binding Height}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Button Content="{DynamicResource Text.Sprite.DeleteCell}" Click="OnDeleteCell"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Text.Sprite.DrawHint}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5">
                        <TextBlock Text="{DynamicResource Text.Sprite.CellName}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding CellName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource Text.Sprite.CellPosition}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBox Width="65" PlaceholderText="X" Text="{Binding CellX, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Width="65" PlaceholderText="Y" Text="{Binding CellY, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="{DynamicResource Text.Sprite.CellSize}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBox Width="65" PlaceholderText="W" Text="{Binding CellWidth, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Width="65" PlaceholderText="H" Text="{Binding CellHeight, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Separator/>
                    <TextBlock Text="{DynamicResource Text.Sprite.FrameProperties}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedFrameInfo}" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5">
                        <TextBlock Text="{DynamicResource Text.Sprite.Fps}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SequenceFps, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource Text.Sprite.DurationMs}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DurationMilliseconds, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Text="{DynamicResource Text.Sprite.PlaybackRange}" VerticalAlignment="Center" IsVisible="{Binding !IsComposition}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsComposition}">
                            <TextBox Width="65" PlaceholderText="{DynamicResource Text.Sprite.RangeStart}" Text="{Binding RangeStart, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Width="65" PlaceholderText="{DynamicResource Text.Sprite.RangeEnd}" Text="{Binding RangeEnd, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="{DynamicResource Text.Sprite.Loop}"
                                  IsChecked="{Binding Loop}"/>
                    </Grid>
                    <CheckBox Content="{DynamicResource Text.Sprite.Playing}" IsChecked="{Binding Playing}"/>

                    <Separator/>
                    <TextBlock Text="{DynamicResource Text.Sprite.LegacyGrid}" FontWeight="Bold" IsVisible="{Binding !IsComposition}"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5" IsVisible="{Binding !IsComposition}">
                        <TextBlock Text="{DynamicResource Text.Asset.Columns}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Catalog.Columns, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource Text.Asset.Rows}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Catalog.Rows, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Text="{DynamicResource Text.Asset.Fps}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Catalog.Fps, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="3" Text="{DynamicResource Text.Sprite.Frame}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Frame, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource Text.Sprite.FrameBindingNotice}" TextWrapping="Wrap" IsVisible="{Binding !IsComposition}"/>
                    <TextBlock Text="{DynamicResource Text.Sprite.MaterialNotice}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PreviewSource}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CatalogStatus}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                    <Button Content="{DynamicResource Text.Sprite.LoadSelected}" Click="OnLoadSelected"/>
                    <Button Content="{DynamicResource Text.Asset.SaveMetadata}" Command="{Binding Catalog.SaveMetadataCommand}"/>
                    <Button Content="{DynamicResource Text.Sprite.ApplySelected}" Click="OnApplySelected"
                            IsEnabled="{Binding CanApply}"/>
                    <Button Content="{DynamicResource Text.Sprite.Create}" Click="OnCreate"
                            IsEnabled="{Binding CanApply}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource EffectBorderBrush}" BorderThickness="1" Padding="8">
            <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="4">
                <WrapPanel>
                    <TextBlock Text="{DynamicResource Text.Sprite.Timeline}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Width="180" ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SpritePartViewModel"><TextBlock Text="{Binding Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{DynamicResource Text.Sprite.AddPart}" Click="OnAddPart"/>
                    <Button Content="{DynamicResource Text.Sprite.RemovePart}" Click="OnRemovePart"/>
                    <Button Content="{DynamicResource Text.Sprite.PartBackward}" Click="OnPartBackward"/>
                    <Button Content="{DynamicResource Text.Sprite.PartForward}" Click="OnPartForward"/>
                </WrapPanel>
                <ScrollViewer Grid.Row="1" MaxHeight="180" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <views:SpriteTimeline x:Name="Timeline"/>
                </ScrollViewer>
                <WrapPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Content="{DynamicResource Text.Sprite.PlayStop}" Click="OnTogglePlayback" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Text.Sprite.PreviousFrame}" Click="OnPreviousFrame"/>
                    <Button Content="{DynamicResource Text.Sprite.NextFrame}" Click="OnNextFrame" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource Text.Sprite.AddToTimeline}" Click="OnAddFrame"/>
                    <Button Content="{DynamicResource Text.Sprite.DuplicateFrame}" Click="OnDuplicateFrame"/>
                    <Button Content="{DynamicResource Text.Sprite.DeleteFrame}" Click="OnDeleteFrame" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource Text.Sprite.FrameLeft}" Click="OnFrameUp"/>
                    <Button Content="{DynamicResource Text.Sprite.FrameRight}" Click="OnFrameDown"/>
                </WrapPanel>
                <TextBlock Grid.Row="3" Text="{DynamicResource Text.Sprite.TimelineHelp}" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
    </ScrollViewer>
</UserControl>
