<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:LiberaFx.Services"
        x:Class="LiberaFx.Views.LocalProjectsWindow"
        Title="{DynamicResource Text.Library.Title}"
        Width="880" Height="560" MinWidth="600" MinHeight="400"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
    <TextBlock Text="{DynamicResource Text.Library.Hint}" TextWrapping="Wrap" />
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
      <TextBlock x:Name="Folder" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1" Margin="8,0" Content="{DynamicResource Text.Library.ChooseFolder}" Click="OnChooseFolder" />
      <Button Grid.Column="2" Content="{DynamicResource Text.Library.Refresh}" Click="OnRefresh" />
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <TextBox x:Name="Query" PlaceholderText="{DynamicResource Text.Library.Search}" TextChanged="OnQueryChanged" />
      <CheckBox x:Name="Recursive" Grid.Column="1" Margin="12,0" IsChecked="True"
                Content="{DynamicResource Text.Library.Subfolders}" IsCheckedChanged="OnRecursiveChanged" />
    </Grid>
    <ListBox x:Name="Projects" Grid.Row="3" DoubleTapped="OnOpenProject">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="services:LocalProjectAsset">
          <StackPanel Margin="8" Spacing="3">
            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            <TextBlock Text="{Binding Modified}" Foreground="{DynamicResource EffectMutedForegroundBrush}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
      <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="{DynamicResource Text.Library.Open}" Click="OnOpenProject" />
    </Grid>
  </Grid>
</Window>
