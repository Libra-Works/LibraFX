<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiberaFx.ViewModels"
             xmlns:views="using:LiberaFx.Views"
             x:Class="LiberaFx.Views.NodePropertiesView"
             Classes="editor-inspector"
             FontSize="12"
             x:DataType="vm:NodePropertiesPaneViewModel">
    <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="8,4">
        <TextBlock Classes="editor-heading" Text="{Binding InspectorTitle}" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <views:IconButton Grid.Column="1" Icon="{Binding InspectorPinIcon}" IsEnabled="{Binding CanTogglePin}"
                          Click="OnTogglePinClick" ToolTip.Tip="{Binding InspectorPinHint}"
                          AutomationProperties.Name="{Binding InspectorPinHint}" />
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="8" Spacing="6" MinWidth="290">
        <TextBlock Text="{DynamicResource Text.Editor.SelectNodeHint}"
                   IsVisible="{Binding !HasInspectorTarget}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource EffectMutedForegroundBrush}" />
        <StackPanel IsVisible="{Binding Graph.IsRootGraph}" IsEnabled="{Binding !IsPinned}" Spacing="4">
            <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Editor.EffectSettings}" />
            <CheckBox Content="{DynamicResource Text.Editor.AutoDestroyWhenIdle}"
                      IsChecked="{Binding Graph.AutoDestroyWhenIdle, Mode=TwoWay}" />
            <TextBlock Text="{DynamicResource Text.Editor.AutoDestroyWhenIdleHelp}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
        </StackPanel>
        <TextBlock Text="{DynamicResource Text.Panels.ContainingSpawnableHint}"
                   IsVisible="{Binding IsInspectingContainingSpawnable}" TextWrapping="Wrap"
                   Foreground="{DynamicResource EffectMutedForegroundBrush}" />
        <StackPanel IsVisible="{Binding HasInspectorTarget}" Spacing="4">
            <TextBlock Text="{DynamicResource Text.Editor.Type}"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            <TextBlock Text="{Binding InspectorNodeType}"
                       Foreground="{DynamicResource EffectForegroundBrush}" />
            <TextBlock Text="{DynamicResource Text.Editor.Name}"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            <TextBox Text="{Binding InspectorNodeName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     IsReadOnly="{Binding IsInspectingContainingSpawnable}" />
            <Border Classes="editor-card" IsVisible="{Binding CanManageGroup}" Margin="0,8,0,0">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Editor.GroupAsset}"
                                   VerticalAlignment="Center" />
                        <views:IconButton x:Name="SaveGroupButton" Classes="editor-tool" Grid.Column="1" Icon="Save"
                                          IsVisible="{Binding !IsStandardGroup}"
                                          Command="{Binding SaveGroupCommand}"
                                          ToolTip.Tip="{DynamicResource Text.Editor.SaveGroup}"
                                          AutomationProperties.Name="{DynamicResource Text.Editor.SaveGroup}" />
                        <views:IconButton x:Name="GroupLockButton" Classes="editor-tool" Grid.Column="2" Icon="{Binding GroupLockIcon}"
                                          IsVisible="{Binding IsProjectLinkedGroup}" Command="{Binding ToggleGroupLockCommand}"
                                          ToolTip.Tip="{Binding GroupLockHint}" AutomationProperties.Name="{Binding GroupLockHint}" />
                    </Grid>
                    <TextBlock Text="{Binding GroupRevision}" IsVisible="{Binding IsLinkedGroup}" />
                    <TextBlock Text="{Binding GroupStatus}" TextWrapping="Wrap"
                               Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                    <TextBlock Text="{Binding StandardGroupDetails}" TextWrapping="Wrap"
                               IsVisible="{Binding IsStandardGroup}"
                               Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                    <Button Content="{DynamicResource Text.Modules.CloneToProject}"
                            IsVisible="{Binding IsStandardGroup}"
                            IsEnabled="{Binding CanCloneGroup}"
                            Command="{Binding CloneGroupCommand}" />
                </StackPanel>
            </Border>
            <Grid x:Name="ParameterHeader" ColumnDefinitions="124,*" ColumnSpacing="6" Margin="0,8,0,0">
                <TextBlock Text="{DynamicResource Text.Editor.Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <Thumb HorizontalAlignment="Right" Width="8"
                       Cursor="SizeWestEast" DragDelta="OnParameterDividerDrag"
                       ToolTip.Tip="{DynamicResource Text.Panels.InspectorResize}"
                       AutomationProperties.Name="{DynamicResource Text.Panels.InspectorResize}">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Border Background="Transparent">
                                <Border Background="{DynamicResource EffectBorderBrush}" Width="2" HorizontalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <TextBlock Grid.Column="1" Text="{DynamicResource Text.Panels.Value}" />
            </Grid>
            <ItemsControl x:Name="ParameterList" ItemsSource="{Binding Parameters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:NodeParameterEditorViewModel">
                        <views:ParameterEditorHost Margin="0,0,0,2" PreserveEditorWidth="True" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{DynamicResource Text.Panels.PublishGroupCurves}"
                    IsVisible="{Binding CanPublishCurves}"
                    Command="{Binding PublishCurvesCommand}"
                    ToolTip.Tip="{DynamicResource Text.Panels.PublishGroupCurvesHelp}" />
            <Button Content="{DynamicResource Text.Panels.EditGroupCurves}"
                    IsVisible="{Binding CanEditGroupCurves}" Click="OnEditGroupCurvesClick" />
            <Button Content="{DynamicResource Text.Panels.ConfigureGroupItems}"
                    IsVisible="{Binding CanConfigureGroupItems}" Click="OnConfigureGroupItemsClick" />
            <TextBlock Text="{Binding GroupExposedDiagnostics}" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            <TextBlock Text="{Binding PluginStatus}" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            <TextBlock Text="{DynamicResource Text.Editor.Connections}" Margin="0,10,0,0"
                       IsVisible="{Binding ShowSelectedConnections}"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            <ItemsControl ItemsSource="{Binding Graph.SelectedConnections}"
                          IsVisible="{Binding ShowSelectedConnections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:GraphConnectionViewModel">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="0,2">
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding SignalOrderHelp}" />
                            <views:IconButton Grid.Column="1" Icon="Disconnect" Tag="{Binding}"
                                    ToolTip.Tip="{DynamicResource Text.Editor.Disconnect}"
                                    AutomationProperties.Name="{DynamicResource Text.Editor.Disconnect}"
                                    Click="OnDisconnectClick" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
