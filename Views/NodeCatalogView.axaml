<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiberaFx.ViewModels"
             xmlns:views="using:LiberaFx.Views"
             x:Class="LiberaFx.Views.NodeCatalogView"
             x:DataType="vm:NodeCatalogViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="10" ColumnSpacing="6" RowSpacing="6">
            <TextBlock Grid.ColumnSpan="2" Text="{Binding ProjectName}"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            <TextBox Grid.Row="1" PlaceholderText="{DynamicResource Text.Editor.SearchNodes}"
                     AutomationProperties.Name="{DynamicResource Text.Editor.SearchNodes}"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <views:IconButton Grid.Row="1" Grid.Column="1" Icon="Refresh" Command="{Binding RefreshCommand}"
                              ToolTip.Tip="{DynamicResource Text.Editor.Refresh}"
                              AutomationProperties.Name="{DynamicResource Text.Editor.Refresh}" />
        </Grid>
        <ScrollViewer Grid.Row="1">
        <StackPanel Margin="10,0,10,10" Spacing="6">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:NodeCatalogGroupViewModel">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource EffectForegroundBrush}" />
                            <ItemsControl ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:NodeCatalogEntryViewModel">
                                        <Border Padding="8,5" Margin="0,1"
                                                Background="{DynamicResource EffectSurfaceBrush}"
                                                Tag="{Binding DragIdentifier}"
                                                ToolTip.Tip="{DynamicResource Text.Editor.DragNode}"
                                                PointerPressed="OnNodePointerPressed"
                                                PointerMoved="OnNodePointerMoved"
                                                PointerReleased="OnNodePointerReleased"
                                                PointerCaptureLost="OnNodePointerCaptureLost">
                                            <TextBlock Text="{Binding Name}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,8,0,0"
                       Text="{DynamicResource Text.Editor.DragHint}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
        </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Margin="10" Text="{Binding LoadWarnings}"
                   TextWrapping="Wrap" Foreground="{DynamicResource EffectMutedForegroundBrush}" />
    </Grid>
</UserControl>
