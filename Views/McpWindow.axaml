<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiberaFx.ViewModels"
        xmlns:views="using:LiberaFx.Views"
        x:Class="LiberaFx.Views.McpWindow"
        x:DataType="vm:MainViewModel"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="8">
            <TextBlock Text="{DynamicResource Text.Panels.McpConnection}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding McpStatus}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Text.Panels.StreamableHttpEndpoint}" Margin="0,8,0,0" />
            <TextBox Text="{Binding McpEndpoint}" IsReadOnly="True" />
            <TextBlock Text="X-LiberaFx-Token" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="TokenBox" Text="{Binding McpAccessToken}"
                         IsReadOnly="True" PasswordChar="●" />
                <views:IconButton Grid.Column="1" Icon="Copy" Click="OnCopyTokenClick"
                                  ToolTip.Tip="{DynamicResource Text.Panels.CopyAccessToken}"
                                  AutomationProperties.Name="{DynamicResource Text.Panels.CopyAccessToken}" />
            </Grid>
            <CheckBox Content="{DynamicResource Text.Panels.ShowToken}" IsCheckedChanged="OnShowTokenChanged" />
            <TextBlock Text="{DynamicResource Text.Panels.McpSecurityNotice}"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" TextWrapping="Wrap" />
            <Separator Margin="0,8" />
            <TextBlock Text="{DynamicResource Text.OperatorSkill.Title}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Text.OperatorSkill.Help}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Text.OperatorSkill.BundledPath}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="OperatorSkillPathBox" IsReadOnly="True"
                         AutomationProperties.Name="{DynamicResource Text.OperatorSkill.BundledPath}" />
                <views:IconButton x:Name="CopyOperatorSkillPathButton" Grid.Column="1" Icon="Copy"
                                  Click="OnCopyOperatorSkillPathClick"
                                  ToolTip.Tip="{DynamicResource Text.OperatorSkill.CopyPath}"
                                  AutomationProperties.Name="{DynamicResource Text.OperatorSkill.CopyPath}" />
            </Grid>
            <TextBlock Text="{DynamicResource Text.OperatorSkill.Destination}" TextWrapping="Wrap" />
            <TextBox x:Name="OperatorSkillsDirectoryBox"
                     AutomationProperties.Name="{DynamicResource Text.OperatorSkill.Destination}" />
            <CheckBox x:Name="ReplaceOperatorSkillBox" Content="{DynamicResource Text.OperatorSkill.Replace}" />
            <Button x:Name="InstallOperatorSkillButton" Content="{DynamicResource Text.OperatorSkill.Install}"
                    Click="OnInstallOperatorSkillClick" HorizontalAlignment="Left" />
            <TextBlock x:Name="OperatorSkillStatus" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
