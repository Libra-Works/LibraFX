<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiberaFx.ViewModels"
        xmlns:services="using:LiberaFx.Services"
        xmlns:views="using:LiberaFx.Views"
        x:Class="LiberaFx.Views.LogWindow"
        x:DataType="vm:MainViewModel"
        Title="{DynamicResource Text.Panels.LogTitle}" Width="860" Height="460" MinWidth="420" MinHeight="220"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
    <Grid RowDefinitions="Auto,*">
        <Border Padding="10" Background="{DynamicResource EffectSurfaceBrush}"
                BorderBrush="{DynamicResource EffectBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <views:IconButton DockPanel.Dock="Right" Icon="Delete" Click="OnClearClick"
                                  ToolTip.Tip="{DynamicResource Text.Panels.ClearLog}"
                                  AutomationProperties.Name="{DynamicResource Text.Panels.ClearLog}" />
                <TextBlock Text="{DynamicResource Text.Panels.EditorActivity}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
        </Border>
        <ListBox Grid.Row="1" ItemsSource="{Binding Log.Entries}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="services:EditorLogEntry">
                    <Grid ColumnDefinitions="95,90,*" ColumnSpacing="8" Margin="4,2">
                        <TextBlock Text="{Binding Time}" Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Category}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
