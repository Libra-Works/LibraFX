<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiberaFx.ViewModels" xmlns:views="using:LiberaFx.Views"
             x:Class="LiberaFx.Views.TimelineView" x:DataType="vm:TimelineViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Classes="editor-bar" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <views:PlaybackTransport ShowFrameTools="True" DataContext="{Binding Playback}" />
                        <views:IconButton Classes="editor-tool" Icon="Frame" Click="OnFrameAllClick"
                                          ToolTip.Tip="{DynamicResource Text.Panels.FrameAll}"
                                          AutomationProperties.Name="{DynamicResource Text.Panels.FrameAll}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Timeline.Range}" />
                        <TextBox Classes="editor-field" Width="78"
                                 AutomationProperties.Name="{DynamicResource Text.Timeline.RangeStart}"
                                 Text="{Binding Playback.StartText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Classes="editor-label" Text="&#8211;" />
                        <TextBox Classes="editor-field" Width="78"
                                 AutomationProperties.Name="{DynamicResource Text.Timeline.RangeEnd}"
                                 Text="{Binding Playback.EndText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Timeline.Fps}" Margin="5,0,0,0" />
                        <TextBox Classes="editor-field" Width="50" AutomationProperties.Name="{DynamicResource Text.Timeline.Fps}"
                                 Text="{Binding Playback.FpsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <CheckBox Content="{DynamicResource Text.Timeline.UseSeconds}" IsChecked="{Binding Playback.ShowSeconds}"
                                  VerticalAlignment="Center" />
                        <CheckBox Content="{DynamicResource Text.Timeline.Loop}" IsChecked="{Binding Playback.Loop}"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="AddPreviewSignalButton" Content="{DynamicResource Text.Timeline.AddPreviewSignal}"
                                Command="{Binding AddPreviewSignalKeyCommand}" />
                        <Button x:Name="AddRuntimeSignalButton" Content="{DynamicResource Text.Timeline.AddRuntimeSignal}"
                                Command="{Binding AddRuntimeSignalKeyCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="*,180">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <views:TimelineCanvas x:Name="Canvas" Height="{Binding CanvasHeight}" />
            </ScrollViewer>
            <Border Grid.Column="1" Classes="editor-inspector" Padding="8"
                    BorderBrush="{DynamicResource EditorChromeDividerBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="4">
                <TextBlock Classes="editor-heading" Text="{Binding SelectedTrack.Name}" TextWrapping="Wrap" />
                <StackPanel IsVisible="{Binding SelectedTrack.IsCurve}" Spacing="4">
                    <TextBlock Text="{DynamicResource Text.Timeline.Start}" />
                    <TextBox Text="{Binding SelectedTrack.StartText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="{DynamicResource Text.Timeline.Duration}" />
                    <TextBox IsEnabled="{Binding SelectedTrack.CanStretch}" Text="{Binding SelectedTrack.DurationText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <StackPanel IsVisible="{Binding SelectedTrack.IsSignal}" Spacing="4">
                    <ListBox ItemsSource="{Binding SelectedTrack.SignalKeys}" SelectedItem="{Binding SelectedSignalKey}"
                             MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimelineSignalKeyViewModel">
                                <TextBlock Text="{Binding TimeText}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{DynamicResource Text.Timeline.SignalTime}" />
                    <TextBox Text="{Binding SignalTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <Button Content="{DynamicResource Text.Timeline.DeleteSignal}" Command="{Binding DeleteSignalKeyCommand}" />
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" Classes="editor-bar" BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock Classes="editor-label" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="editor-label" Text="{Binding Playback.Status}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
