<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsControls="using:LiberaFx.Views.Controls"
             xmlns:vmGraph="using:LiberaFx.ViewModels.Graph"
        x:Class="LiberaFx.Views.Panels.ProblemsWindow"
        x:DataType="vmGraph:GraphWorkspaceViewModel"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
    <Grid RowDefinitions="Auto,*" Margin="10" RowSpacing="6">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
            <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Messages.GraphProblemsTitle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="editor-label" Text="{Binding TypeProblems.Count, StringFormat='({0})'}"
                       IsVisible="{Binding HasTypeProblems}" VerticalAlignment="Center" />
            <Border Grid.Column="3" Background="Transparent" Padding="2"
                    ToolTip.Tip="{DynamicResource Text.Messages.GraphProblemsHelp}">
                <viewsControls:EditorIconView Icon="Info" />
            </Border>
        </Grid>
        <TextBlock Grid.Row="1" Classes="editor-label"
                   Text="{DynamicResource Text.Messages.GraphProblemsEmpty}"
                   IsVisible="{Binding !HasTypeProblems}"
                   Foreground="{DynamicResource EffectMutedForegroundBrush}"
                   TextWrapping="Wrap" Margin="2,4" />
        <ScrollViewer Grid.Row="1" IsVisible="{Binding HasTypeProblems}">
            <ItemsControl ItemsSource="{Binding TypeProblems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vmGraph:GraphProblemViewModel">
                        <Button Classes="editor-action" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{Binding Message}" ToolTip.Tip="{Binding Message}"
                                Margin="0,2">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
