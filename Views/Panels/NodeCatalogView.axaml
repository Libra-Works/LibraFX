<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsControls="using:LiberaFx.Views.Controls"
             xmlns:vmGraph="using:LiberaFx.ViewModels.Graph"
             x:Class="LiberaFx.Views.Panels.NodeCatalogView"
             x:DataType="vmGraph:NodeCatalogViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="10" ColumnSpacing="6" RowSpacing="6">
            <TextBlock Grid.ColumnSpan="2" Text="{Binding ProjectName}"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            <TextBox Grid.Row="1" PlaceholderText="{DynamicResource Text.Editor.SearchNodes}"
                     AutomationProperties.Name="{DynamicResource Text.Editor.SearchNodes}"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <viewsControls:IconButton Grid.Row="1" Grid.Column="1" Icon="Refresh" Command="{Binding RefreshCommand}"
                              ToolTip.Tip="{DynamicResource Text.Editor.Refresh}"
                              AutomationProperties.Name="{DynamicResource Text.Editor.Refresh}" />
        </Grid>
        <ScrollViewer Grid.Row="1">
        <StackPanel Margin="10,0,10,10" Spacing="6">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vmGraph:NodeCatalogGroupViewModel">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource EffectForegroundBrush}" />
                            <ItemsControl ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vmGraph:NodeCatalogEntryViewModel">
                                        <Border Padding="8,5" Margin="0,1"
                                                Background="{DynamicResource EffectSurfaceBrush}"
                                                Opacity="{Binding DisplayOpacity}"
                                                Tag="{Binding DragIdentifier}"
                                                ToolTip.Tip="{Binding ToolTipText}"
                                                ToolTip.ShowOnDisabled="True"
                                                PointerPressed="OnNodePointerPressed"
                                                PointerMoved="OnNodePointerMoved"
                                                PointerReleased="OnNodePointerReleased"
                                                PointerCaptureLost="OnNodePointerCaptureLost">
                                            <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="{Binding ConversionDescription}"
                                                           IsVisible="{Binding HasConversions}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding FavoriteGlyph}" Padding="5,0"
                                                    Command="{Binding ToggleFavoriteCommand}"
                                                    ToolTip.Tip="{Binding FavoriteHelp}"
                                                    AutomationProperties.Name="{Binding FavoriteHelp}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Margin="10,4" Text="{Binding LoadWarnings}"
                   IsVisible="{Binding LoadWarnings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap" Foreground="{DynamicResource EffectMutedForegroundBrush}" />
    </Grid>
</UserControl>
