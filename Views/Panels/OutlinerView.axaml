<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmPanels="using:LiberaFx.ViewModels.Panels"
             x:Class="LiberaFx.Views.Panels.OutlinerView"
             x:DataType="vmPanels:OutlinerViewModel">
    <Grid RowDefinitions="Auto,*">
        <TextBox Margin="10" PlaceholderText="{DynamicResource Text.Panels.SearchNodes}"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TreeView Grid.Row="1"
                  ItemsSource="{Binding Nodes}"
                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="MinHeight" Value="22" />
                    <Setter Property="Padding" Value="2,0" />
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="vmPanels:OutlinerNode" ItemsSource="{Binding Children}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="2,1">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding PortType}"
                                   Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                    </Grid>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
