<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsControls="using:LiberaFx.Views.Controls"
             xmlns:vmGraph="using:LiberaFx.ViewModels.Graph"
             xmlns:vmPanels="using:LiberaFx.ViewModels.Panels"
             x:Class="LiberaFx.Views.Panels.NodePropertiesView"
             Classes="editor-inspector"
             x:DataType="vmPanels:NodePropertiesPaneViewModel">
    <Grid RowDefinitions="Auto,*">
    <Border Classes="editor-bar" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Gpu.Properties}"
                           IsVisible="{Binding HasGpuInspector}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Classes="editor-heading" Text="{Binding InspectorNodeType}"
                           IsVisible="{Binding HasInspectorTarget}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Classes="editor-heading" Text="{Binding InspectorTitle}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!HasInspectorTarget" />
                            <Binding Path="!HasGpuInspector" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <TextBlock Classes="editor-label" Text="{DynamicResource Text.Panels.ContainingSpawnable}"
                           IsVisible="{Binding IsInspectingContainingSpawnable}"
                           ToolTip.Tip="{DynamicResource Text.Panels.ContainingSpawnableHint}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <viewsControls:IconButton Grid.Column="1" Classes="editor-tool" Icon="{Binding InspectorPinIcon}" IsEnabled="{Binding CanTogglePin}"
                              IsVisible="{Binding !HasGpuInspector}"
                              Click="OnTogglePinClick" ToolTip.Tip="{Binding InspectorPinHint}"
                              AutomationProperties.Name="{Binding InspectorPinHint}" />
        </Grid>
    </Border>
    <ContentControl Grid.Row="1" Content="{Binding ActiveGpuInspector}" IsVisible="{Binding HasGpuInspector}" />
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !HasGpuInspector}">
    <StackPanel Margin="8" Spacing="6">
        <TextBlock Classes="editor-label"
                   Text="{DynamicResource Text.Panels.InspectorEmptyHint}"
                   IsVisible="{Binding !HasInspectorTarget}"
                   Foreground="{DynamicResource EffectMutedForegroundBrush}"
                   TextWrapping="Wrap" Margin="2,4" />
        <StackPanel IsVisible="{Binding HasInspectorTarget}" Spacing="6">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.Name}" />
                <TextBox Grid.Column="1" Text="{Binding InspectorNodeName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         IsReadOnly="{Binding IsInspectingContainingSpawnable}" />
                <viewsControls:IconButton Grid.Column="2" Classes="editor-tool" Icon="{Binding NodeLockIcon}"
                                  IsEnabled="{Binding CanToggleNodeLock}"
                                  Command="{Binding ToggleNodeLockCommand}"
                                  ToolTip.Tip="{Binding NodeLockHint}"
                                  AutomationProperties.Name="{Binding NodeLockHint}" />
            </Grid>
            <Border Classes="editor-card" IsVisible="{Binding HasLiveDebugValues}">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Classes="editor-heading" Text="{DynamicResource Text.ExecutionDebug.Title}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <viewsControls:IconButton Classes="editor-tool" Icon="Pause" Command="{Binding DebugPauseCommand}"
                                              ToolTip.Tip="{DynamicResource Text.ExecutionDebug.Pause}" />
                            <viewsControls:IconButton Classes="editor-tool" Icon="StepForward" Command="{Binding DebugStepCommand}"
                                              ToolTip.Tip="{DynamicResource Text.ExecutionDebug.Step}" />
                            <viewsControls:IconButton Classes="editor-tool" Icon="Play" Command="{Binding DebugResumeCommand}"
                                              ToolTip.Tip="{DynamicResource Text.ExecutionDebug.Resume}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="editor-label" Text="{Binding LiveDebugNodeHeader}" TextWrapping="Wrap" />
                    <TextBlock Classes="editor-label" Text="{Binding LiveDebugSignalSource}" TextWrapping="Wrap"
                               IsVisible="{Binding LiveDebugSignalSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ItemsControl ItemsSource="{Binding LiveDebugInputs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="11" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding LiveDebugAuthoredParameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource EffectMutedForegroundBrush}" FontSize="11" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Classes="editor-toolbar-group" IsVisible="{Binding InspectorNode.HasDynamicPins, FallbackValue=False}" Padding="6,4">
                <StackPanel Spacing="6">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    IsVisible="{Binding InspectorNode.HasDynamicInputs, FallbackValue=False}">
                            <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.DynamicPins.Inputs}" />
                            <viewsControls:IconButton Classes="editor-tool" Icon="Add"
                                              Command="{Binding InspectorNode.AddDynamicInputCommand}"
                                              ToolTip.Tip="{DynamicResource Text.Editor.DynamicPins.AddInput}"
                                              AutomationProperties.Name="{DynamicResource Text.Editor.DynamicPins.AddInput}" />
                            <viewsControls:IconButton Classes="editor-tool" Icon="Remove"
                                              Command="{Binding InspectorNode.RemoveDynamicInputCommand}"
                                              ToolTip.Tip="{DynamicResource Text.Editor.DynamicPins.RemoveInput}"
                                              AutomationProperties.Name="{DynamicResource Text.Editor.DynamicPins.RemoveInput}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    IsVisible="{Binding InspectorNode.HasDynamicOutputs, FallbackValue=False}">
                            <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.DynamicPins.Outputs}" />
                            <viewsControls:IconButton Classes="editor-tool" Icon="Add"
                                              Command="{Binding InspectorNode.AddDynamicOutputCommand}"
                                              ToolTip.Tip="{DynamicResource Text.Editor.DynamicPins.AddOutput}"
                                              AutomationProperties.Name="{DynamicResource Text.Editor.DynamicPins.AddOutput}" />
                            <viewsControls:IconButton Classes="editor-tool" Icon="Remove"
                                              Command="{Binding InspectorNode.RemoveDynamicOutputCommand}"
                                              ToolTip.Tip="{DynamicResource Text.Editor.DynamicPins.RemoveOutput}"
                                              AutomationProperties.Name="{DynamicResource Text.Editor.DynamicPins.RemoveOutput}" />
                        </StackPanel>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding InspectorNode.CpuCustomPinNames}"
                                  IsVisible="{Binding InspectorNode.IsCpuParticleAttributeStage, FallbackValue=False}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmGraph:GraphNodeViewModel+CpuCustomPinNameEntry">
                                <Grid ColumnDefinitions="76,*" ColumnSpacing="6" Margin="0,2,0,0">
                                    <TextBlock Classes="editor-label" Text="{Binding DefaultName}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             PlaceholderText="{Binding DefaultName}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Classes="editor-toolbar-group" IsVisible="{Binding CanManageGroup}" Padding="6,4"
                    ToolTip.Tip="{Binding GroupStatus}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Editor.GroupAsset}"
                                   VerticalAlignment="Center" />
                        <TextBlock Classes="editor-label" Text="{Binding GroupRevision}"
                                   IsVisible="{Binding IsLinkedGroup}" VerticalAlignment="Center" />
                    </StackPanel>
                    <viewsControls:IconButton x:Name="SaveGroupButton" Classes="editor-tool" Grid.Column="1" Icon="Save"
                                      IsVisible="{Binding !IsStandardGroup}"
                                      Command="{Binding SaveGroupCommand}"
                                      ToolTip.Tip="{DynamicResource Text.Editor.SaveGroup}"
                                      AutomationProperties.Name="{DynamicResource Text.Editor.SaveGroup}" />
                    <viewsControls:IconButton x:Name="GroupLockButton" Classes="editor-tool" Grid.Column="2" Icon="{Binding GroupLockIcon}"
                                      IsVisible="{Binding IsProjectLinkedGroup}" Command="{Binding ToggleGroupLockCommand}"
                                      ToolTip.Tip="{Binding GroupLockHint}" AutomationProperties.Name="{Binding GroupLockHint}" />
                    <viewsControls:IconButton x:Name="UnlinkGroupButton" Classes="editor-tool" Grid.Column="3" Icon="Disconnect"
                                      IsVisible="{Binding IsLinkedGroup}" Command="{Binding UnlinkGroupCommand}"
                                      ToolTip.Tip="{DynamicResource Text.Editor.UnlinkGroupTip}"
                                      AutomationProperties.Name="{DynamicResource Text.Editor.UnlinkGroup}" />
                    <Button Grid.Column="4" Classes="editor-action" Content="{DynamicResource Text.Modules.CloneToProject}"
                            IsVisible="{Binding IsStandardGroup}"
                            IsEnabled="{Binding CanCloneGroup}"
                            Command="{Binding CloneGroupCommand}"
                            ToolTip.Tip="{Binding StandardGroupDetails}" />
                </Grid>
            </Border>
            <Grid x:Name="ParameterHeader" ColumnDefinitions="124,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="4" Margin="0,2,0,0"
                  SizeChanged="OnParameterHeaderSizeChanged">
                <TextBlock Classes="editor-label" Text="{DynamicResource Text.Editor.Name}" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" />
                <TextBlock Grid.Column="1" Classes="editor-label" Text="{DynamicResource Text.Panels.Value}" />
                <ItemsControl x:Name="ParameterList" Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vmGraph:NodeParameterEditorViewModel">
                            <viewsControls:ParameterEditorHost Margin="0,0,0,2" WrapVectorComponents="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Thumb Grid.RowSpan="2" Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,-11,0" Width="8"
                       Cursor="SizeWestEast" DragDelta="OnParameterDividerDrag" ZIndex="10"
                       ToolTip.Tip="{DynamicResource Text.Panels.InspectorResize}"
                       AutomationProperties.Name="{DynamicResource Text.Panels.InspectorResize}">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Border Background="Transparent">
                                <Border Background="{DynamicResource EffectBorderBrush}" Width="2" HorizontalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                <Button Classes="editor-action" Content="{DynamicResource Text.Panels.PublishGroupCurves}"
                        IsVisible="{Binding CanPublishCurves}"
                        Command="{Binding PublishCurvesCommand}"
                        ToolTip.Tip="{DynamicResource Text.Panels.PublishGroupCurvesHelp}" />
                <Button Classes="editor-action" Content="{DynamicResource Text.Panels.EditGroupCurves}"
                        IsVisible="{Binding CanEditVectorCurves}" Click="OnEditGroupCurvesClick" />
                <Button Classes="editor-action" Content="{DynamicResource Text.Panels.EditColorCurves}"
                        IsVisible="{Binding CanEditColorCurves}" Click="OnEditGroupCurvesClick" />
                <Button Classes="editor-action" Content="{DynamicResource Text.Panels.ConfigureGroupItems}"
                        IsVisible="{Binding CanConfigureGroupItems}" Click="OnConfigureGroupItemsClick" />
            </WrapPanel>
            <TextBlock Text="{Binding GroupExposedDiagnostics}" TextWrapping="Wrap"
                       IsVisible="{Binding GroupExposedDiagnostics, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
