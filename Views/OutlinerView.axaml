<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiberaFx.ViewModels"
             x:Class="LiberaFx.Views.OutlinerView"
             x:DataType="vm:OutlinerViewModel">
    <Grid RowDefinitions="Auto,*">
        <TextBox Margin="10" PlaceholderText="Search nodes"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Nodes}"
                 SelectedItem="{Binding Graph.SelectedNode, Mode=OneWay}"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:GraphNodeViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,2">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding PortType}"
                                   Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
