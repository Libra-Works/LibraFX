<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsControls="using:LiberaFx.Views.Controls"
             xmlns:viewsGraph="using:LiberaFx.Views.Graph"
             xmlns:vmAssets="using:LiberaFx.ViewModels.Assets"
             x:Class="LiberaFx.Views.Assets.ProjectResourcesView"
             x:DataType="vmAssets:ProjectResourcesViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <ComboBox SelectedIndex="{Binding SourceIndex}" MinWidth="180">
                <ComboBoxItem Content="{DynamicResource Text.Resources.Groups}" />
                <ComboBoxItem Content="{DynamicResource Text.Resources.Local}" />
            </ComboBox>
            <TextBox Grid.Column="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{DynamicResource Text.Asset.SearchHint}"
                     AutomationProperties.Name="{DynamicResource Text.Asset.Search}" />
            <viewsControls:IconButton Grid.Column="2" Classes="editor-tool" Icon="Refresh" Command="{Binding RefreshCommand}"
                              ToolTip.Tip="{DynamicResource Text.Editor.Refresh}"
                              AutomationProperties.Name="{DynamicResource Text.Editor.Refresh}" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsLocal}">
            <TextBox Text="{Binding Folder}" AutomationProperties.Name="{DynamicResource Text.Library.ChooseFolder}" />
            <viewsControls:IconButton Grid.Column="1" Classes="editor-tool" Icon="Open" Click="OnChooseFolder"
                              ToolTip.Tip="{DynamicResource Text.Library.ChooseFolder}"
                              AutomationProperties.Name="{DynamicResource Text.Library.ChooseFolder}" />
            <CheckBox Grid.Column="2" IsChecked="{Binding Recursive}" Content="{DynamicResource Text.Resources.Recursive}" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="12">
            <ListBox x:Name="ResourceList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="BorderBrush" Value="{DynamicResource EffectBorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vmAssets:WorkspaceResourceEntry">
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding KindLabel}" />
                            <TextBlock Text="{Binding Origin}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" IsVisible="{Binding PreviewOnly}" TextWrapping="Wrap"
                           Text="{DynamicResource Text.Resources.PreviewOnly}" />
                <Grid Grid.Row="2">
                    <Image x:Name="LocalThumbnail" Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="450" />
                    <Border IsVisible="{Binding HasGraphPreview}">
                        <viewsGraph:GraphEditorView x:Name="ResourceGraphPreview" DataContext="{Binding PreviewGraph}"
                                               IsEnabled="False" IsHitTestVisible="False" />
                    </Border>
                </Grid>
                <WrapPanel Grid.Row="3" ItemSpacing="6" LineSpacing="4">
                    <Button x:Name="UseResourceButton" Command="{Binding UseCommand}" Content="{Binding UseLabel}" />
                    <Button x:Name="ResourceVersionControlButton" Click="OnVersionControl"
                            Content="{DynamicResource Text.Vcs.ResourceAction}" IsVisible="{Binding CanShowVersionControl}" />
                </WrapPanel>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap"
                   Foreground="{DynamicResource EffectMutedForegroundBrush}" />
    </Grid>
</UserControl>
