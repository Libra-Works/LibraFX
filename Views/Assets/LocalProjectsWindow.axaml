<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:servicesAssets="using:LiberaFx.Services.Assets"
             xmlns:viewsControls="using:LiberaFx.Views.Controls"
        xmlns:services="clr-namespace:LiberaFx.Services"
        x:Class="LiberaFx.Views.Assets.LocalProjectsWindow"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
      <TextBlock x:Name="Folder" Classes="editor-label" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Border Grid.Column="1" Classes="editor-toolbar-group" Padding="4,2">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <viewsControls:IconButton Classes="editor-tool" Icon="Open" Click="OnChooseFolder"
                            ToolTip.Tip="{DynamicResource Text.Library.ChooseFolder}"
                            AutomationProperties.Name="{DynamicResource Text.Library.ChooseFolder}" />
          <viewsControls:IconButton Classes="editor-tool" Icon="Refresh" Click="OnRefresh"
                            ToolTip.Tip="{DynamicResource Text.Library.Refresh}"
                            AutomationProperties.Name="{DynamicResource Text.Library.Refresh}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="Transparent" Padding="4" VerticalAlignment="Center"
              ToolTip.Tip="{DynamicResource Text.Library.Hint}">
        <viewsControls:EditorIconView Icon="Info" />
      </Border>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="Query" PlaceholderText="{DynamicResource Text.Library.Search}" TextChanged="OnQueryChanged" />
      <CheckBox x:Name="Recursive" Grid.Column="1" IsChecked="True"
                Content="{DynamicResource Text.Library.Subfolders}" IsCheckedChanged="OnRecursiveChanged" />
    </Grid>
    <ListBox x:Name="Projects" Grid.Row="2" DoubleTapped="OnOpenProject">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="servicesAssets:LocalProjectAsset">
          <StackPanel Margin="6,4" Spacing="2">
            <TextBlock Classes="editor-heading" Text="{Binding Name}" />
            <TextBlock Classes="editor-label" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="editor-label" Text="{Binding Modified}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock x:Name="Status" Classes="editor-label" TextWrapping="Wrap" VerticalAlignment="Center" />
      <viewsControls:IconButton Grid.Column="1" Classes="editor-tool transport-primary" Icon="Open" Click="OnOpenProject"
                        ToolTip.Tip="{DynamicResource Text.Library.Open}"
                        AutomationProperties.Name="{DynamicResource Text.Library.Open}" />
    </Grid>
  </Grid>
</UserControl>
