<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:servicesAssets="using:LiberaFx.Services.Assets"
             xmlns:servicesSprite="using:LiberaFx.Services.Sprite"
             xmlns:viewsControls="using:LiberaFx.Views.Controls"
             xmlns:viewsSprite="using:LiberaFx.Views.Sprite"
             xmlns:vmPanels="using:LiberaFx.ViewModels.Panels"
        x:Class="LiberaFx.Views.Sprite.SpriteEditorView" x:DataType="vmPanels:SpriteEditorViewModel"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
    <ScrollViewer x:Name="EditorSurface" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Border Padding="12" MinWidth="640" MinHeight="520"
            Width="{Binding #EditorSurface.Viewport.Width}" Height="{Binding #EditorSurface.Viewport.Height}">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
            <ToggleButton x:Name="ToggleAssetsButton" Classes="editor-action" IsChecked="False"
                          Content="{DynamicResource Text.Sprite.ToggleAssets}"/>
            <Button Classes="editor-action" Content="{DynamicResource Text.Sprite.OpenLocalShort}" Click="OnOpenLocal"
                    ToolTip.Tip="{DynamicResource Text.Sprite.OpenLocal}"/>
            <TextBlock Classes="editor-label" Text="{DynamicResource Text.Asset.Peer}" VerticalAlignment="Center"
                       IsVisible="{Binding #ToggleAssetsButton.IsChecked}"/>
            <ComboBox Width="180" ItemsSource="{Binding Catalog.Peers}" SelectedItem="{Binding Catalog.SelectedPeer}"
                      IsVisible="{Binding #ToggleAssetsButton.IsChecked}"/>
            <TextBox Width="180" PlaceholderText="{DynamicResource Text.Asset.SearchHint}" Text="{Binding Catalog.Query}"
                     IsVisible="{Binding #ToggleAssetsButton.IsChecked}"/>
            <viewsControls:IconButton Classes="editor-tool transport-primary" Icon="Refresh" Command="{Binding Catalog.SearchCommand}"
                              IsVisible="{Binding #ToggleAssetsButton.IsChecked}"
                              ToolTip.Tip="{DynamicResource Text.Asset.Search}"
                              AutomationProperties.Name="{DynamicResource Text.Asset.Search}"/>
            <TextBlock Classes="editor-label" Text="{DynamicResource Text.Sprite.TextureDimensions}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Classes="editor-heading" Text="{Binding TextureDimensions}" VerticalAlignment="Center"/>
        </WrapPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,320" ColumnSpacing="12">
            <Grid x:Name="AssetBrowserPanel" Width="230" RowDefinitions="*,Auto"
                  IsVisible="{Binding #ToggleAssetsButton.IsChecked}">
                <ListBox ItemsSource="{Binding Catalog.Assets}" SelectedItem="{Binding Catalog.SelectedAsset}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="servicesAssets:EngineAsset">
                            <StackPanel Margin="4">
                                <TextBlock Classes="editor-heading" Text="{Binding Name}"/>
                                <TextBlock Classes="editor-label" Text="{Binding Path}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <viewsControls:IconButton Classes="editor-tool" Icon="Previous" Command="{Binding Catalog.PreviousCommand}"
                                      ToolTip.Tip="{DynamicResource Text.Asset.Previous}"
                                      AutomationProperties.Name="{DynamicResource Text.Asset.Previous}"/>
                    <viewsControls:IconButton Classes="editor-tool" Icon="Next" Command="{Binding Catalog.NextCommand}"
                                      ToolTip.Tip="{DynamicResource Text.Asset.Next}"
                                      AutomationProperties.Name="{DynamicResource Text.Asset.Next}"/>
                    <TextBlock Classes="editor-label" Text="{Binding Catalog.Total}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                    <CheckBox Content="{DynamicResource Text.Sprite.GridSnap}" IsChecked="{Binding SnapToGrid}" Margin="0,0,6,0"/>
                    <TextBlock Classes="editor-label" Text="{DynamicResource Text.Sprite.GridSize}"/>
                    <TextBox Width="60" Text="{Binding GridWidth, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip.Tip="{DynamicResource Text.Sprite.GridWidth}"/>
                    <TextBlock Classes="editor-label" Text="×"/>
                    <TextBox Width="60" Text="{Binding GridHeight, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip.Tip="{DynamicResource Text.Sprite.GridHeight}"/>
                    <Button Classes="editor-action" Content="{DynamicResource Text.Sprite.AutoFlipbook}" Click="OnAutoFlipbook"/>
                </WrapPanel>
                <TabControl x:Name="AuthoringTabs" Grid.Row="1" MinHeight="170" SelectionChanged="OnAuthoringTabChanged">
                    <TabItem Header="{DynamicResource Text.Sprite.CutCells}">
                        <viewsSprite:SpriteAtlasPreview x:Name="Atlas" MinHeight="140"/>
                    </TabItem>
                    <TabItem Header="{DynamicResource Text.Sprite.ComposeParts}">
                        <viewsSprite:SpriteCompositionPreview x:Name="CompositionPreview" MinHeight="140"
                                                        ToolTip.Tip="{DynamicResource Text.Sprite.CompositionHelp}"/>
                    </TabItem>
                </TabControl>
                <WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                    <Border Classes="editor-toolbar-group" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <viewsControls:IconButton Classes="editor-tool" Icon="Open" Click="OnOpenLocal"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.OpenLocal}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.OpenLocal}"/>
                            <viewsControls:IconButton Classes="editor-tool" Icon="Link" Click="OnUseEnginePreview"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.UseEnginePreview}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.UseEnginePreview}"/>
                            <Border Classes="editor-toolbar-divider"/>
                            <viewsControls:IconButton Classes="editor-tool" Icon="Add" Click="OnAddCell"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.AddCell}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.AddCell}"/>
                            <viewsControls:IconButton Classes="editor-tool" Icon="Reset" Click="OnResetZoom"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.ZoomReset}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.ZoomReset}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="Transparent" Padding="4" VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource Text.Sprite.CanvasHelp}">
                        <viewsControls:EditorIconView Icon="Info"/>
                    </Border>
                </WrapPanel>
                <TextBlock Grid.Row="3" Classes="editor-label" Text="{Binding SelectedCellInfo}" TextWrapping="Wrap"/>
            </Grid>

            <Grid Grid.Column="2" RowDefinitions="*,Auto" RowSpacing="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Margin="0,0,4,0">
                    <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Sprite.FramePreview}"/>
                    <viewsSprite:SpriteAtlasPreview x:Name="FramePreview" Height="104" IsFramePreview="True"/>
                    <Expander x:Name="PartProperties" Header="{DynamicResource Text.Sprite.PartProperties}" HorizontalAlignment="Stretch" IsVisible="False">
                    <StackPanel Spacing="6">
                    <TextBox Text="{Binding SelectedPart.Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="{DynamicResource Text.Sprite.PartVisible}" IsChecked="{Binding SelectedPart.Visible}"/>
                    <Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Sprite.KeyTime}"/>
                        <TextBox Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding KeyTime, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Classes="editor-label" Text="{DynamicResource Text.Sprite.PartPosition}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" PlaceholderText="X" Text="{Binding PositionX}"/>
                        <TextBox Grid.Row="1" Grid.Column="2" PlaceholderText="Y" Text="{Binding PositionY}"/>
                        <TextBlock Grid.Row="2" Classes="editor-label" Text="{DynamicResource Text.Sprite.PartRotation}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Rotation}"/>
                        <TextBlock Grid.Row="3" Classes="editor-label" Text="{DynamicResource Text.Sprite.PartScale}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" PlaceholderText="X" Text="{Binding ScaleX}"/>
                        <TextBox Grid.Row="3" Grid.Column="2" PlaceholderText="Y" Text="{Binding ScaleY}"/>
                    </Grid>
                    <Border Classes="editor-toolbar-group" Padding="4,2" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <viewsControls:IconButton Classes="editor-tool" Icon="Add" Click="OnSetKey"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.SetKey}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.SetKey}"/>
                            <viewsControls:IconButton Classes="editor-tool" Icon="Delete" Click="OnDeleteKey"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.DeleteKey}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.DeleteKey}"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    </Expander>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Sprite.Cells}" VerticalAlignment="Center"/>
                        <viewsControls:IconButton Grid.Column="1" Classes="editor-tool" Icon="Delete" Click="OnDeleteCell"
                                          ToolTip.Tip="{DynamicResource Text.Sprite.DeleteCell}"
                                          AutomationProperties.Name="{DynamicResource Text.Sprite.DeleteCell}"/>
                        <Border Grid.Column="2" Background="Transparent" Padding="4" VerticalAlignment="Center"
                                ToolTip.Tip="{DynamicResource Text.Sprite.DrawHint}">
                            <viewsControls:EditorIconView Icon="Info"/>
                        </Border>
                    </Grid>
                    <ListBox x:Name="SpriteCells" ItemsSource="{Binding Cells}" SelectedItem="{Binding SelectedCell}"
                             Height="160" DoubleTapped="OnCellDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="servicesSprite:SpriteAnimationCell">
                                <Grid ColumnDefinitions="56,*" ColumnSpacing="8" Margin="2">
                                    <viewsSprite:SpriteCellThumbnail Width="52" Height="40"
                                        Bitmap="{ReflectionBinding DataContext.TextureBitmap, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Cells="{ReflectionBinding DataContext.Cells, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CellId="{Binding Id}"
                                        TextureWidth="{ReflectionBinding DataContext.TexturePixelWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        TextureHeight="{ReflectionBinding DataContext.TexturePixelHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="editor-heading" Text="{Binding Name}"/>
                                        <TextBlock Classes="editor-label">
                                            <Run Text="{Binding X}"/><Run Text=", "/><Run Text="{Binding Y}"/>
                                            <Run Text=" · "/><Run Text="{Binding Width}"/><Run Text=" × "/><Run Text="{Binding Height}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5">
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Sprite.CellName}"/>
                        <TextBox Grid.Column="1" Text="{Binding CellName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Classes="editor-label" Text="{DynamicResource Text.Sprite.CellPosition}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBox Width="65" PlaceholderText="X" Text="{Binding CellX, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Width="65" PlaceholderText="Y" Text="{Binding CellY, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Classes="editor-label" Text="{DynamicResource Text.Sprite.CellSize}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBox Width="65" PlaceholderText="W" Text="{Binding CellWidth, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Width="65" PlaceholderText="H" Text="{Binding CellHeight, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Separator/>
                    <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Sprite.FrameProperties}"/>
                    <TextBlock Classes="editor-label" Text="{Binding SelectedFrameInfo}" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5">
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Sprite.Fps}"/>
                        <TextBox Grid.Column="1" Text="{Binding SequenceFps, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Classes="editor-label" Text="{DynamicResource Text.Sprite.DurationMs}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DurationMilliseconds, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Classes="editor-label" Text="{DynamicResource Text.Sprite.PlaybackRange}" IsVisible="{Binding !IsComposition}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsComposition}">
                            <TextBox Width="65" PlaceholderText="{DynamicResource Text.Sprite.RangeStart}" Text="{Binding RangeStart, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Width="65" PlaceholderText="{DynamicResource Text.Sprite.RangeEnd}" Text="{Binding RangeEnd, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
                            <CheckBox Content="{DynamicResource Text.Sprite.Loop}" IsChecked="{Binding Loop}"/>
                            <CheckBox Content="{DynamicResource Text.Sprite.Playing}" IsChecked="{Binding Playing}"/>
                        </StackPanel>
                    </Grid>

                    <Expander Header="{DynamicResource Text.Sprite.LegacyGrid}" HorizontalAlignment="Stretch"
                              IsVisible="{Binding !IsComposition}" IsExpanded="False"
                              ToolTip.Tip="{DynamicResource Text.Sprite.FrameBindingNotice}">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5" Margin="0,6,0,0">
                            <TextBlock Classes="editor-label" Text="{DynamicResource Text.Asset.Columns}"/>
                            <TextBox Grid.Column="1" Text="{Binding Catalog.Columns, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Classes="editor-label" Text="{DynamicResource Text.Asset.Rows}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Catalog.Rows, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Classes="editor-label" Text="{DynamicResource Text.Asset.Fps}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Catalog.Fps, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="3" Classes="editor-label" Text="{DynamicResource Text.Sprite.Frame}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Frame, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Expander>
                    <TextBlock Classes="editor-label" Text="{Binding PreviewSource}" TextWrapping="Wrap"/>
                    <TextBlock Classes="editor-label" Text="{Binding CatalogStatus}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock Classes="editor-label" Text="{Binding Status}" TextWrapping="Wrap"/>
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                    <Button Classes="editor-action" Content="{DynamicResource Text.Sprite.LoadSelected}" Click="OnLoadSelected"
                            ToolTip.Tip="{DynamicResource Text.Sprite.MaterialNotice}"/>
                    <viewsControls:IconButton Classes="editor-tool" Icon="Save" Command="{Binding Catalog.SaveMetadataCommand}"
                                      ToolTip.Tip="{DynamicResource Text.Asset.SaveMetadata}"
                                      AutomationProperties.Name="{DynamicResource Text.Asset.SaveMetadata}"/>
                    <Button Classes="editor-action" Content="{DynamicResource Text.Sprite.ApplySelected}" Click="OnApplySelected"
                            IsEnabled="{Binding CanApply}"/>
                    <Button Classes="editor-action" Content="{DynamicResource Text.Sprite.Create}" Click="OnCreate"
                            IsEnabled="{Binding CanApply}"/>
                </WrapPanel>
            </StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Classes="editor-card" Padding="8,6">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="4">
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                    <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Sprite.Timeline}" VerticalAlignment="Center"/>
                    <StackPanel x:Name="PartTimelineControls" Orientation="Horizontal" Spacing="6" IsVisible="False">
                    <ComboBox Width="180" ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vmPanels:SpritePartViewModel"><TextBlock Text="{Binding Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border Classes="editor-toolbar-group" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <viewsControls:IconButton Classes="editor-tool" Icon="Add" Click="OnAddPart"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.AddPart}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.AddPart}"/>
                            <viewsControls:IconButton Classes="editor-tool" Icon="Remove" Click="OnRemovePart"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.RemovePart}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.RemovePart}"/>
                            <Border Classes="editor-toolbar-divider"/>
                            <viewsControls:IconButton Classes="editor-tool" Icon="Previous" Click="OnPartBackward"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.PartBackward}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.PartBackward}"/>
                            <viewsControls:IconButton Classes="editor-tool" Icon="Next" Click="OnPartForward"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.PartForward}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.PartForward}"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    <Border Background="Transparent" Padding="4" VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource Text.Sprite.TimelineHelp}">
                        <viewsControls:EditorIconView Icon="Info"/>
                    </Border>
                </WrapPanel>
                <ScrollViewer Grid.Row="1" MaxHeight="180" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <viewsSprite:SpriteTimeline x:Name="Timeline"/>
                </ScrollViewer>
                <WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                    <Border Classes="editor-toolbar-group" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <viewsControls:IconButton Classes="editor-tool" Icon="StepBack" Click="OnPreviousFrame"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.PreviousFrame}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.PreviousFrame}"/>
                            <viewsControls:IconButton Classes="editor-tool transport-primary" Icon="Play" Click="OnTogglePlayback"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.PlayStop}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.PlayStop}"/>
                            <viewsControls:IconButton Classes="editor-tool" Icon="StepForward" Click="OnNextFrame"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.NextFrame}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.NextFrame}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="editor-toolbar-group" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <viewsControls:IconButton Classes="editor-tool" Icon="Add" Click="OnAddFrame"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.AddToTimeline}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.AddToTimeline}"/>
                            <Button x:Name="InsertFrameButton" Classes="editor-action" Content="{DynamicResource Text.Sprite.InsertFrame}" Click="OnInsertFrame"/>
                            <viewsControls:IconButton Classes="editor-tool" Icon="Copy" Click="OnDuplicateFrame"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.DuplicateFrame}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.DuplicateFrame}"/>
                            <viewsControls:IconButton Classes="editor-tool" Icon="Delete" Click="OnDeleteFrame"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.DeleteFrame}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.DeleteFrame}"/>
                            <Border Classes="editor-toolbar-divider"/>
                            <viewsControls:IconButton Classes="editor-tool" Icon="Previous" Click="OnFrameUp"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.FrameLeft}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.FrameLeft}"/>
                            <viewsControls:IconButton Classes="editor-tool" Icon="Next" Click="OnFrameDown"
                                              ToolTip.Tip="{DynamicResource Text.Sprite.FrameRight}"
                                              AutomationProperties.Name="{DynamicResource Text.Sprite.FrameRight}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
    </ScrollViewer>
</UserControl>
