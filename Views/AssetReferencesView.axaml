<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiberaFx.ViewModels"
             xmlns:views="using:LiberaFx.Views"
             x:Class="LiberaFx.Views.AssetReferencesView"
             x:DataType="vm:AssetReferencesViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8" Margin="12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <ComboBox x:Name="ReferenceMode" SelectedIndex="{Binding Mode}" MinWidth="230"
                      AutomationProperties.Name="{DynamicResource Text.References.View}">
                <ComboBoxItem Content="{DynamicResource Text.References.Active}" />
                <ComboBoxItem Content="{DynamicResource Text.References.Index}" />
            </ComboBox>
            <TextBox Grid.Column="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{DynamicResource Text.Asset.SearchHint}"
                     AutomationProperties.Name="{DynamicResource Text.Asset.Search}" />
            <Button Grid.Column="2" Command="{Binding RefreshCommand}" Content="{DynamicResource Text.Editor.Refresh}" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
            <TextBox Text="{Binding Folder}" PlaceholderText="{DynamicResource Text.References.ChooseFolder}"
                     AutomationProperties.Name="{DynamicResource Text.References.ChooseFolder}" />
            <Button Grid.Column="1" Click="OnChooseFolder" Content="{DynamicResource Text.Library.ChooseFolder}" />
            <Button Grid.Column="2" Command="{Binding AddFolderCommand}" Content="{DynamicResource Text.References.AddFolder}" />
            <Button Grid.Column="3" Command="{Binding ClearFoldersCommand}" Content="{DynamicResource Text.References.ClearFolders}" />
        </Grid>
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text="{Binding Coverage}" TextWrapping="Wrap"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            <Expander Header="{DynamicResource Text.References.RegisteredFolders}" IsVisible="{Binding HasFolders}">
                <ScrollViewer MaxHeight="90">
                    <TextBlock Text="{Binding RegisteredFolders}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Expander>
            <Expander Header="{DynamicResource Text.References.PartialErrors}" IsVisible="{Binding HasDiagnostics}">
                <ScrollViewer MaxHeight="110">
                    <TextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Expander>
        </StackPanel>
        <Grid Grid.Row="3" ColumnDefinitions="2*,3*" ColumnSpacing="12">
            <Grid>
                <ListBox x:Name="UsedAssetList" ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssetReferenceRow">
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" Margin="12" />
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150"
                         AutomationProperties.Name="{DynamicResource Text.References.Details}" />
                <TabControl Grid.Row="1">
                    <TabItem Header="{DynamicResource Text.References.Incoming}">
                        <Grid RowDefinitions="*,Auto" RowSpacing="6">
                            <ListBox x:Name="ReferenceLocations" ItemsSource="{Binding Incoming}" SelectedItem="{Binding SelectedLocation}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AssetReferenceLocation">
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="4" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="1" x:Name="GoToAssetUseButton" Command="{Binding GoToCommand}"
                                    Content="{DynamicResource Text.References.GoTo}" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource Text.References.Outgoing}">
                        <Grid RowDefinitions="*,Auto" RowSpacing="6">
                            <ListBox ItemsSource="{Binding Outgoing}" SelectedItem="{Binding SelectedOutgoing}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AssetReferenceLocation">
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Use.Target.Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="1" Command="{Binding FollowOutgoingCommand}"
                                    Content="{DynamicResource Text.References.Follow}" />
                        </Grid>
                    </TabItem>
                </TabControl>
                <Border Grid.Row="2" IsVisible="{Binding HasPreview}" Height="210">
                    <views:GraphEditorView x:Name="ReferenceGraphPreview" DataContext="{Binding PreviewGraph}"
                                           IsEnabled="False" IsHitTestVisible="False" />
                </Border>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
