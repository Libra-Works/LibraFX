<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiberaFx.Views.ColorEditorWindow"
        Title="Choose color" Width="480" Height="680" MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
    <Grid RowDefinitions="*,Auto" Margin="12">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <ColorView x:Name="Picker" ColorModel="Hsva" IsColorModelVisible="True" IsColorPreviewVisible="True"
                           IsAlphaEnabled="True" IsAlphaVisible="True" />
                <TextBlock Text="Linear RGBA (RGB supports values above 1)" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                    <StackPanel><TextBlock Text="R" /><TextBox x:Name="RedBox" LostFocus="OnComponentsEdited" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="G" /><TextBox x:Name="GreenBox" LostFocus="OnComponentsEdited" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="B" /><TextBox x:Name="BlueBox" LostFocus="OnComponentsEdited" /></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="A" /><TextBox x:Name="AlphaBox" LostFocus="OnComponentsEdited" /></StackPanel>
                </Grid>
                <TextBlock x:Name="ComponentStatus" Foreground="OrangeRed" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Favorites" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Content="Add current" Click="OnAddFavorite" />
                </StackPanel>
                <WrapPanel x:Name="FavoritesPanel" />
                <TextBlock Text="Recent" FontWeight="SemiBold" />
                <WrapPanel x:Name="RecentPanel" />
                <TextBlock x:Name="PaletteStatus" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="OK" Click="OnAccept" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
