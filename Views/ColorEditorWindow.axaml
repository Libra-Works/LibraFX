<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiberaFx.Views.ColorEditorWindow"
        Title="Choose color" Width="450" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
    <Grid RowDefinitions="*,Auto" Margin="12">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ColorView x:Name="Picker" IsAlphaEnabled="True" IsAlphaVisible="True" />
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="OK" Click="OnAccept" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
