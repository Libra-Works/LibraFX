<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LiberaFx.Views"
        x:Class="LiberaFx.Views.ColorEditorWindow"
        Title="{DynamicResource Text.Panels.ColorEditorTitle}" Width="760" Height="600" MinWidth="670" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Padding="20,14"
                Background="{DynamicResource EffectSurfaceBrush}"
                BorderBrush="{DynamicResource EffectBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Text="{DynamicResource Text.Panels.ColorHeading}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Text.Panels.ColorEditorSubtitle}"
                               Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Width="62" Height="36" CornerRadius="3"
                        BorderBrush="{DynamicResource EffectBorderBrush}" BorderThickness="1"
                        ClipToBounds="True">
                    <views:ColorSwatch x:Name="CurrentSwatch" />
                </Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20" ColumnDefinitions="350,*" ColumnSpacing="20">
                <Border Background="{DynamicResource EffectSurfaceBrush}" CornerRadius="6"
                        BorderBrush="{DynamicResource EffectBorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <ColorView x:Name="Picker" ColorModel="Hsva" ColorSpectrumComponents="SaturationValue" IsColorModelVisible="True"
                               IsColorPaletteVisible="False" IsAccentColorsVisible="False"
                               IsColorPreviewVisible="False"
                               IsAlphaEnabled="True" IsAlphaVisible="True" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{DynamicResource Text.Panels.RgbaHeading}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Text.Panels.ColorRangeHelp}"
                                   Foreground="{DynamicResource EffectMutedForegroundBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <StackPanel Spacing="3"><TextBlock Text="R" /><TextBox x:Name="RedBox" LostFocus="OnComponentsEdited" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="G" /><TextBox x:Name="GreenBox" LostFocus="OnComponentsEdited" /></StackPanel>
                        <StackPanel Grid.Row="1" Spacing="3"><TextBlock Text="B" /><TextBox x:Name="BlueBox" LostFocus="OnComponentsEdited" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3"><TextBlock Text="A" /><TextBox x:Name="AlphaBox" LostFocus="OnComponentsEdited" /></StackPanel>
                    </Grid>
                    <TextBlock x:Name="ComponentStatus" Foreground="OrangeRed" TextWrapping="Wrap" />
                    <Border Background="{DynamicResource EffectBorderBrush}" Height="1" Margin="0,2" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Text.Panels.ColorFavorites}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                        <views:IconButton Grid.Column="1" Icon="Add"
                                          ToolTip.Tip="{DynamicResource Text.Panels.AddCurrentFavorite}"
                                          AutomationProperties.Name="{DynamicResource Text.Panels.AddCurrentFavorite}"
                                          Click="OnAddFavorite" Padding="8,4" />
                    </Grid>
                    <WrapPanel x:Name="FavoritesPanel" MinHeight="30" />
                    <TextBlock Text="{DynamicResource Text.Panels.ColorRecent}" FontWeight="SemiBold"
                               Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                    <WrapPanel x:Name="RecentPanel" MinHeight="30" />
                    <TextBlock x:Name="PaletteStatus" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="20,12"
                Background="{DynamicResource EffectSurfaceBrush}"
                BorderBrush="{DynamicResource EffectBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Click="OnCancel" MinWidth="80"
                        AutomationProperties.Name="{DynamicResource Text.Panels.Cancel}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <views:EditorIconView Icon="Close" />
                        <TextBlock Text="{DynamicResource Text.Panels.Cancel}" />
                    </StackPanel>
                </Button>
                <Button Click="OnAccept" IsDefault="True" MinWidth="80"
                        AutomationProperties.Name="{DynamicResource Text.Panels.Ok}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <views:EditorIconView Icon="Check" />
                        <TextBlock Text="{DynamicResource Text.Panels.Ok}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
