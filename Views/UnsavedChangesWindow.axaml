<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LiberaFx.Views"
        x:Class="LiberaFx.Views.UnsavedChangesWindow"
        Title="{DynamicResource Text.Panels.UnsavedChangesTitle}"
        Width="420"
        Height="190"
        MinWidth="420"
        MinHeight="190"
        MaxWidth="420"
        MaxHeight="190"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
    <Grid RowDefinitions="*,Auto" Margin="20">
        <TextBlock Text="{DynamicResource Text.Panels.UnsavedChangesPrompt}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button MinWidth="80" Click="OnCancelClick"
                    AutomationProperties.Name="{DynamicResource Text.Panels.Cancel}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <views:EditorIconView Icon="Close" />
                    <TextBlock Text="{DynamicResource Text.Panels.Cancel}" />
                </StackPanel>
            </Button>
            <Button MinWidth="80" Click="OnDiscardClick"
                    AutomationProperties.Name="{DynamicResource Text.Panels.Discard}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <views:EditorIconView Icon="Delete" />
                    <TextBlock Text="{DynamicResource Text.Panels.Discard}" />
                </StackPanel>
            </Button>
            <Button MinWidth="90" IsDefault="True" Click="OnSaveClick"
                    AutomationProperties.Name="{DynamicResource Text.Panels.SaveAll}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <views:EditorIconView Icon="Save" />
                    <TextBlock Text="{DynamicResource Text.Panels.SaveAll}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
