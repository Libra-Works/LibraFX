<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiberaFx.ViewModels"
             xmlns:views="using:LiberaFx.Views"
             x:Class="LiberaFx.Views.GraphEditorView"
             Focusable="True"
             KeyDown="OnGraphKeyDown"
             x:DataType="vm:GraphWorkspaceViewModel">
    <UserControl.Resources>
        <views:GraphPositionConverter x:Key="GraphPositionConverter" />
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Classes="editor-bar" BorderThickness="0,0,0,1"
                IsVisible="{Binding !IsInlineWorkspace}">
            <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:GraphBreadcrumb">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="›" IsVisible="{Binding HasSeparator}"
                                       FontSize="18" VerticalAlignment="Center"
                                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                            <Button Classes="editor-tool" Tag="{Binding Depth}" AutomationProperties.Name="{Binding Name}"
                                    Click="OnBreadcrumbClick" Padding="8,2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <views:EditorIconView Icon="Group" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <Border x:Name="GraphToolbar" Grid.Row="2" Classes="editor-bar" BorderThickness="0,1,0,0">
            <StackPanel Spacing="3">
            <TextBlock Text="{DynamicResource Text.Inline.Locked}" IsVisible="{Binding IsReadOnly}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <views:IconButton Classes="editor-tool" Icon="ZoomOut" ToolTip.Tip="{DynamicResource Text.Editor.ZoomOut}"
                        AutomationProperties.Name="{DynamicResource Text.Editor.ZoomOut}" Click="OnZoomOutClick" />
                <Slider x:Name="ZoomSlider" Width="105" Minimum="-4.321928094887363" Maximum="2"
                        Value="0" ValueChanged="OnZoomSliderChanged"
                        VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Text.Editor.GraphZoom}"
                        AutomationProperties.Name="{DynamicResource Text.Editor.GraphZoom}" />
                <Button x:Name="ZoomButton" Classes="editor-tool"
                        ToolTip.Tip="{DynamicResource Text.Editor.ResetZoom}"
                        AutomationProperties.Name="{DynamicResource Text.Editor.ResetZoom}"
                        Click="OnResetZoomClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <views:EditorIconView Icon="Reset" />
                        <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <views:IconButton Classes="editor-tool" Icon="ZoomIn" ToolTip.Tip="{DynamicResource Text.Editor.ZoomIn}"
                        AutomationProperties.Name="{DynamicResource Text.Editor.ZoomIn}" Click="OnZoomInClick" />
                <views:IconButton Classes="editor-tool" Icon="Frame" ToolTip.Tip="{DynamicResource Text.Editor.Frame}"
                        AutomationProperties.Name="{DynamicResource Text.Editor.Frame}" Click="OnFrameSelectionClick"
                        IsEnabled="{Binding HasSelection}" />
                <views:IconButton Classes="editor-tool" Icon="Group" ToolTip.Tip="{DynamicResource Text.Editor.Group}"
                        AutomationProperties.Name="{DynamicResource Text.Editor.Group}" Click="OnGroupSelectionClick"
                        IsEnabled="{Binding HasSelection}" />
                <views:IconButton Classes="editor-tool" Icon="Disconnect" IsEnabled="{Binding HasSelection}"
                                  ToolTip.Tip="{DynamicResource Text.Inline.Disconnect}"
                                  AutomationProperties.Name="{DynamicResource Text.Inline.Disconnect}">
                    <Button.Flyout>
                        <Flyout>
                            <ItemsControl ItemsSource="{Binding SelectedConnections}" MaxWidth="380">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:GraphConnectionViewModel">
                                        <Button Content="{Binding Description}" Tag="{Binding}"
                                                Click="OnDisconnectConnectionClick"
                                                HorizontalAlignment="Stretch" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </views:IconButton>
                <TextBlock Classes="editor-label" Text="{Binding ConnectionStatus}" />
            </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      x:Name="GraphScrollViewer"
                      PointerPressed="OnViewportPointerPressed"
                      PointerMoved="OnViewportPointerMoved"
                      PointerReleased="OnViewportPointerReleased"
                      PointerCaptureLost="OnViewportPointerCaptureLost"
                      ScrollChanged="OnViewportScrollChanged"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ZoomHost" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid x:Name="GraphCanvas"
                  IsEnabled="{Binding !IsReadOnly}"
                  Width="1600"
                  Height="1000"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  RenderTransformOrigin="0%,0%"
                  PointerPressed="OnGraphCanvasPointerPressed"
                  DragDrop.AllowDrop="True"
                  DragDrop.DragOver="OnGraphCanvasDragOver"
                  DragDrop.Drop="OnGraphCanvasDrop">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource Text.Editor.AddNode}" Click="OnAddNodeClick">
                            <MenuItem.Icon><views:EditorIconView Icon="Add" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Text.Editor.AddComment}" Click="OnAddCommentClick">
                            <MenuItem.Icon><views:EditorIconView Icon="Info" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="NewSpawnableGroupMenu" Header="{DynamicResource Text.Editor.NewSpawnableGroup}" Click="OnAddSpawnableGroupClick">
                            <MenuItem.Icon><views:EditorIconView Icon="Add" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Text.Editor.Copy}" IsEnabled="{Binding HasSelection}" Click="OnCopyClick">
                            <MenuItem.Icon><views:EditorIconView Icon="Copy" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Text.Editor.Cut}" IsEnabled="{Binding HasSelection}" Click="OnCutClick">
                            <MenuItem.Icon><views:EditorIconView Icon="Cut" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Text.Editor.Paste}" Click="OnPasteClick">
                            <MenuItem.Icon><views:EditorIconView Icon="Paste" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Border x:Name="GraphBackground"
                        Background="{DynamicResource EffectWindowBackgroundBrush}"
                        PointerPressed="OnBackgroundPointerPressed"
                        PointerMoved="OnBackgroundPointerMoved"
                        PointerReleased="OnBackgroundPointerReleased"
                        PointerCaptureLost="OnBackgroundPointerCaptureLost" />

                <views:GraphSceneLayer x:Name="SceneLayer" DataContext="{Binding}" GridOnly="True" />

                <ItemsControl ItemsSource="{Binding CommentNodes}">
                    <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left">
                                <MultiBinding Converter="{StaticResource GraphPositionConverter}">
                                    <ReflectionBinding Path="DisplayX" />
                                    <ReflectionBinding Path="OriginX"
                                                       RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type views:GraphEditorView}}" />
                                </MultiBinding>
                            </Setter>
                            <Setter Property="Canvas.Top">
                                <MultiBinding Converter="{StaticResource GraphPositionConverter}">
                                    <ReflectionBinding Path="DisplayY" />
                                    <ReflectionBinding Path="OriginY"
                                                       RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type views:GraphEditorView}}" />
                                </MultiBinding>
                            </Setter>
                        </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas Classes="graphNodePanel" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:GraphNodeViewModel"><views:GraphNodeView /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <views:GraphSceneLayer x:Name="ConnectionLayer" DataContext="{Binding}" ConnectionsOnly="True" />
                <ItemsControl x:Name="NodeItems" ItemsSource="{Binding ForegroundNodes}">
                    <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left">
                                <MultiBinding Converter="{StaticResource GraphPositionConverter}">
                                    <ReflectionBinding Path="DisplayX" />
                                    <ReflectionBinding Path="OriginX"
                                                       RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type views:GraphEditorView}}" />
                                </MultiBinding>
                            </Setter>
                            <Setter Property="Canvas.Top">
                                <MultiBinding Converter="{StaticResource GraphPositionConverter}">
                                    <ReflectionBinding Path="DisplayY" />
                                    <ReflectionBinding Path="OriginY"
                                                       RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type views:GraphEditorView}}" />
                                </MultiBinding>
                            </Setter>
                        </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Classes="graphNodePanel" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:GraphNodeViewModel">
                            <views:GraphNodeView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="SelectionBox" IsVisible="False"
                            Background="{DynamicResource EffectSelectionFillBrush}"
                            BorderBrush="{DynamicResource EffectSelectionBorderBrush}" BorderThickness="1" />
                </Canvas>
            </Grid>
            </Grid>
        </ScrollViewer>
        <Popup x:Name="NodeSearchPopup" Grid.Row="2" PlacementTarget="{Binding #GraphScrollViewer}"
               Placement="Center" IsLightDismissEnabled="True">
            <Border Width="340" MaxHeight="400" Padding="8" BorderThickness="1"
                    BorderBrush="{DynamicResource EffectBorderBrush}"
                    Background="{DynamicResource EffectSurfaceBrush}">
                <Grid RowDefinitions="Auto,*">
                    <TextBox x:Name="NodeSearchBox" PlaceholderText="{DynamicResource Text.Editor.SearchNodeTypes}"
                             TextChanged="OnNodeSearchTextChanged" KeyDown="OnNodeSearchKeyDown" />
                    <ListBox x:Name="NodeSearchResults" Grid.Row="1" Margin="0,6,0,0"
                             MaxHeight="320" DoubleTapped="OnNodeSearchDoubleTapped"
                             KeyDown="OnNodeSearchKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:NodeCatalogEntryViewModel">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Group}" FontSize="11"
                                               Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
