<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiberaFx.ViewModels"
             xmlns:views="using:LiberaFx.Views"
             x:Class="LiberaFx.Views.GraphEditorView"
             Focusable="True"
             KeyDown="OnGraphKeyDown"
             x:DataType="vm:GraphWorkspaceViewModel">
    <UserControl.Resources>
        <views:GraphPositionConverter x:Key="GraphPositionConverter" />
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Padding="6,3" Background="{DynamicResource EffectSurfaceBrush}"
                BorderBrush="{DynamicResource EffectBorderBrush}" BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:GraphBreadcrumb">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="›" IsVisible="{Binding HasSeparator}"
                                       FontSize="18" VerticalAlignment="Center"
                                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                            <Button Content="{Binding Name}" Tag="{Binding Depth}"
                                    Click="OnBreadcrumbClick" Padding="8,2" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <Border Grid.Row="1"
                Padding="8"
                Background="{DynamicResource EffectSurfaceBrush}"
                BorderBrush="{DynamicResource EffectBorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Delete selected"
                        Command="{Binding DeleteSelectedNodeCommand}"
                        IsEnabled="{Binding HasSelection}" />
                <Button ToolTip.Tip="Zoom out" AutomationProperties.Name="Zoom out"
                        Click="OnZoomOutClick" Padding="7">
                    <Path Width="18" Height="18" Stretch="Uniform"
                          Stroke="{DynamicResource EffectForegroundBrush}" StrokeThickness="1.7"
                          StrokeLineCap="Round"
                          Data="M 13,8 A 5,5 0 1 1 3,8 A 5,5 0 1 1 13,8 M 12,12 L 17,17 M 5.5,8 L 10.5,8" />
                </Button>
                <Slider x:Name="ZoomSlider" Width="105" Minimum="-4.321928094887363" Maximum="2"
                        Value="0" ValueChanged="OnZoomSliderChanged"
                        VerticalAlignment="Center" ToolTip.Tip="Graph zoom"
                        AutomationProperties.Name="Graph zoom" />
                <Button x:Name="ZoomButton" Content="100%"
                        ToolTip.Tip="Reset zoom"
                        Click="OnResetZoomClick" />
                <Button ToolTip.Tip="Zoom in" AutomationProperties.Name="Zoom in"
                        Click="OnZoomInClick" Padding="7">
                    <Path Width="18" Height="18" Stretch="Uniform"
                          Stroke="{DynamicResource EffectForegroundBrush}" StrokeThickness="1.7"
                          StrokeLineCap="Round"
                          Data="M 13,8 A 5,5 0 1 1 3,8 A 5,5 0 1 1 13,8 M 12,12 L 17,17 M 5.5,8 L 10.5,8 M 8,5.5 L 8,10.5" />
                </Button>
                <Button Content="Frame selected" Click="OnFrameSelectionClick"
                        IsEnabled="{Binding HasSelection}" />
                <Button Content="Group" Click="OnGroupSelectionClick"
                        IsEnabled="{Binding HasSelection}" />
                <Button Content="Open group" Click="OnOpenGroupClick"
                        ToolTip.Tip="Open the selected Graph Group" />
                <Button Content="Export VFX..." Click="OnExportVfxClick"
                        ToolTip.Tip="Compile the current graph to VFX bytecode" />
                <TextBlock Text="{Binding ConnectionStatus}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      x:Name="GraphScrollViewer"
                      PointerPressed="OnViewportPointerPressed"
                      PointerMoved="OnViewportPointerMoved"
                      PointerReleased="OnViewportPointerReleased"
                      PointerCaptureLost="OnViewportPointerCaptureLost"
                      ScrollChanged="OnViewportScrollChanged"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ZoomHost" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid x:Name="GraphCanvas"
                  Width="1600"
                  Height="1000"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  RenderTransformOrigin="0%,0%"
                  PointerPressed="OnGraphCanvasPointerPressed"
                  DragDrop.AllowDrop="True"
                  DragDrop.DragOver="OnGraphCanvasDragOver"
                  DragDrop.Drop="OnGraphCanvasDrop">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Add node..." Click="OnAddNodeClick" />
                        <MenuItem Header="Add _comment" Click="OnAddCommentClick" />
                        <Separator />
                        <MenuItem Header="_Copy" IsEnabled="{Binding HasSelection}" Click="OnCopyClick" />
                        <MenuItem Header="Cu_t" IsEnabled="{Binding HasSelection}" Click="OnCutClick" />
                        <MenuItem Header="_Paste" Click="OnPasteClick" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Border x:Name="GraphBackground"
                        Background="{DynamicResource EffectWindowBackgroundBrush}"
                        PointerPressed="OnBackgroundPointerPressed"
                        PointerMoved="OnBackgroundPointerMoved"
                        PointerReleased="OnBackgroundPointerReleased"
                        PointerCaptureLost="OnBackgroundPointerCaptureLost" />

                <views:GraphSceneLayer x:Name="SceneLayer" DataContext="{Binding}" GridOnly="True" />

                <ItemsControl ItemsSource="{Binding CommentNodes}">
                    <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left">
                                <MultiBinding Converter="{StaticResource GraphPositionConverter}">
                                    <ReflectionBinding Path="DisplayX" />
                                    <ReflectionBinding Path="OriginX"
                                                       RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type views:GraphEditorView}}" />
                                </MultiBinding>
                            </Setter>
                            <Setter Property="Canvas.Top">
                                <MultiBinding Converter="{StaticResource GraphPositionConverter}">
                                    <ReflectionBinding Path="DisplayY" />
                                    <ReflectionBinding Path="OriginY"
                                                       RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type views:GraphEditorView}}" />
                                </MultiBinding>
                            </Setter>
                        </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas Classes="graphNodePanel" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:GraphNodeViewModel"><views:GraphNodeView /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <views:GraphSceneLayer x:Name="ConnectionLayer" DataContext="{Binding}" ConnectionsOnly="True" />
                <ItemsControl x:Name="NodeItems" ItemsSource="{Binding ForegroundNodes}">
                    <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left">
                                <MultiBinding Converter="{StaticResource GraphPositionConverter}">
                                    <ReflectionBinding Path="DisplayX" />
                                    <ReflectionBinding Path="OriginX"
                                                       RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type views:GraphEditorView}}" />
                                </MultiBinding>
                            </Setter>
                            <Setter Property="Canvas.Top">
                                <MultiBinding Converter="{StaticResource GraphPositionConverter}">
                                    <ReflectionBinding Path="DisplayY" />
                                    <ReflectionBinding Path="OriginY"
                                                       RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type views:GraphEditorView}}" />
                                </MultiBinding>
                            </Setter>
                        </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Classes="graphNodePanel" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:GraphNodeViewModel">
                            <views:GraphNodeView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="SelectionBox" IsVisible="False"
                            Background="{DynamicResource EffectSelectionFillBrush}"
                            BorderBrush="{DynamicResource EffectSelectionBorderBrush}" BorderThickness="1" />
                </Canvas>
            </Grid>
            </Grid>
        </ScrollViewer>
        <Popup x:Name="NodeSearchPopup" Grid.Row="2" PlacementTarget="{Binding #GraphScrollViewer}"
               Placement="Center" IsLightDismissEnabled="True">
            <Border Width="340" MaxHeight="400" Padding="8" BorderThickness="1"
                    BorderBrush="{DynamicResource EffectBorderBrush}"
                    Background="{DynamicResource EffectSurfaceBrush}">
                <Grid RowDefinitions="Auto,*">
                    <TextBox x:Name="NodeSearchBox" PlaceholderText="Search node types..."
                             TextChanged="OnNodeSearchTextChanged" KeyDown="OnNodeSearchKeyDown" />
                    <ListBox x:Name="NodeSearchResults" Grid.Row="1" Margin="0,6,0,0"
                             MaxHeight="320" DoubleTapped="OnNodeSearchDoubleTapped"
                             KeyDown="OnNodeSearchKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:NodeCatalogEntryViewModel">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Group}" FontSize="11"
                                               Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
