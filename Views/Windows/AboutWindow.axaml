<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsControls="using:LiberaFx.Views.Controls"
             xmlns:viewsWindows="using:LiberaFx.Views.Windows"
        x:Class="LiberaFx.Views.Windows.AboutWindow"
        Title="{DynamicResource Text.Panels.AboutTitle}" Width="560" Height="440" CanResize="False"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
            <viewsWindows:SplashArtwork />
        </Viewbox>
        <StackPanel Grid.Row="1" Margin="26,18,26,10" Spacing="6">
            <TextBlock Classes="editor-title" Text="LIBERA FX" />
            <TextBlock x:Name="VersionText" Classes="editor-label" />
        </StackPanel>
        <viewsControls:IconButton Grid.Row="2" Icon="Close"
                          ToolTip.Tip="{DynamicResource Text.Panels.Close}"
                          AutomationProperties.Name="{DynamicResource Text.Panels.Close}"
                          HorizontalAlignment="Right" Margin="0,0,26,20"
                          Click="OnCloseClick" />
    </Grid>
</Window>
