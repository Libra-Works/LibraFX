<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsControls="using:LiberaFx.Views.Controls"
        x:Class="LiberaFx.Views.Windows.UnsavedChangesWindow"
        Title="{DynamicResource Text.Panels.UnsavedChangesTitle}"
        Width="420"
        MinWidth="420"
        MaxWidth="420"
        SizeToContent="Height"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
    <Grid RowDefinitions="Auto,Auto" RowSpacing="18" Margin="20,18,20,16">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <viewsControls:EditorIconView Icon="Info" VerticalAlignment="Top" Margin="0,2,0,0" />
            <TextBlock Grid.Column="1" Text="{DynamicResource Text.Panels.UnsavedChangesPrompt}"
                       TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Classes="editor-action transport-primary" MinWidth="92" IsDefault="True" Click="OnSaveClick"
                    AutomationProperties.Name="{DynamicResource Text.Panels.SaveAll}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <viewsControls:EditorIconView Icon="Save" />
                    <TextBlock Text="{DynamicResource Text.Panels.SaveAll}" />
                </StackPanel>
            </Button>
            <Button Classes="editor-action" MinWidth="84" Click="OnDiscardClick"
                    AutomationProperties.Name="{DynamicResource Text.Panels.Discard}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <viewsControls:EditorIconView Icon="Delete" />
                    <TextBlock Text="{DynamicResource Text.Panels.Discard}" />
                </StackPanel>
            </Button>
            <Button Classes="editor-action" MinWidth="80" IsCancel="True" Click="OnCancelClick"
                    AutomationProperties.Name="{DynamicResource Text.Panels.Cancel}">
                <TextBlock Text="{DynamicResource Text.Panels.Cancel}" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
