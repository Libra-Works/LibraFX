<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiberaFx.ViewModels"
             x:Class="LiberaFx.Views.GraphNodeView"
             PointerPressed="OnNodePointerPressed"
             x:DataType="vm:GraphNodeViewModel">
    <Grid>
    <Border Width="240" IsVisible="{Binding !IsComment}"
            Background="{DynamicResource EffectSurfaceBrush}"
            BorderBrush="{Binding BorderBrush}"
            BorderThickness="2"
            CornerRadius="4">
        <Grid RowDefinitions="Auto,Auto,Auto">
            <Border Grid.Row="0"
                    x:Name="NodeHeader"
                    Padding="8"
                    Background="{DynamicResource EffectBorderBrush}"
                    PointerPressed="OnHeaderPointerPressed"
                    PointerMoved="OnHeaderPointerMoved"
                    PointerReleased="OnHeaderPointerReleased"
                    PointerCaptureLost="OnHeaderPointerCaptureLost">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="▶" IsVisible="{Binding IsGraphGroup}"
                               Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                    <ToggleButton x:Name="DetailsToggle" DockPanel.Dock="Right"
                                  Width="22" Height="20" Padding="0"
                                  IsVisible="{Binding HasParameters}"
                                  IsChecked="{Binding IsDetailsExpanded, Mode=TwoWay}"
                                  ToolTip.Tip="Show or hide node parameters"
                                  AutomationProperties.Name="Show or hide node parameters">
                        <Grid>
                            <TextBlock Text="▸" IsVisible="{Binding !IsDetailsExpanded}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="▾" IsVisible="{Binding IsDetailsExpanded}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ToggleButton>
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource EffectForegroundBrush}"
                               FontWeight="SemiBold" />
                </DockPanel>
            </Border>
            <Grid Grid.Row="1"
                  Margin="8"
                  IsVisible="{Binding HasPorts}"
                  ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Button Width="18"
                            Height="18"
                            Padding="0"
                            Tag="InputPort"
                            Content="●"
                            Background="Transparent"
                            Foreground="{Binding PortBrush}"
                            Command="{Binding SelectInputPortCommand}" />
                    <TextBlock Text="In"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource EffectForegroundBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplayPortType}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <TextBlock Text="Out"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource EffectForegroundBrush}" />
                    <Border Width="18" Height="18"
                            Background="Transparent"
                            Tag="OutputPort"
                            PointerPressed="OnOutputPointerPressed"
                            PointerMoved="OnOutputPointerMoved"
                            PointerReleased="OnOutputPointerReleased"
                            PointerCaptureLost="OnOutputPointerCaptureLost">
                        <TextBlock Text="●"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding PortBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Margin="8" IsVisible="{Binding IsGraphGroup}"
                       Text="Double-click to open" Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            <Border Grid.Row="2" IsVisible="{Binding IsDetailsExpanded}" Padding="8,5"
                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource EffectBorderBrush}">
                <ItemsControl ItemsSource="{Binding InlineParameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:NodeParameterEditorViewModel">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayValue}"
                                           ToolTip.Tip="{Binding DisplayValue}"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource EffectForegroundBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Border>
    <Border IsVisible="{Binding IsComment}" Width="{Binding CommentWidth}" Height="{Binding CommentHeight}"
            BorderBrush="{Binding BorderBrush}" BorderThickness="2" CornerRadius="5"
            Background="{DynamicResource EffectSelectionFillBrush}">
        <Grid RowDefinitions="Auto,*,Auto">
            <Border x:Name="CommentHeader" Padding="8,5" Background="{DynamicResource EffectBorderBrush}"
                    PointerPressed="OnHeaderPointerPressed" PointerMoved="OnHeaderPointerMoved"
                    PointerReleased="OnHeaderPointerReleased" PointerCaptureLost="OnHeaderPointerCaptureLost">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                           Foreground="{DynamicResource EffectForegroundBrush}" />
            </Border>
            <TextBox Grid.Row="1" Margin="8" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="2048"
                     Text="{Binding CommentText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     PlaceholderText="Write a comment..." VerticalContentAlignment="Top" />
            <Border Grid.Row="2" Width="20" Height="20" HorizontalAlignment="Right"
                    Background="Transparent" Cursor="BottomRightCorner"
                    PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved"
                    PointerReleased="OnResizeReleased" PointerCaptureLost="OnResizeCaptureLost"
                    ToolTip.Tip="Resize comment">
                <TextBlock Text="◢" HorizontalAlignment="Center"
                           Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            </Border>
        </Grid>
    </Border>
    </Grid>
</UserControl>
