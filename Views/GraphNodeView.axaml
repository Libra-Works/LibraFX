<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiberaFx.ViewModels"
             xmlns:graph="using:LiberaFx.Models.Graph"
             xmlns:views="using:LiberaFx.Views"
             x:Class="LiberaFx.Views.GraphNodeView"
             PointerPressed="OnNodePointerPressed"
             x:DataType="vm:GraphNodeViewModel">
    <UserControl.Resources>
        <views:GraphPortBrushConverter x:Key="PortBrushConverter" />
    </UserControl.Resources>
    <Grid>
    <Border x:Name="NodeBody" Width="240" IsVisible="{Binding !IsComment}"
            Background="{DynamicResource EffectSurfaceBrush}"
            BorderBrush="{Binding BorderBrush}"
            ToolTip.Tip="{Binding DiagnosticText}"
            AutomationProperties.HelpText="{Binding DiagnosticText}"
            BorderThickness="2"
            CornerRadius="4">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
            <Border Grid.Row="0"
                    x:Name="NodeHeader"
                    Padding="8"
                    Background="{DynamicResource EffectBorderBrush}"
                    ToolTip.Tip="{Binding HeaderHelp}"
                    AutomationProperties.HelpText="{Binding HeaderHelp}"
                    PointerPressed="OnHeaderPointerPressed"
                    PointerMoved="OnHeaderPointerMoved"
                    PointerReleased="OnHeaderPointerReleased"
                    PointerCaptureLost="OnHeaderPointerCaptureLost">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="▶" IsVisible="{Binding IsGraphGroup}"
                               Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                    <ToggleButton x:Name="DetailsToggle" DockPanel.Dock="Right"
                                  Width="22" Height="20" Padding="0"
                                  IsVisible="{Binding HasParameters}"
                                  IsChecked="{Binding IsDetailsExpanded, Mode=TwoWay}"
                                  ToolTip.Tip="{DynamicResource Text.Panels.ShowHideNodeParameters}"
                                  AutomationProperties.Name="{DynamicResource Text.Panels.ShowHideNodeParameters}">
                        <Grid>
                            <TextBlock Text="▸" IsVisible="{Binding !IsDetailsExpanded}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="▾" IsVisible="{Binding IsDetailsExpanded}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ToggleButton>
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource EffectForegroundBrush}"
                               FontWeight="SemiBold" />
                </DockPanel>
            </Border>
            <StackPanel x:Name="LifecycleSummaryPanel" Grid.Row="1" Margin="8,4,8,2" Spacing="2"
                        IsVisible="{Binding IsLifecycleNode}"
                        ToolTip.Tip="{Binding LifecycleSummaryHelp}"
                        AutomationProperties.HelpText="{Binding LifecycleSummaryHelp}">
                <Border HorizontalAlignment="Left" Padding="4,1" CornerRadius="3"
                        BorderBrush="{Binding LifecycleAccentBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding LifecycleRoleLabel}" FontSize="10"
                               Foreground="{Binding LifecycleAccentBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Border>
                <TextBlock x:Name="LifecycleSummaryLabel" Text="{Binding LifecycleSummary}"
                           FontSize="11" Foreground="{DynamicResource EffectForegroundBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Grid Grid.Row="2"
                  Margin="8"
                  IsVisible="{Binding HasPorts}"
                  ColumnDefinitions="*,Auto,*">
                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            IsVisible="{Binding HasLegacyInput}"
                            VerticalAlignment="Center">
                    <Button Width="18"
                            Height="18"
                            Padding="0"
                            Tag="InputPort"
                            Content="●"
                            Background="Transparent"
                            Foreground="{Binding PortBrush}"
                            Command="{Binding SelectInputPortCommand}" />
                    <TextBlock Text="{DynamicResource Text.Panels.Input}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource EffectForegroundBrush}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding InputPorts}" IsVisible="{Binding HasCustomInputs}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="graph:GraphInputPortDefinition">
                            <Grid ColumnDefinitions="18,*" ColumnSpacing="4" Height="24">
                                <Button Width="18" Height="18" Padding="0" Tag="{Binding}"
                                        Content="●" Background="Transparent" Click="OnCustomInputClick">
                                    <Button.Foreground>
                                        <MultiBinding Converter="{StaticResource PortBrushConverter}">
                                            <Binding Path="Category" />
                                            <Binding Path="$parent[views:GraphNodeView].((vm:GraphNodeViewModel)DataContext).PortBrush" />
                                        </MultiBinding>
                                    </Button.Foreground>
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="PortTypeLabel" Grid.Column="1"
                           Text="{Binding DisplayPortType}"
                           IsVisible="{Binding ShowPortType}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            IsVisible="{Binding HasLegacyOutput}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <TextBlock Text="{DynamicResource Text.Panels.Output}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource EffectForegroundBrush}" />
                    <Border Width="18" Height="18"
                            Background="Transparent"
                            Tag="OutputPort"
                            PointerPressed="OnOutputPointerPressed"
                            PointerMoved="OnOutputPointerMoved"
                            PointerReleased="OnOutputPointerReleased"
                            PointerCaptureLost="OnOutputPointerCaptureLost">
                        <TextBlock Text="●"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding PortBrush}" />
                    </Border>
                </StackPanel>
                <ItemsControl Grid.Column="2" ItemsSource="{Binding OutputPorts}"
                              IsVisible="{Binding HasCustomOutputs}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="graph:GraphOutputPortDefinition">
                            <Grid ColumnDefinitions="*,18" ColumnSpacing="4" Height="24">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                <Border Grid.Column="1" Width="18" Height="18" Background="Transparent" Tag="{Binding}"
                                        PointerPressed="OnOutputPointerPressed"
                                        PointerMoved="OnOutputPointerMoved"
                                        PointerReleased="OnOutputPointerReleased"
                                        PointerCaptureLost="OnOutputPointerCaptureLost">
                                    <TextBlock Text="●" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <MultiBinding Converter="{StaticResource PortBrushConverter}">
                                                <Binding Path="Category" />
                                                <Binding Path="$parent[views:GraphNodeView].((vm:GraphNodeViewModel)DataContext).PortBrush" />
                                            </MultiBinding>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <TextBlock x:Name="GroupHintLabel" Grid.Row="2" Margin="8" IsVisible="{Binding ShowGroupHint}"
                       Text="{DynamicResource Text.Panels.DoubleClickToOpen}" Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            <TextBlock x:Name="GpuProgramLabel" Grid.Row="2" Margin="8" IsVisible="{Binding IsGpuParticle}"
                       Text="{DynamicResource Text.Gpu.ContainerHint}" Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            <Border Grid.Row="3" IsVisible="{Binding IsDetailsExpanded}" Padding="8,5"
                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource EffectBorderBrush}">
                <ItemsControl ItemsSource="{Binding InlineParameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:NodeParameterEditorViewModel">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayValue}"
                                           ToolTip.Tip="{Binding DisplayValue}"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource EffectForegroundBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Border>
    <Border IsVisible="{Binding IsComment}" Width="{Binding CommentWidth}" Height="{Binding CommentHeight}"
            BorderBrush="{Binding BorderBrush}" BorderThickness="2" CornerRadius="5"
            Background="{DynamicResource EffectSelectionFillBrush}">
        <Grid RowDefinitions="Auto,*,Auto">
            <Border x:Name="CommentHeader" Padding="8,5" Background="{DynamicResource EffectBorderBrush}"
                    PointerPressed="OnHeaderPointerPressed" PointerMoved="OnHeaderPointerMoved"
                    PointerReleased="OnHeaderPointerReleased" PointerCaptureLost="OnHeaderPointerCaptureLost">
                <DockPanel>
                    <views:IconButton x:Name="EditCommentButton" DockPanel.Dock="Right" Icon="Edit" Padding="5,0"
                                      IsVisible="{Binding HasFormattedComment}" Click="OnEditCommentClick"
                                      ToolTip.Tip="{DynamicResource Text.Comments.EditSource}"
                                      AutomationProperties.Name="{DynamicResource Text.Comments.EditSource}" />
                    <views:IconButton DockPanel.Dock="Right" Icon="Delete" Padding="5,0"
                                      Click="OnRemoveImageClick"
                                      ToolTip.Tip="{DynamicResource Text.Panels.RemoveCommentImage}"
                                      AutomationProperties.Name="{DynamicResource Text.Panels.RemoveCommentImage}" />
                    <views:IconButton DockPanel.Dock="Right" Icon="Image" Padding="5,0"
                                      Click="OnAddImageClick"
                                      ToolTip.Tip="{DynamicResource Text.Panels.EmbedCommentImage}"
                                      AutomationProperties.Name="{DynamicResource Text.Panels.EmbedCommentImage}" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource EffectForegroundBrush}" />
                </DockPanel>
            </Border>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <TextBox x:Name="CommentSource" Margin="8" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4096"
                         Text="{Binding CommentText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="{DynamicResource Text.Panels.WriteComment}" VerticalContentAlignment="Top" />
                <views:CommentMarkupView x:Name="CommentPreview" Margin="8" IsVisible="False"
                                         Text="{Binding CommentText}" Format="{Binding CommentStyle}"
                                         TaskChanged="OnCommentTaskChanged" />
                <StackPanel Grid.Column="1" MaxWidth="160" Margin="4">
                    <Image x:Name="EmbeddedImage" MaxWidth="160" MaxHeight="120"
                           Stretch="Uniform" IsHitTestVisible="False" />
                    <TextBlock x:Name="ImageStatus" TextWrapping="Wrap" FontSize="10"
                               Foreground="{DynamicResource EffectMutedForegroundBrush}" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Width="20" Height="20" HorizontalAlignment="Right"
                    Background="Transparent" Cursor="BottomRightCorner"
                    PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved"
                    PointerReleased="OnResizeReleased" PointerCaptureLost="OnResizeCaptureLost"
                    ToolTip.Tip="{DynamicResource Text.Panels.ResizeComment}"
                    AutomationProperties.Name="{DynamicResource Text.Panels.ResizeComment}">
                <TextBlock Text="◢" HorizontalAlignment="Center"
                           Foreground="{DynamicResource EffectMutedForegroundBrush}" />
            </Border>
        </Grid>
    </Border>
    </Grid>
</UserControl>
