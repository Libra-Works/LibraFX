<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiberaFx.ViewModels"
             x:Class="LiberaFx.Views.PreviewPaneView"
             Classes="editor-inspector"
             x:DataType="vm:PreviewPaneViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8" Spacing="8">
            <Border Classes="editor-card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Panels.PreviewTransport}" />
                    <TextBlock Text="{Binding Main.PreviewStatus}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Panels.ConnectedClients}" />
                        <TextBlock Classes="editor-heading" Text="{Binding Main.PreviewClientCount}" />
                    </StackPanel>
                    <CheckBox Content="{DynamicResource Text.DebugDraw.Transfer}"
                              IsChecked="{Binding Main.IncludePreviewDebugDraw, Mode=TwoWay}" />
                    <TextBlock Classes="editor-label" Text="{DynamicResource Text.DebugDraw.Help}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock Classes="editor-heading" Text="{DynamicResource Text.ExecutionDebug.Title}" />
            <TextBlock Text="{DynamicResource Text.ExecutionDebug.Help}" TextWrapping="Wrap" />
            <CheckBox Content="{DynamicResource Text.ExecutionDebug.Package}" IsChecked="{Binding Main.ExecutionDebugger.PackageMode}" />
            <WrapPanel>
                <Button Content="{DynamicResource Text.ExecutionDebug.Start}" Command="{Binding Main.ExecutionDebugger.StartCommand}" />
                <Button Content="{DynamicResource Text.ExecutionDebug.Disconnect}" Command="{Binding Main.ExecutionDebugger.DisconnectCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding Main.ExecutionDebugger.Status}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Main.ExecutionDebugger.Target}" TextWrapping="Wrap" />
            <TextBox Text="{Binding Main.ExecutionDebugger.Invitation, Mode=OneWay}" IsReadOnly="True"
                     PlaceholderText="{DynamicResource Text.ExecutionDebug.Invitation}" />
            <WrapPanel>
                <Button Content="{DynamicResource Text.ExecutionDebug.Toggle}" Command="{Binding Main.ExecutionDebugger.BreakpointCommand}" />
                <Button Content="{DynamicResource Text.ExecutionDebug.Pause}" Command="{Binding Main.ExecutionDebugger.PauseCommand}" />
                <Button Content="{DynamicResource Text.ExecutionDebug.Step}" Command="{Binding Main.ExecutionDebugger.StepCommand}" />
                <Button Content="{DynamicResource Text.ExecutionDebug.Resume}" Command="{Binding Main.ExecutionDebugger.ResumeCommand}" />
                <Button Content="{DynamicResource Text.ExecutionDebug.Locate}" Command="{Binding Main.ExecutionDebugger.LocateCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding Main.ExecutionDebugger.Breakpoints}" />
            <TextBlock Text="{Binding Main.ExecutionDebugger.CurrentNode}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Main.ExecutionDebugger.CurrentSignalSource}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Main.ExecutionDebugger.Inputs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Main.ExecutionDebugger.AuthoredParameters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Separator />
            <TextBlock Text="{DynamicResource Text.Panels.PreviewEndpointHelp}" TextWrapping="Wrap" />
            <TextBox Text="{Binding Main.PreviewEndpoint}" IsReadOnly="True" />
            <TextBlock Text="X-LiberaFx-Preview-Token" />
            <TextBox Text="{Binding Main.PreviewAccessToken}" IsReadOnly="True" />
            <TextBlock Text="{DynamicResource Text.Panels.PreviewFingerprint}" />
            <TextBox Text="{Binding Main.PreviewFingerprint}" IsReadOnly="True" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Text.Panels.PreviewSecurityNotice}"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Text.Panels.PreviewProtocolNotice}"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
