<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiberaFx.ViewModels"
        x:Class="LiberaFx.Views.WindowLayoutsWindow"
        x:DataType="vm:WindowLayoutsViewModel"
        Title="{DynamicResource Text.Layouts.Title}" Width="620" Height="400"
        MinWidth="480" MinHeight="340" WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Text="{DynamicResource Text.Layouts.Hint}" TextWrapping="Wrap" Margin="0,0,0,14" />
        <ComboBox Grid.Row="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:WindowLayoutChoice"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10">
            <Button Content="{DynamicResource Text.Layouts.Apply}" Command="{Binding ApplyCommand}" />
            <Button Content="{DynamicResource Text.Layouts.Update}" Command="{Binding SaveSelectedCommand}" />
            <Button Content="{DynamicResource Text.Layouts.Delete}" Command="{Binding DeleteCommand}" />
        </StackPanel>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <TextBox x:Name="PresetName" Text="{Binding NewName}" MaxLength="64"
                     PlaceholderText="{DynamicResource Text.Layouts.Name}" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="{DynamicResource Text.Layouts.Create}" Command="{Binding CreateCommand}" />
        </Grid>
        <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{DynamicResource Text.Layouts.RestoreDefault}" Command="{Binding RestoreDefaultCommand}" />
            <Button Content="{DynamicResource Text.Layouts.Close}" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
