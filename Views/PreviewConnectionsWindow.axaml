<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:LiberaFx.Services"
        x:Class="LiberaFx.Views.PreviewConnectionsWindow"
        Title="{DynamicResource Text.Connections.Title}"
        Width="940" Height="560" MinWidth="640" MinHeight="400"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16" RowSpacing="12">
    <TextBlock Text="{DynamicResource Text.Connections.Hint}" TextWrapping="Wrap" />
    <StackPanel Grid.Row="1" Spacing="6">
      <TextBlock Text="{DynamicResource Text.Connections.ConnectHint}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="FindViewersButton" Click="OnFindViewers"
                Content="{DynamicResource Text.Connections.FindViewers}" />
        <ComboBox x:Name="AvailableViewers" Width="350" SelectionChanged="OnAvailableViewerChanged"
                  AutomationProperties.Name="{DynamicResource Text.Connections.AvailableViewers}" />
        <Button x:Name="ConnectViewerButton" Click="OnConnectViewer" IsEnabled="False"
                Content="{DynamicResource Text.Connections.ConnectViewer}" />
      </StackPanel>
      <TextBlock x:Name="DiscoveryStatus" TextWrapping="Wrap" />
      <Button x:Name="CopyConnectionButton" Click="OnCopyConnection"
              Content="{DynamicResource Text.Connections.CopyConnection}"
              AutomationProperties.Name="{DynamicResource Text.Connections.CopyConnection}"
              HorizontalAlignment="Left" />
      <TextBlock x:Name="InvitationStatus" TextWrapping="Wrap"
                 Foreground="{DynamicResource EffectMutedForegroundBrush}" />
      <TextBlock x:Name="GpuFeedback" TextWrapping="Wrap" />
    </StackPanel>
    <ListBox Grid.Row="2" x:Name="Peers" SelectionChanged="OnSelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="services:PreviewPeer">
          <Grid Margin="8" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding Engine}" FontWeight="Bold" FontSize="18" />
              <TextBlock Text="{Binding EngineVersion}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Role}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Platform}" />
            <TextBlock Grid.Row="1" Text="{Binding ViewerName}" Margin="0,6" FontSize="15" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RemoteAddress}" Margin="12,6,0,6" />
            <TextBlock Grid.Row="2" Text="{Binding ClientId}" Opacity="0.6" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConnectedAt}" Opacity="0.6" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
      <TextBlock x:Name="Status" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" x:Name="ReconnectButton" Click="OnReconnect"
              Content="{DynamicResource Text.Connections.Reconnect}" />
    </Grid>
  </Grid>
</Window>
