<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:LiberaFx.Services"
        xmlns:views="using:LiberaFx.Views"
        x:Class="LiberaFx.Views.PreviewConnectionsWindow"
        Background="{DynamicResource EffectWindowBackgroundBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="8">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <ComboBox x:Name="AvailableViewers" HorizontalAlignment="Stretch" SelectionChanged="OnAvailableViewerChanged"
                  ToolTip.Tip="{DynamicResource Text.Connections.ConnectHint}"
                  AutomationProperties.Name="{DynamicResource Text.Connections.AvailableViewers}" />
        <Border Grid.Column="1" Classes="editor-toolbar-group" Padding="4,2">
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <views:IconButton x:Name="FindViewersButton" Classes="editor-tool" Icon="Refresh" Click="OnFindViewers"
                              ToolTip.Tip="{DynamicResource Text.Connections.FindViewers}"
                              AutomationProperties.Name="{DynamicResource Text.Connections.FindViewers}" />
            <views:IconButton x:Name="ConnectViewerButton" Classes="editor-tool transport-primary" Icon="Link" Click="OnConnectViewer" IsEnabled="False"
                              ToolTip.Tip="{DynamicResource Text.Connections.ConnectViewer}"
                              AutomationProperties.Name="{DynamicResource Text.Connections.ConnectViewer}" />
            <Border Classes="editor-toolbar-divider" />
            <views:IconButton x:Name="CopyConnectionButton" Classes="editor-tool" Icon="Copy" Click="OnCopyConnection"
                              ToolTip.Tip="{DynamicResource Text.Connections.CopyConnection}"
                              AutomationProperties.Name="{DynamicResource Text.Connections.CopyConnection}" />
            <views:IconButton Classes="editor-tool" Icon="Export" Click="OnCopyGodotCertificate"
                              ToolTip.Tip="{DynamicResource Text.Connections.CopyGodotCertificate}"
                              AutomationProperties.Name="{DynamicResource Text.Connections.CopyGodotCertificate}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="Transparent" Padding="4" VerticalAlignment="Center"
                ToolTip.Tip="{DynamicResource Text.Connections.Hint}">
          <views:EditorIconView Icon="Info" />
        </Border>
      </Grid>
      <TextBlock x:Name="DiscoveryStatus" Classes="editor-label" TextWrapping="Wrap" />
      <TextBlock x:Name="InvitationStatus" Classes="editor-label" TextWrapping="Wrap" />
      <TextBlock x:Name="GpuFeedback" Classes="editor-label" TextWrapping="Wrap" />
    </StackPanel>
    <ListBox Grid.Row="1" x:Name="Peers" SelectionChanged="OnSelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="services:PreviewPeer">
          <Grid Margin="8,6" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="editor-title" Text="{Binding Engine}" />
              <TextBlock Text="{Binding EngineVersion}" VerticalAlignment="Center" />
              <TextBlock Classes="editor-label" Text="{Binding Role}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Platform}" />
            <TextBlock Grid.Row="1" Classes="editor-heading" Text="{Binding ViewerName}" Margin="0,4" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RemoteAddress}" Margin="12,4,0,4" />
            <TextBlock Grid.Row="2" Classes="editor-label" Text="{Binding ClientId}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="editor-label" Text="{Binding ConnectedAt}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock x:Name="Status" Classes="editor-label" VerticalAlignment="Center" TextWrapping="Wrap" />
      <views:IconButton Grid.Column="1" x:Name="ReconnectButton" Classes="editor-tool" Icon="Refresh" Click="OnReconnect"
                        ToolTip.Tip="{DynamicResource Text.Connections.Reconnect}"
                        AutomationProperties.Name="{DynamicResource Text.Connections.Reconnect}" />
    </Grid>
  </Grid>
</UserControl>
