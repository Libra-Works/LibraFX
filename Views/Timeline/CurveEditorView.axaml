<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsControls="using:LiberaFx.Views.Controls"
             xmlns:viewsTimeline="using:LiberaFx.Views.Timeline"
             xmlns:vmPanels="using:LiberaFx.ViewModels.Panels"
             x:Class="LiberaFx.Views.Timeline.CurveEditorView"
             x:DataType="vmPanels:CurveEditorViewModel"
             Background="{DynamicResource EffectWindowBackgroundBrush}">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Classes="editor-bar" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                <Border Classes="editor-toolbar-group" Padding="4,2">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <viewsControls:IconButton x:Name="CurveAddKeyButton" Classes="editor-tool" Icon="Add" Command="{Binding AddKeyCommand}"
                                          ToolTip.Tip="{DynamicResource Text.Panels.AddKey}"
                                          AutomationProperties.Name="{DynamicResource Text.Panels.AddKey}" />
                        <viewsControls:IconButton Classes="editor-tool" Icon="Delete" Command="{Binding DeleteKeyCommand}"
                                          ToolTip.Tip="{DynamicResource Text.Panels.DeleteKey}"
                                          AutomationProperties.Name="{DynamicResource Text.Panels.DeleteKey}" />
                        <Border Classes="editor-toolbar-divider" />
                        <viewsControls:IconButton x:Name="CurveFrameAllButton" Classes="editor-tool" Icon="Frame" Click="OnFrameAllClick"
                                          ToolTip.Tip="{DynamicResource Text.Panels.FrameAll}"
                                          AutomationProperties.Name="{DynamicResource Text.Panels.FrameAll}" />
                        <viewsControls:IconButton Classes="editor-tool" Icon="Frame" Click="OnFrameSelectedClick" IsEnabled="{Binding HasSelectedKeys}"
                                          ToolTip.Tip="{DynamicResource Text.Panels.FrameSelected}"
                                          AutomationProperties.Name="{DynamicResource Text.Panels.FrameSelected}" />
                        <viewsControls:IconButton Classes="editor-tool" Icon="ZoomOut" Click="OnZoomOutClick"
                                          ToolTip.Tip="{DynamicResource Text.Panels.ZoomOut}"
                                          AutomationProperties.Name="{DynamicResource Text.Panels.ZoomOut}" />
                        <viewsControls:IconButton Classes="editor-tool" Icon="ZoomIn" Click="OnZoomInClick"
                                          ToolTip.Tip="{DynamicResource Text.Panels.ZoomIn}"
                                          AutomationProperties.Name="{DynamicResource Text.Panels.ZoomIn}" />
                        <Border Classes="editor-toolbar-divider" />
                        <ToggleButton Classes="editor-tool" IsChecked="{Binding SnapToFrames}"
                                      ToolTip.Tip="{DynamicResource Text.Panels.SnapFrames}"
                                      AutomationProperties.Name="{DynamicResource Text.Panels.SnapFrames}">
                            <viewsControls:EditorIconView Icon="Pin" />
                        </ToggleButton>
                        <ToggleButton x:Name="CurveTimeUnitToggle" Classes="editor-tool" IsChecked="{Binding Playback.ShowSeconds}"
                                      IsEnabled="{Binding !!Playback}"
                                      ToolTip.Tip="{DynamicResource Text.Timeline.UseSeconds}"
                                      AutomationProperties.Name="{DynamicResource Text.Timeline.UseSeconds}">
                            <viewsControls:EditorIconView Icon="Clock" />
                        </ToggleButton>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="editor-heading" Text="{Binding Node.Name}" VerticalAlignment="Center" />
                    <Border IsVisible="{Binding IsColorCurve}" Background="{Binding ColorCurvePreview}"
                            BorderBrush="{DynamicResource EffectMutedForegroundBrush}" BorderThickness="1"
                            Width="32" Height="18" VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource Text.Panels.CurveColorPreview}"
                            AutomationProperties.Name="{DynamicResource Text.Panels.CurveColorPreview}" />
                </StackPanel>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="190,*">
            <Border Background="{DynamicResource EffectSurfaceBrush}"
                    BorderBrush="{DynamicResource EditorChromeDividerBrush}"
                    BorderThickness="0,0,1,0" Padding="6">
                <Grid RowDefinitions="Auto,*" RowSpacing="4">
                    <TextBox PlaceholderText="{DynamicResource Text.Panels.SearchCurves}" Text="{Binding ChannelSearch, Mode=TwoWay}" />
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding FilteredChannelGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vmPanels:CurveChannelGroupViewModel">
                                    <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,2">
                                        <ItemsControl ItemsSource="{Binding Channels}" Margin="16,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vmPanels:CurveChannelViewModel">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1">
                                                        <CheckBox IsChecked="{Binding IsVisible}"
                                                                  ToolTip.Tip="{DynamicResource Text.Panels.ShowHideCurve}"
                                                                  AutomationProperties.Name="{DynamicResource Text.Panels.ShowHideCurve}" />
                                                        <Button Foreground="{Binding Brush}" Tag="{Binding}" Click="OnChannelClick" Padding="4,1"
                                                                AutomationProperties.Name="{Binding Label}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <viewsControls:EditorIconView Icon="Frame" Stroke="{Binding Brush}" />
                                                                <TextBlock Text="{Binding Label}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="*,Auto">
                <viewsTimeline:FCurveCanvas x:Name="CurveCanvas" MinHeight="130" />
                <viewsTimeline:CurveColorBar Grid.Row="1" x:Name="ColorBar" Height="22" IsVisible="{Binding IsColorCurve}" />
            </Grid>
        </Grid>
        <Border Grid.Row="1" Classes="editor-bar" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasKey}">
                    <TextBlock Classes="editor-heading" Text="{DynamicResource Text.Panels.SelectedKey}" VerticalAlignment="Center" />
                    <Grid ColumnDefinitions="Auto,82" ColumnSpacing="6">
                        <TextBlock Classes="editor-label" Text="{Binding TimeUnitLabel}" />
                        <TextBox Grid.Column="1" Classes="editor-field" Text="{Binding FrameText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,82" ColumnSpacing="6">
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Panels.Value}" />
                        <TextBox x:Name="CurveValueBox" Grid.Column="1" Classes="editor-field" Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding Interpolations}"
                              SelectedItem="{Binding SelectedInterpolation, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><viewsControls:LocalizedOptionText Value="{ReflectionBinding}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid ColumnDefinitions="Auto,82" ColumnSpacing="6">
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Panels.InSlope}" />
                        <TextBox Grid.Column="1" Classes="editor-field" Text="{Binding InSlopeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,82" ColumnSpacing="6">
                        <TextBlock Classes="editor-label" Text="{DynamicResource Text.Panels.OutSlope}" />
                        <TextBox Grid.Column="1" Classes="editor-field" Text="{Binding OutSlopeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="3" Classes="editor-bar" BorderThickness="0,1,0,0">
            <TextBlock Classes="editor-label" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
