<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:servicesPreview="using:LiberaFx.Services.Preview"
             xmlns:viewsControls="using:LiberaFx.Views.Controls"
             x:Class="LiberaFx.Views.Timeline.PlaybackTransport"
             x:DataType="servicesPreview:EditorPlayback"
             x:Name="Transport">
    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4" VerticalAlignment="Center">
        <Expander Header="{DynamicResource Text.Timeline.Motion}" ExpandDirection="Down">
            <StackPanel Spacing="4" Margin="6">
                <ComboBox ItemsSource="{Binding MotionOptions}" SelectedIndex="{Binding Motion}" MinWidth="100" />
                <TextBlock Text="{DynamicResource Text.Timeline.MotionRadius}" />
                <TextBox Text="{Binding MotionRadiusText, UpdateSourceTrigger=LostFocus}" Width="80" />
                <TextBlock Text="{DynamicResource Text.Timeline.MotionSpeed}" />
                <TextBox Text="{Binding MotionSpeedText, UpdateSourceTrigger=LostFocus}" Width="80" />
            </StackPanel>
        </Expander>
        <Border Classes="editor-toolbar-group" Padding="4,2">
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <viewsControls:IconButton Classes="editor-tool" Icon="StepBack" Command="{Binding StepBackCommand}"
                                  IsVisible="{ReflectionBinding ShowFrameTools, ElementName=Transport}"
                                  ToolTip.Tip="{DynamicResource Text.Timeline.StepBack}"
                                  AutomationProperties.Name="{DynamicResource Text.Timeline.StepBack}" />
                <viewsControls:IconButton Classes="editor-tool transport-primary" Classes.playing="{Binding IsPlaying}"
                                  Icon="{Binding PlayIcon}" Command="{Binding PlayPauseCommand}"
                                  ToolTip.Tip="{DynamicResource Text.Timeline.PlayPause}"
                                  AutomationProperties.Name="{DynamicResource Text.Timeline.PlayPause}" />
                <viewsControls:IconButton Classes="editor-tool" Icon="Stop" Command="{Binding StopCommand}"
                                  ToolTip.Tip="{DynamicResource Text.Timeline.Stop}"
                                  AutomationProperties.Name="{DynamicResource Text.Timeline.Stop}" />
                <viewsControls:IconButton Classes="editor-tool" Icon="StepForward" Command="{Binding StepForwardCommand}"
                                  IsVisible="{ReflectionBinding ShowFrameTools, ElementName=Transport}"
                                  ToolTip.Tip="{DynamicResource Text.Timeline.StepForward}"
                                  AutomationProperties.Name="{DynamicResource Text.Timeline.StepForward}" />
                <Border Classes="editor-toolbar-divider" />
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" Margin="2,0,4,0" VerticalAlignment="Center">
                    <TextBlock Classes="editor-heading" Text="{Binding FrameText}"
                               MinWidth="56" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               IsVisible="{ReflectionBinding !ShowFrameTools, ElementName=Transport}"
                               AutomationProperties.Name="{DynamicResource Text.Timeline.CurrentTime}" />
                    <TextBox Classes="editor-field" Width="74" TextAlignment="Right"
                             Text="{Binding FrameText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             IsVisible="{ReflectionBinding ShowFrameTools, ElementName=Transport}"
                             ToolTip.Tip="{DynamicResource Text.Timeline.CurrentTime}"
                             AutomationProperties.Name="{DynamicResource Text.Timeline.CurrentTime}" />
                    <TextBlock Grid.Column="1" Classes="editor-label" Text="{Binding TimeUnitLabel}" />
                </Grid>
            </StackPanel>
        </Border>
        <Border Classes="editor-toolbar-group"
                IsVisible="{ReflectionBinding ShowFrameTools, ElementName=Transport}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="editor-label" Text="{DynamicResource Text.Timeline.Range}" />
                <TextBox Classes="editor-field" Width="64" TextAlignment="Right"
                         ToolTip.Tip="{DynamicResource Text.Timeline.RangeStart}"
                         AutomationProperties.Name="{DynamicResource Text.Timeline.RangeStart}"
                         Text="{Binding StartText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Classes="editor-label" Text="&#8211;" />
                <TextBox Classes="editor-field" Width="64" TextAlignment="Right"
                         ToolTip.Tip="{DynamicResource Text.Timeline.RangeEnd}"
                         AutomationProperties.Name="{DynamicResource Text.Timeline.RangeEnd}"
                         Text="{Binding EndText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <Border Classes="editor-toolbar-divider" />
                <TextBlock Classes="editor-label" Text="{DynamicResource Text.Timeline.Fps}" />
                <TextBox Classes="editor-field" Width="46" TextAlignment="Right"
                         ToolTip.Tip="{DynamicResource Text.Timeline.Fps}"
                         AutomationProperties.Name="{DynamicResource Text.Timeline.Fps}"
                         Text="{Binding FpsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <Border Classes="editor-toolbar-divider" />
                <TextBlock Classes="editor-label" Text="{DynamicResource Text.Timeline.TimeScale}" />
                <TextBox Classes="editor-field" Width="52" TextAlignment="Right"
                         Text="{Binding TimeScaleText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip.Tip="{DynamicResource Text.Timeline.TimeScaleHelp}"
                         AutomationProperties.Name="{DynamicResource Text.Timeline.TimeScale}" />
            </StackPanel>
        </Border>
        <Border Classes="editor-toolbar-group" Padding="4,2"
                IsVisible="{ReflectionBinding ShowFrameTools, ElementName=Transport}">
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <ToggleButton Classes="editor-tool" IsChecked="{Binding ShowSeconds}"
                              ToolTip.Tip="{DynamicResource Text.Timeline.UseSeconds}"
                              AutomationProperties.Name="{DynamicResource Text.Timeline.UseSeconds}">
                    <viewsControls:EditorIconView Icon="Clock" />
                </ToggleButton>
                <ToggleButton Classes="editor-tool" IsChecked="{Binding Loop}"
                              ToolTip.Tip="{DynamicResource Text.Timeline.Loop}"
                              AutomationProperties.Name="{DynamicResource Text.Timeline.Loop}">
                    <viewsControls:EditorIconView Icon="Refresh" />
                </ToggleButton>
            </StackPanel>
        </Border>
    </WrapPanel>
</UserControl>
