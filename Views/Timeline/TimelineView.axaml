<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsControls="using:LiberaFx.Views.Controls"
             xmlns:viewsTimeline="using:LiberaFx.Views.Timeline"
             xmlns:vmPanels="using:LiberaFx.ViewModels.Panels"
             x:Class="LiberaFx.Views.Timeline.TimelineView" x:DataType="vmPanels:TimelineViewModel"
             Background="{DynamicResource EffectWindowBackgroundBrush}">
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Classes="editor-bar" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                <Border Classes="editor-toolbar-group" Padding="4,2">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <viewsControls:IconButton Classes="editor-tool" Icon="Frame" Click="OnFrameAllClick"
                                          ToolTip.Tip="{DynamicResource Text.Panels.FrameAll}"
                                          AutomationProperties.Name="{DynamicResource Text.Panels.FrameAll}" />
                        <viewsControls:IconButton Classes="editor-tool" Icon="ZoomOut" Click="OnZoomOutClick"
                                          ToolTip.Tip="{DynamicResource Text.Panels.ZoomOut}"
                                          AutomationProperties.Name="{DynamicResource Text.Panels.ZoomOut}" />
                        <viewsControls:IconButton Classes="editor-tool" Icon="ZoomIn" Click="OnZoomInClick"
                                          ToolTip.Tip="{DynamicResource Text.Panels.ZoomIn}"
                                          AutomationProperties.Name="{DynamicResource Text.Panels.ZoomIn}" />
                        <ToggleButton Classes="editor-tool" IsChecked="{Binding Playback.ShowSeconds}"
                                      ToolTip.Tip="{DynamicResource Text.Timeline.UseSeconds}"
                                      AutomationProperties.Name="{DynamicResource Text.Timeline.UseSeconds}">
                            <viewsControls:EditorIconView Icon="Clock" />
                        </ToggleButton>
                        <Border Classes="editor-toolbar-divider" />
                        <viewsControls:IconButton x:Name="AddPreviewSignalButton" Classes="editor-tool"
                                          Icon="SignalPreview" Command="{Binding AddPreviewSignalKeyCommand}"
                                          ToolTip.Tip="{DynamicResource Text.Timeline.AddPreviewSignal}"
                                          AutomationProperties.Name="{DynamicResource Text.Timeline.AddPreviewSignal}" />
                        <viewsControls:IconButton x:Name="AddRuntimeSignalButton" Classes="editor-tool"
                                          Icon="SignalRuntime" Command="{Binding AddRuntimeSignalKeyCommand}"
                                          ToolTip.Tip="{DynamicResource Text.Timeline.AddRuntimeSignal}"
                                          AutomationProperties.Name="{DynamicResource Text.Timeline.AddRuntimeSignal}" />
                    </StackPanel>
                </Border>
                <Border Background="Transparent" Padding="4" VerticalAlignment="Center"
                        ToolTip.Tip="{Binding Status}">
                    <viewsControls:EditorIconView Icon="Info" />
                </Border>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Classes="editor-bar" BorderThickness="0,0,0,1" Padding="8,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Classes="editor-heading" Text="{Binding SelectedTrack.Name}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding SelectedTrack.IsCurve}" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,82" ColumnSpacing="6">
                            <TextBlock Classes="editor-label" Text="{DynamicResource Text.Timeline.Start}" />
                            <TextBox Grid.Column="1" Classes="editor-field" Text="{Binding SelectedTrack.StartText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,82" ColumnSpacing="6">
                            <TextBlock Classes="editor-label" Text="{DynamicResource Text.Timeline.Duration}" />
                            <TextBox Grid.Column="1" Classes="editor-field" IsEnabled="{Binding SelectedTrack.CanStretch}"
                                     Text="{Binding SelectedTrack.DurationText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding SelectedTrack.IsSignal}" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding SelectedTrack.SignalKeys}" SelectedItem="{Binding SelectedSignalKey}" MinWidth="88">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vmPanels:TimelineSignalKeyViewModel">
                                    <TextBlock Text="{Binding TimeText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid ColumnDefinitions="Auto,82" ColumnSpacing="6">
                            <TextBlock Classes="editor-label" Text="{DynamicResource Text.Timeline.SignalTime}" />
                            <TextBox Grid.Column="1" Classes="editor-field" Text="{Binding SignalTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        <Button Content="{DynamicResource Text.Timeline.DeleteSignal}" Command="{Binding DeleteSignalKeyCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource EffectCurveBackgroundBrush}">
            <viewsTimeline:TimelineCanvas x:Name="Canvas" MinHeight="{Binding CanvasHeight}" VerticalAlignment="Stretch"
                                  HeaderBackground="{DynamicResource EffectSurfaceBrush}" />
        </ScrollViewer>
    </Grid>
</UserControl>
