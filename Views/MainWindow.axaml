<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:vm="using:LiberaFx.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="LiberaFx.Views.MainWindow"
        KeyDown="OnMainKeyDown"
        x:DataType="vm:MainViewModel"
        Title="LIBERA FX"
        Background="{DynamicResource EffectWindowBackgroundBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New"
                          Command="{Binding NewDocumentCommand}" />
                <MenuItem Header="_Open..."
                          Command="{Binding OpenProjectCommand}" />
                <Separator />
                <MenuItem Header="_Save"
                          Command="{Binding SaveProjectCommand}" />
                <MenuItem Header="Save _As..."
                          Command="{Binding SaveProjectAsCommand}" />
                <Separator />
                <MenuItem Header="_Close Document"
                          Click="OnCloseDocumentClick" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo"
                          Command="{Binding UndoCommand}" />
                <MenuItem Header="_Redo"
                          Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="_Settings..."
                          Click="OnSettingsClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Log" Click="OnLogClick" />
                <MenuItem Header="_MCP connection..." Click="OnMcpClick" />
            </MenuItem>
        </Menu>

        <dock:DockControl Grid.Row="1"
                          Layout="{Binding Layout}" />

        <StackPanel Grid.Row="2" Margin="8,4" Spacing="2">
            <TextBlock Text="{Binding FileStatus}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
        </StackPanel>
    </Grid>

</Window>
