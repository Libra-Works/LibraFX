<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:vm="using:LiberaFx.ViewModels"
        xmlns:views="using:LiberaFx.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="LiberaFx.Views.MainWindow"
        KeyDown="OnMainKeyDown"
        x:DataType="vm:MainViewModel"
        Title="LIBERA FX"
        Background="{DynamicResource EffectWindowBackgroundBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <Menu>
            <MenuItem Header="{DynamicResource Text.Editor.File}">
                <MenuItem Header="{DynamicResource Text.Editor.New}"
                          Command="{Binding NewDocumentCommand}">
                    <MenuItem.Icon><views:EditorIconView Icon="Add" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Text.Editor.Open}"
                          Command="{Binding OpenProjectCommand}">
                    <MenuItem.Icon><views:EditorIconView Icon="Open" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Text.Editor.Save}"
                          Command="{Binding SaveProjectCommand}">
                    <MenuItem.Icon><views:EditorIconView Icon="Save" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Text.Editor.SaveAs}"
                          Command="{Binding SaveProjectAsCommand}">
                    <MenuItem.Icon><views:EditorIconView Icon="SaveAs" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Text.Editor.Export}"
                          Command="{Binding ExportVfxCommand}">
                    <MenuItem.Icon><views:EditorIconView Icon="Export" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Text.Editor.CloseDocument}"
                          Click="OnCloseDocumentClick">
                    <MenuItem.Icon><views:EditorIconView Icon="Close" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource Text.Editor.Edit}">
                <MenuItem Header="{DynamicResource Text.Editor.Undo}"
                          Command="{Binding UndoCommand}">
                    <MenuItem.Icon><views:EditorIconView Icon="Undo" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Text.Editor.Redo}"
                          Command="{Binding RedoCommand}">
                    <MenuItem.Icon><views:EditorIconView Icon="Redo" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Text.Editor.Settings}"
                          Click="OnSettingsClick">
                    <MenuItem.Icon><views:EditorIconView Icon="Settings" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource Text.Editor.View}">
                <MenuItem Header="{DynamicResource Text.Editor.Log}" Click="OnLogClick">
                    <MenuItem.Icon><views:EditorIconView Icon="Info" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Text.Editor.Mcp}" Click="OnMcpClick">
                    <MenuItem.Icon><views:EditorIconView Icon="Link" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Text.Profiler.Title}" Click="OnProfilerClick" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Text.Editor.Help}">
                <MenuItem Header="{DynamicResource Text.Editor.GettingStarted}" Click="OnHelpClick">
                    <MenuItem.Icon><views:EditorIconView Icon="Help" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Text.Editor.About}" Click="OnAboutClick">
                    <MenuItem.Icon><views:EditorIconView Icon="Info" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,2">
            <views:IconButton Icon="{Binding Playback.PlayIcon}" Command="{Binding Playback.PlayPauseCommand}"
                              ToolTip.Tip="{DynamicResource Text.Timeline.PlayPause}" AutomationProperties.Name="{DynamicResource Text.Timeline.PlayPause}" />
            <views:IconButton Icon="Stop" Command="{Binding Playback.StopCommand}"
                              ToolTip.Tip="{DynamicResource Text.Timeline.Stop}" AutomationProperties.Name="{DynamicResource Text.Timeline.Stop}" />
            <TextBlock Width="80" Text="{Binding Playback.FrameText}" VerticalAlignment="Center" />
        </StackPanel>
        </Grid>

        <dock:DockControl Grid.Row="1"
                          Layout="{Binding Layout}" />

        <StackPanel Grid.Row="2" Margin="8,4" Spacing="2">
            <TextBlock Text="{Binding FileStatus}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EffectMutedForegroundBrush}" />
        </StackPanel>
    </Grid>

</Window>
