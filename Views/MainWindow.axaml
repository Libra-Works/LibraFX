<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:vm="using:LiberaFx.ViewModels"
        xmlns:views="using:LiberaFx.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="LiberaFx.Views.MainWindow"
        KeyDown="OnMainKeyDown"
        x:DataType="vm:MainViewModel"
        Title="LIBERA FX"
        Icon="avares://LiberaFx/Assets/Brand/LibraFx.ico"
        Background="{DynamicResource EffectWindowBackgroundBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Classes="editor-bar" BorderThickness="0,0,0,1">
        <Grid>
        <Menu>
            <MenuItem Header="{DynamicResource Text.Editor.File}">
                <MenuItem Header="{DynamicResource Text.Editor.New}"
                          Command="{Binding NewDocumentCommand}">
                    <MenuItem.Icon><views:EditorIconView Icon="Add" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Text.Editor.Open}"
                          Command="{Binding OpenProjectCommand}">
                    <MenuItem.Icon><views:EditorIconView Icon="Open" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Text.Editor.Save}"
                          Command="{Binding SaveProjectCommand}">
                    <MenuItem.Icon><views:EditorIconView Icon="Save" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Text.Editor.SaveAs}"
                          Command="{Binding SaveProjectAsCommand}">
                    <MenuItem.Icon><views:EditorIconView Icon="SaveAs" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Text.Editor.Export}"
                          Command="{Binding ExportVfxCommand}">
                    <MenuItem.Icon><views:EditorIconView Icon="Export" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Text.Editor.CloseDocument}"
                          Click="OnCloseDocumentClick">
                    <MenuItem.Icon><views:EditorIconView Icon="Close" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource Text.Editor.Edit}">
                <MenuItem Header="{DynamicResource Text.Search.Title}" Click="OnAnythingSearchClick" />
                <MenuItem Header="{DynamicResource Text.Vcs.Title}" Tag="RevisionHistory" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Editor.Undo}"
                          Command="{Binding UndoCommand}">
                    <MenuItem.Icon><views:EditorIconView Icon="Undo" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Text.Editor.Redo}"
                          Command="{Binding RedoCommand}">
                    <MenuItem.Icon><views:EditorIconView Icon="Redo" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Text.Editor.Settings}"
                          Click="OnSettingsClick">
                    <MenuItem.Icon><views:EditorIconView Icon="Settings" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource Text.Editor.View}">
                <MenuItem Header="{DynamicResource Text.Chat.Title}" Tag="Chat" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.LiveGame.Title}" Tag="LiveGame" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Crash.Title}" Click="OnCrashReportsClick" />
                <MenuItem Header="{DynamicResource Text.Editor.Log}" Tag="Log" Click="OnDockPanelClick">
                    <MenuItem.Icon><views:EditorIconView Icon="Info" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Text.Editor.Mcp}" Tag="Mcp" Click="OnDockPanelClick">
                    <MenuItem.Icon><views:EditorIconView Icon="Link" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Text.Profiler.Title}" Tag="PreviewProfiler" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Connections.Title}" Tag="PreviewConnections" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Asset.Title}" Tag="Content" Click="OnContentClick" />
                <MenuItem Header="{DynamicResource Text.Sprite.Title}" Tag="SpriteEditor" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Library.Title}" Tag="LocalProjects" Click="OnDockPanelClick" />
            </MenuItem>
            <MenuItem x:Name="WindowMenu" Header="{DynamicResource Text.Layouts.Window}">
                <MenuItem Header="{DynamicResource Text.Messages.Tool.Outliner}" Tag="Outliner" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Messages.Tool.NodeList}" Tag="NodeList" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Messages.Tool.Resources}" Tag="Resources" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Messages.Tool.Properties}" Tag="Properties" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Messages.Tool.Properties2}" Tag="Properties2" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Messages.Tool.Properties3}" Tag="Properties3" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Messages.Tool.Properties4}" Tag="Properties4" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Messages.Tool.EngineConnection}" Tag="EngineConnection" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Messages.Tool.History}" Tag="History" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Messages.Tool.Timeline}" Tag="Timeline" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Messages.Tool.Curves}" Tag="Curves" Click="OnDockPanelClick" />
                <Separator />
                <MenuItem Header="{DynamicResource Text.Editor.Log}" Tag="Log" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Editor.Mcp}" Tag="Mcp" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Profiler.Title}" Tag="PreviewProfiler" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Connections.Title}" Tag="PreviewConnections" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Asset.Title}" Tag="Content" Click="OnContentClick" />
                <MenuItem Header="{DynamicResource Text.Sprite.Title}" Tag="SpriteEditor" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Library.Title}" Tag="LocalProjects" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Messages.GraphProblemsTitle}" Tag="Problems" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Vcs.Title}" Tag="RevisionHistory" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Chat.Title}" Tag="Chat" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.LiveGame.Title}" Tag="LiveGame" Click="OnDockPanelClick" />
                <MenuItem Header="{DynamicResource Text.Layouts.Title}" Tag="LayoutPresets" Click="OnDockPanelClick" />
                <Separator />
                <MenuItem Header="{DynamicResource Text.Layouts.Menu}">
                    <MenuItem Header="{DynamicResource Text.Layouts.RestoreDefault}" Click="OnRestoreDefaultLayoutClick" />
                    <MenuItem Header="{DynamicResource Text.Layouts.Save}" Tag="LayoutPresets" Click="OnDockPanelClick" />
                    <MenuItem Header="{DynamicResource Text.Layouts.Manage}" Tag="LayoutPresets" Click="OnDockPanelClick" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource Text.Editor.Help}">
                <MenuItem Header="{DynamicResource Text.Editor.GettingStarted}" Click="OnHelpClick">
                    <MenuItem.Icon><views:EditorIconView Icon="Help" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Text.Editor.About}" Click="OnAboutClick">
                    <MenuItem.Icon><views:EditorIconView Icon="Info" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>
        </Grid>
        </Border>

        <dock:DockControl Grid.Row="1"
                          Layout="{Binding Layout}" />
        <views:GpuWorkspaceView x:Name="GpuWorkspace" Grid.Row="1" IsVisible="False" />

        <Border Grid.Row="2" Classes="editor-bar" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <views:PlaybackTransport ShowFrameTools="True" DataContext="{Binding Playback}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="editor-label" Text="{Binding FileStatus}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="editor-label" Text="{Binding WindowLayouts.Status}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Classes="editor-tool" Content="{Binding PreviewConnectionSummary}"
                        Tag="PreviewConnections" Click="OnDockPanelClick" Padding="8,4" />
            </Grid>
        </Border>
    </Grid>

</Window>
