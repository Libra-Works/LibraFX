#include "/Engine/Public/Platform.ush"

struct LibraParticle
{
    float4 positionAge;
    float4 velocityLifetime;
    float4 color;
    float4 sizeRotation;
    uint4 seedAlive;
};

StructuredBuffer<LibraParticle> ParticleData;
StructuredBuffer<float4> SpriteData;
uint SpriteEnabled;
float4 LibraSpriteRead(uint index) { return SpriteData[index]; }
#include "/LibraGpu/Private/LibraParticleSprite.ush"
float4x4 ViewProjection;
float3 PreViewTranslation;
float3 CameraRight;
float3 CameraUp;
float SizeScale;
float4 DrawRow0;
float4 DrawRow1;
float4 DrawRow2;
Texture2D BillboardTexture;
uint TextureFlags;
SamplerState BillboardSampler;

struct VertexOutput
{
    float4 position : SV_Position;
    float2 uv : TEXCOORD0;
    float4 color : COLOR0;
};

VertexOutput MainVS(uint vertexId : SV_VertexID, uint instanceId : SV_InstanceID)
{
    static const float2 corners[6] = {
        float2(-1, -1), float2(1, -1), float2(-1, 1),
        float2(-1, 1), float2(1, -1), float2(1, 1)
    };
    LibraParticle particle = ParticleData[instanceId];
    float2 corner = corners[vertexId%6];
    float4 spriteUv=float4(0,0,1,1);float2 spriteOffset=0,spriteScale=1;float spriteAngle=0;
    if (SpriteEnabled!=0) LibraSpriteSample(vertexId/6,particle.positionAge.w,spriteUv,spriteOffset,spriteScale,spriteAngle);
    float2 shape=SpriteEnabled!=0 ? corner*spriteScale*particle.sizeRotation.xy : corner;
    float cs=cos(spriteAngle),ss=sin(spriteAngle);
    shape=float2(cs*shape.x-ss*shape.y,ss*shape.x+cs*shape.y)+2.0*spriteOffset*particle.sizeRotation.xy;
    float angle = particle.sizeRotation.z;
    float s = sin(angle), c = cos(angle);
    float2 rotated = float2(c * shape.x - s * shape.y, s * shape.x + c * shape.y);
    if (SpriteEnabled==0) rotated*=particle.sizeRotation.xy;
    float sx = length(float3(DrawRow0.x, DrawRow1.x, DrawRow2.x));
    float sy = length(float3(DrawRow0.y, DrawRow1.y, DrawRow2.y));
    float3 offset = CameraRight * rotated.x * SizeScale * sx +
        CameraUp * rotated.y * SizeScale * sy;
    float4 position = float4(particle.positionAge.xyz, 1);
    float3 world = float3(dot(DrawRow0, position), dot(DrawRow1, position), dot(DrawRow2, position));
    world += offset;
    world += PreViewTranslation;
    VertexOutput output;
    output.position = particle.seedAlive.y != 0 ? mul(float4(world, 1), ViewProjection) : float4(0, 0, 0, 0);
    output.uv = spriteUv.xy+float2(corner.x * 0.5 + 0.5, 0.5 - corner.y * 0.5)*spriteUv.zw;
    output.color = particle.color;
    return output;
}

float4 MainPS(VertexOutput input) : SV_Target0
{
    float2 uv = input.uv;
    if ((TextureFlags & 2u) != 0u) uv.y = 1.0 - uv.y;
    float4 texel = BillboardTexture.Sample(BillboardSampler, uv);
    if ((TextureFlags & 1u) != 0u) texel.rgb /= max(texel.a, 0.000001);
    return texel * input.color;
}
