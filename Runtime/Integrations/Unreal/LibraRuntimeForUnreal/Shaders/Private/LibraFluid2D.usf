float3 LibraShallowLoad(int2 cell)
{
    float3 q = LibraFluidLoad0(cell).xyz;
    q.x = max(q.x, 0.0);
    if (cell.x < 0 || cell.x >= int(LibraFluidGrid.x)) q.y = -q.y;
