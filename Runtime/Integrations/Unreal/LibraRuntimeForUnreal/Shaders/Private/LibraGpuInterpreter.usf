#include "/Engine/Public/Platform.ush"
#include "/LibraGpu/Private/LibraGpuSupport.ush"

struct LibraParticle
{
    float4 positionAge;
    float4 velocityLifetime;
    float4 color;
    float4 sizeRotation;
    uint4 seedAlive;
};

RWStructuredBuffer<LibraParticle> Particles;
RWStructuredBuffer<uint4> Registers;
RWStructuredBuffer<uint4> Instructions;
#define LIBRA_GPU_FLOWMAP_TEXTURE(Index) Texture2D FlowMapTexture##Index;
LIBRA_GPU_FLOWMAP_TEXTURE(0)
LIBRA_GPU_FLOWMAP_TEXTURE(1)
