SamplerState FlowMapSampler;
uint Capacity;
uint Count;
uint SpawnStart;
uint SpawnCount;
float DeltaTime;
float Time;
uint EmitterSeed;
uint FrameIndex;
float3 EmitterPosition;
uint RegisterCount;
uint InstructionCount;
uint Stage;
uint DefaultAge;

uint Hash(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    return x ^ (x >> 16);
}

bool Finite(float4 v)
{
    return all((asuint(v) & 0x7f800000u) != 0x7f800000u);
}

bool FiniteParticle(LibraParticle p)
{
    return Finite(p.positionAge) && Finite(p.velocityLifetime) &&
        Finite(p.color) && Finite(p.sizeRotation);
}

uint4 Attribute(LibraParticle p, uint slot)
{
    if (slot == 0) return asuint(float4(p.positionAge.xyz, 0));
    if (slot == 1) return asuint(float4(p.velocityLifetime.xyz, 0));
    if (slot == 2) return asuint(p.color);
    if (slot == 3) return asuint(float4(p.sizeRotation.xy, 0, 0));
    if (slot == 4) return asuint(float4(p.sizeRotation.z, 0, 0, 0));
    if (slot == 5) return asuint(float4(p.positionAge.w, 0, 0, 0));
    if (slot == 6) return asuint(float4(p.velocityLifetime.w, 0, 0, 0));
    if (slot == 7) return uint4(p.seedAlive.y != 0, 0, 0, 0);
    return uint4(p.seedAlive.x, 0, 0, 0);
}

void StoreAttribute(inout LibraParticle p, uint slot, uint4 bits)
{
    float4 v = asfloat(bits);
    if (slot == 0) p.positionAge.xyz = v.xyz;
    else if (slot == 1) p.velocityLifetime.xyz = v.xyz;
    else if (slot == 2) p.color = v;
    else if (slot == 3) p.sizeRotation.xy = v.xy;
    else if (slot == 4) p.sizeRotation.z = v.x;
    else if (slot == 5) p.positionAge.w = v.x;
    else if (slot == 6) p.velocityLifetime.w = v.x;
    else if (slot == 7) p.seedAlive.y = bits.x != 0;
    else p.seedAlive.x = bits.x;
}

uint4 LoadRegister(uint particle, uint index)
{
    if (index == 0xffffffffu) return 0;
    return Registers[particle * RegisterCount + index];
}

float4 FloatInput(uint4 bits, uint index, uint resultType)
{
    float4 v = asfloat(bits);
    uint inputType = Instructions[4 + index * 4 + 1].y;
    return inputType == 0 && resultType >= 4 ? v.xxxx : v;
}

float SafeDiv(float a, float b) { return b == 0.0f ? 0.0f : a / b; }
int SafeIntDiv(int a, int b)
{
    if (b == 0) return 0;
    if (a == (-2147483647 - 1) && b == -1) return (-2147483647 - 1);
    return a / b;
}

float ExtendedScalar(uint op, float a, float b, float c, float2 sourceRange, float2 targetRange)
{
    if (op == 19) return LibraGpuAbs(a);
    if (op == 20) return LibraGpuFloor(a);
    if (op == 21) return LibraGpuCeil(a);
    if (op == 22) return LibraGpuRound(a);
    if (op == 23) return LibraGpuFrac(a);
    if (op == 24) return LibraGpuMod(a, b);
    if (op == 25) return LibraGpuSign(a);
    if (op == 26) return LibraGpuPow(a, b);
    if (op == 27) return LibraGpuSqrt(a);
    if (op == 28) return LibraGpuExp(a);
    if (op == 29) return LibraGpuLog(a);
    if (op == 30) return LibraGpuLerp(a, b, c);
    if (op == 31) return LibraGpuSmoothstep(a, b, c);
    if (op == 32) return LibraGpuRemap(a, sourceRange, targetRange);
    return LibraGpuSaturate(a);
}

float4 SampleFlowMap(uint textureIndex, float2 uv)
{
    switch (textureIndex)
    {
        case 0: return FlowMapTexture0.SampleLevel(FlowMapSampler, uv, 0);
        case 1: return FlowMapTexture1.SampleLevel(FlowMapSampler, uv, 0);
        case 2: return FlowMapTexture2.SampleLevel(FlowMapSampler, uv, 0);
        case 3: return FlowMapTexture3.SampleLevel(FlowMapSampler, uv, 0);
        case 4: return FlowMapTexture4.SampleLevel(FlowMapSampler, uv, 0);
        case 5: return FlowMapTexture5.SampleLevel(FlowMapSampler, uv, 0);
        case 6: return FlowMapTexture6.SampleLevel(FlowMapSampler, uv, 0);
        case 7: return FlowMapTexture7.SampleLevel(FlowMapSampler, uv, 0);
        case 8: return FlowMapTexture8.SampleLevel(FlowMapSampler, uv, 0);
        case 9: return FlowMapTexture9.SampleLevel(FlowMapSampler, uv, 0);
        case 10: return FlowMapTexture10.SampleLevel(FlowMapSampler, uv, 0);
        case 11: return FlowMapTexture11.SampleLevel(FlowMapSampler, uv, 0);
        case 12: return FlowMapTexture12.SampleLevel(FlowMapSampler, uv, 0);
        case 13: return FlowMapTexture13.SampleLevel(FlowMapSampler, uv, 0);
        case 14: return FlowMapTexture14.SampleLevel(FlowMapSampler, uv, 0);
        case 15: return FlowMapTexture15.SampleLevel(FlowMapSampler, uv, 0);
        case 16: return FlowMapTexture16.SampleLevel(FlowMapSampler, uv, 0);
        case 17: return FlowMapTexture17.SampleLevel(FlowMapSampler, uv, 0);
        case 18: return FlowMapTexture18.SampleLevel(FlowMapSampler, uv, 0);
        case 19: return FlowMapTexture19.SampleLevel(FlowMapSampler, uv, 0);
        case 20: return FlowMapTexture20.SampleLevel(FlowMapSampler, uv, 0);
        case 21: return FlowMapTexture21.SampleLevel(FlowMapSampler, uv, 0);
        case 22: return FlowMapTexture22.SampleLevel(FlowMapSampler, uv, 0);
        case 23: return FlowMapTexture23.SampleLevel(FlowMapSampler, uv, 0);
        case 24: return FlowMapTexture24.SampleLevel(FlowMapSampler, uv, 0);
        case 25: return FlowMapTexture25.SampleLevel(FlowMapSampler, uv, 0);
        case 26: return FlowMapTexture26.SampleLevel(FlowMapSampler, uv, 0);
        case 27: return FlowMapTexture27.SampleLevel(FlowMapSampler, uv, 0);
        case 28: return FlowMapTexture28.SampleLevel(FlowMapSampler, uv, 0);
        case 29: return FlowMapTexture29.SampleLevel(FlowMapSampler, uv, 0);
        case 30: return FlowMapTexture30.SampleLevel(FlowMapSampler, uv, 0);
        case 31: return FlowMapTexture31.SampleLevel(FlowMapSampler, uv, 0);
        case 32: return FlowMapTexture32.SampleLevel(FlowMapSampler, uv, 0);
        case 33: return FlowMapTexture33.SampleLevel(FlowMapSampler, uv, 0);
        case 34: return FlowMapTexture34.SampleLevel(FlowMapSampler, uv, 0);
        case 35: return FlowMapTexture35.SampleLevel(FlowMapSampler, uv, 0);
        case 36: return FlowMapTexture36.SampleLevel(FlowMapSampler, uv, 0);
        case 37: return FlowMapTexture37.SampleLevel(FlowMapSampler, uv, 0);
        case 38: return FlowMapTexture38.SampleLevel(FlowMapSampler, uv, 0);
        case 39: return FlowMapTexture39.SampleLevel(FlowMapSampler, uv, 0);
        case 40: return FlowMapTexture40.SampleLevel(FlowMapSampler, uv, 0);
        case 41: return FlowMapTexture41.SampleLevel(FlowMapSampler, uv, 0);
        case 42: return FlowMapTexture42.SampleLevel(FlowMapSampler, uv, 0);
        case 43: return FlowMapTexture43.SampleLevel(FlowMapSampler, uv, 0);
        case 44: return FlowMapTexture44.SampleLevel(FlowMapSampler, uv, 0);
        case 45: return FlowMapTexture45.SampleLevel(FlowMapSampler, uv, 0);
        case 46: return FlowMapTexture46.SampleLevel(FlowMapSampler, uv, 0);
        case 47: return FlowMapTexture47.SampleLevel(FlowMapSampler, uv, 0);
        case 48: return FlowMapTexture48.SampleLevel(FlowMapSampler, uv, 0);
        case 49: return FlowMapTexture49.SampleLevel(FlowMapSampler, uv, 0);
        case 50: return FlowMapTexture50.SampleLevel(FlowMapSampler, uv, 0);
        case 51: return FlowMapTexture51.SampleLevel(FlowMapSampler, uv, 0);
        case 52: return FlowMapTexture52.SampleLevel(FlowMapSampler, uv, 0);
        case 53: return FlowMapTexture53.SampleLevel(FlowMapSampler, uv, 0);
        case 54: return FlowMapTexture54.SampleLevel(FlowMapSampler, uv, 0);
        case 55: return FlowMapTexture55.SampleLevel(FlowMapSampler, uv, 0);
        case 56: return FlowMapTexture56.SampleLevel(FlowMapSampler, uv, 0);
        case 57: return FlowMapTexture57.SampleLevel(FlowMapSampler, uv, 0);
        case 58: return FlowMapTexture58.SampleLevel(FlowMapSampler, uv, 0);
        case 59: return FlowMapTexture59.SampleLevel(FlowMapSampler, uv, 0);
        case 60: return FlowMapTexture60.SampleLevel(FlowMapSampler, uv, 0);
        case 61: return FlowMapTexture61.SampleLevel(FlowMapSampler, uv, 0);
        case 62: return FlowMapTexture62.SampleLevel(FlowMapSampler, uv, 0);
        case 63: return FlowMapTexture63.SampleLevel(FlowMapSampler, uv, 0);
        default: return 0;
    }
}

[numthreads(64, 1, 1)]
void MainCS(uint3 threadId : SV_DispatchThreadID)
{
    uint i = threadId.x;
    if (i >= Capacity) return;
    LibraParticle p = Particles[i];
    if (Stage == 0)
    {
        if (i < SpawnStart || i - SpawnStart >= SpawnCount || p.seedAlive.y != 0) return;
        p.positionAge = float4(EmitterPosition, 0);
        p.velocityLifetime = float4(0, 0, 0, 1);
        p.color = 1;
        p.sizeRotation = float4(1, 1, 0, 0);
        p.seedAlive = uint4(Hash(i ^ EmitterSeed ^ Hash(FrameIndex)), 1, 0, 0);
    }
    else
    {
        if (i >= Count || p.seedAlive.y == 0) return;
        if (!FiniteParticle(p) || !(p.velocityLifetime.w > 0))
        {
            p.seedAlive.y = 0;
            Particles[i] = p;
            return;
        }
        if (DefaultAge != 0)
            p.positionAge.w += (asuint(DeltaTime) & 0x7f800000u) != 0x7f800000u ? max(DeltaTime, 0) : 0;
    }
    for (uint n = 0; n < InstructionCount; ++n)
    {
        uint4 first = Instructions[4 + n * 4];
        uint4 second = Instructions[5 + n * 4];
        uint4 immediate = Instructions[6 + n * 4];
        uint4 integer = Instructions[7 + n * 4];
        uint op = first.x, dst = first.y, type = second.y, aux = second.z, dIndex = second.w;
        uint4 a = LoadRegister(i, first.z);
        uint4 b = LoadRegister(i, first.w);
        uint4 c = LoadRegister(i, second.x);
        uint4 d = op == 41 && type == 5 ? 0 : LoadRegister(i, dIndex);
        uint4 result = 0;
        if (op == 0) result = (type == 1 || type == 2 || type == 3) ? integer : immediate;
        else if (op == 1) result = Attribute(p, aux);
        else if (op == 2)
        {
            if (aux == 0) result = asuint(float4(DeltaTime, 0, 0, 0));
            else if (aux == 1) result = asuint(float4(Time, 0, 0, 0));
            else result = asuint(float4(EmitterPosition, 0));
        }
        else if ((op >= 3 && op <= 6) || (op >= 9 && op <= 11))
        {
            if (type == 1 || type == 2)
            {
                uint x = a.x, y = b.x, z = c.x, r = 0;
                if (op == 3) r = x + y;
                else if (op == 4) r = x - y;
                else if (op == 5) r = x * y;
                else if (op == 6) r = type == 1 ? asuint(SafeIntDiv(asint(x), asint(y))) : (y == 0 ? 0 : x / y);
                else if (type == 1)
                {
                    if (op == 9) r = asuint(min(max(asint(x), asint(y)), asint(z)));
                    else if (op == 10) r = asuint(min(asint(x), asint(y)));
                    else r = asuint(max(asint(x), asint(y)));
                }
                else if (op == 9) r = min(max(x, y), z);
                else if (op == 10) r = min(x, y);
                else r = max(x, y);
                result.x = r;
            }
            else
            {
                float4 x = FloatInput(a, first.z, type), y = FloatInput(b, first.w, type), z = 0;
                if (op == 9) z = FloatInput(c, second.x, type);
                float4 r = 0;
                if (op == 3) r = x + y;
                else if (op == 4) r = x - y;
                else if (op == 5) r = x * y;
                else if (op == 6) r = float4(SafeDiv(x.x,y.x), SafeDiv(x.y,y.y), SafeDiv(x.z,y.z), SafeDiv(x.w,y.w));
                else if (op == 9) r = min(max(x, y), z);
                else if (op == 10) r = min(x, y);
                else r = max(x, y);
                result = asuint(r);
            }
        }
        else if (op == 7) result = asuint(sin(asfloat(a)));
        else if (op == 8) result = asuint(cos(asfloat(a)));
        else if (op == 12 || op == 13)
        {
            float4 v = asfloat(a);
            uint sourceType = Instructions[4 + first.z * 4 + 1].y;
            uint components = sourceType - 2;
            if (components < 4) v.w = 0;
            if (components < 3) v.z = 0;
            if (op == 13) result = asuint(float4(length(v), 0, 0, 0));
            else if (Finite(v))
            {
                float m = max(max(abs(v.x), abs(v.y)), max(abs(v.z), abs(v.w)));
                if (m > 0) { float4 scaled = v / m; result = asuint(scaled * rsqrt(dot(scaled, scaled))); }
            }
        }
        else if (op == 14) result = uint4(a.x, b.x, c.x, d.x);
        else if (op == 15) result = a.x != 0 ? b : c;
        else if (op == 16) result.x = asuint(float(Hash(a.x) >> 8) * (1.0f / 16777216.0f));
        else if (op == 17) result.x = a[aux];
        else if (op == 18) StoreAttribute(p, aux, a);
        else if ((op >= 19 && op <= 32) || op == 36)
        {
            if (type == 1)
            {
                int value = asint(a.x);
                if (op == 19) result.x = asuint(LibraGpuAbs(value));
                else if (op == 25) result.x = asuint(LibraGpuSign(value));
                else result.x = asuint(LibraGpuMod(value, asint(b.x)));
            }
            else if (type == 2)
            {
                if (op == 19) result.x = LibraGpuAbs(a.x);
                else if (op == 25) result.x = LibraGpuSign(a.x);
                else result.x = LibraGpuMod(a.x, b.x);
            }
            else
            {
                float4 x = asfloat(a), y = asfloat(b), z = asfloat(c);
                if (op == 24 || op == 26 || op == 30 || op == 31)
                {
                    x = FloatInput(a, first.z, type);
                    y = FloatInput(b, first.w, type);
                    if (op == 30 || op == 31) z = FloatInput(c, second.x, type);
                }
                result = asuint(float4(
                    ExtendedScalar(op, x.x, y.x, z.x, asfloat(b.xy), asfloat(c.xy)),
                    ExtendedScalar(op, x.y, y.y, z.y, asfloat(b.xy), asfloat(c.xy)),
                    ExtendedScalar(op, x.z, y.z, z.z, asfloat(b.xy), asfloat(c.xy)),
                    ExtendedScalar(op, x.w, y.w, z.w, asfloat(b.xy), asfloat(c.xy))));
            }
        }
        else if (op == 33 || op == 35)
        {
            float4 x = asfloat(a), y = asfloat(b);
            uint sourceType = Instructions[5 + first.z * 4].y;
            float value = 0;
            if (op == 33)
            {
                if (sourceType == 4) value = LibraGpuDot(x.xy, y.xy);
                else if (sourceType == 5) value = LibraGpuDot(x.xyz, y.xyz);
                else value = LibraGpuDot(x, y);
            }
            else
            {
                if (sourceType == 0) value = LibraGpuDistance(x.x, y.x);
                else if (sourceType == 4) value = LibraGpuDistance(x.xy, y.xy);
                else if (sourceType == 5) value = LibraGpuDistance(x.xyz, y.xyz);
                else value = LibraGpuDistance(x, y);
            }
            result.x = asuint(value);
        }
        else if (op == 34) result = asuint(float4(LibraGpuCross(asfloat(a.xyz), asfloat(b.xyz)), 0));
        else if (op == 37) result.x = asuint(LibraGpuGradientNoise3D(asfloat(a.xyz), b.x));
        else if (op == 38) result.x = asuint(LibraGpuFbm(asfloat(a.xyz), b.x, asint(c.x), asfloat(d.x)));
        else if (op == 39) result.x = asuint(LibraGpuTurbulence(asfloat(a.xyz), b.x, asint(c.x), asfloat(d.x)));
        else if (op == 40) result = asuint(float4(LibraGpuCurlNoise(asfloat(a.xyz), b.x, asint(c.x), asfloat(d.x)), 0));
        else if (op == 41)
        {
            if (type == 4)
            {
                float2 flow = SampleFlowMap(aux, saturate(asfloat(a.xy))).rg * 2.0f - 1.0f;
                result = asuint(float4(flow, 0, 0));
            }
            else
            {
                uint axisU = dIndex & 3u;
                uint axisV = (dIndex >> 2) & 3u;
                float4 bounds = asfloat(immediate);
                float2 uv = saturate((float2(asfloat(a)[axisU], asfloat(a)[axisV]) - bounds.xy) / bounds.zw);
                float2 flow = SampleFlowMap(aux, uv).rg * 2.0f - 1.0f;
                float3 vector = 0;
                vector[axisU] = flow.x;
                vector[axisV] = flow.y;
                result = asuint(float4(vector, 0));
            }
        }
        if (op != 18)
        {
            Registers[i * RegisterCount + dst] = result;
            DeviceMemoryBarrier();
        }
    }
    p.positionAge.w = max(p.positionAge.w, 0);
    if (!FiniteParticle(p) || !(p.velocityLifetime.w > 0) || p.positionAge.w >= p.velocityLifetime.w)
        p.seedAlive.y = 0;
    p.seedAlive.y = p.seedAlive.y != 0;
    Particles[i] = p;
}
