<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsPanels="using:LiberaFx.Views.Panels"
             xmlns:viewsSprite="using:LiberaFx.Views.Sprite"
             xmlns:viewsTimeline="using:LiberaFx.Views.Timeline"
             xmlns:vmGraph="using:LiberaFx.ViewModels.Graph"
             xmlns:vmMain="using:LiberaFx.ViewModels.Main"
             xmlns:vmPanels="using:LiberaFx.ViewModels.Panels"
             x:Class="LiberaFx.App"
             xmlns:local="using:LiberaFx"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="EffectWindowBackgroundBrush"
                             Color="{DynamicResource SystemRegionColor}" />
            <SolidColorBrush x:Key="EffectSurfaceBrush"
                             Color="{DynamicResource SystemAltHighColor}" />
            <SolidColorBrush x:Key="EffectForegroundBrush"
                             Color="{DynamicResource SystemBaseHighColor}" />
            <SolidColorBrush x:Key="EffectMutedForegroundBrush"
                             Color="{DynamicResource SystemBaseMediumColor}" />
            <SolidColorBrush x:Key="EffectBorderBrush"
                             Color="{DynamicResource SystemBaseMediumLowColor}" />
            <SolidColorBrush x:Key="DockApplicationAccentBrushLow"
                             Color="{DynamicResource SystemAccentColor}" Opacity="0.16" />
            <SolidColorBrush x:Key="DockApplicationAccentBrushMed"
                             Color="{DynamicResource SystemAccentColor}" Opacity="0.26" />
            <SolidColorBrush x:Key="DockApplicationAccentBrushHigh"
                             Color="{DynamicResource SystemAccentColor}" Opacity="0.38" />
            <SolidColorBrush x:Key="DockApplicationAccentBrushIndicator"
                             Color="{DynamicResource SystemAccentColor}" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
        <DataTemplate DataType="vmGraph:NodeCatalogViewModel">
            <viewsPanels:NodeCatalogView />
        </DataTemplate>
        <DataTemplate DataType="vmPanels:OutlinerViewModel">
            <viewsPanels:OutlinerView />
        </DataTemplate>
        <DataTemplate DataType="vmPanels:CurveEditorViewModel">
            <viewsTimeline:CurveEditorView />
        </DataTemplate>
        <DataTemplate DataType="vmPanels:TimelineViewModel">
            <viewsTimeline:TimelineView />
        </DataTemplate>
        <DataTemplate DataType="vmPanels:NodePropertiesPaneViewModel">
            <viewsPanels:NodePropertiesView />
        </DataTemplate>
        <DataTemplate DataType="vmPanels:SpriteEditorPaneViewModel">
            <viewsSprite:SpriteEditorView DataContext="{Binding Editor}" />
        </DataTemplate>
        <DataTemplate DataType="vmMain:EditorWorkPaneViewModel">
            <ContentControl Content="{Binding View}" />
        </DataTemplate>
        <DataTemplate DataType="vmPanels:HistoryPaneViewModel">
            <viewsPanels:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="vmPanels:PreviewPaneViewModel">
            <viewsPanels:PreviewPaneView />
        </DataTemplate>
        <DataTemplate DataType="vmMain:ToolPaneViewModel">
            <ScrollViewer>
                <TextBlock Margin="12"
                           Text="{Binding Description}"
                           Foreground="{DynamicResource EffectForegroundBrush}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <DockFluentTheme />
        <StyleInclude Source="avares://LiberaFx/Views/EditorChrome.axaml" />
    </Application.Styles>
</Application>