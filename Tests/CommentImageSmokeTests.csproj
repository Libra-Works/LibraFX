<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Runtime\Integrations\Unity\Runtime\LiberaFxParticleAtlas.cs" Link="Contracts\LiberaFxParticleAtlas.cs" />
    <Compile Include="..\Runtime\Integrations\Unity\Runtime\LiveGameDebugLease.cs"
             Link="Contracts\LiveGameDebugLease.cs" />
    <None Update="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\LiberaFx.csproj" />
    <ProjectReference Include="..\Samples\Extensions.RedmineCrash\Extensions.RedmineCrash.csproj" />
    <None Include="..\Runtime\examples\**\*.json"
          Link="Runtime\examples\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
